{
  "name": "metahumotonic-web",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build/build-site.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "prebuild:kg": "node scripts/prebuild/dump-kg.mjs",
    "test:compute-consent": "node --test tests/compute-consent.test.mjs",
    "test:site-surface": "node --test tests/surface-split.test.mjs",
    "test:wiki-community": "node --test tests/wiki-community.test.mjs",
    "test:ontology-explorer": "node --test tests/ontology-explorer.test.mjs",
    "test:wiki-engine": "node --experimental-strip-types --test tests/wiki-engine.test.ts",
    "typecheck:wiki-engine": "tsc -p tsconfig.wiki-engine.json --noEmit",
    "verify:wiki-contracts": "node scripts/wiki-engine/verify-contracts.mjs docs/wiki-engine/engine-spec.json docs/wiki-engine/fsm-spec.json docs/wiki-engine/fsm-traces.json",
    "verify:wiki-diagram": "node scripts/wiki-engine/verify-generated-diagram.mjs docs/wiki-engine/fsm-spec.json docs/wiki-engine/fsm-diagram.mmd",
    "verify:wiki-engine": "npm run typecheck:wiki-engine && npm run test:wiki-engine && npm run verify:wiki-contracts && npm run verify:wiki-diagram",
    "test:release": "npm run test:build-runtime && npm run test:compute-consent && npm run test:site-surface && npm run test:wiki-community && npm run test:ontology-explorer && npm run verify:wiki-engine && npm run typecheck:workbench && npm run test:workbench && npm run verify:learning-publication",
    "verify:learning-publication": "python3 scripts/verify/learning_publication.py && python3 -m unittest discover -s tests -p 'test_learning_*.py' -v",
    "verify:build-trace": "node scripts/ooptdd/emit-build-trace.mjs && uv run --python 3.12 --with pyyaml python scripts/ooptdd/verify-build-trace.py",
    "test:build-runtime": "node --test tests/build-runtime.test.mjs",
    "verify": "npm run build && npm run test:release && npm run verify:drift",
    "verify:drift": "node scripts/longinus/drift-check.mjs",
    "preinstall": "node scripts/check-runtime.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "test:workbench": "node --experimental-strip-types --test tests/workbench.test.ts tests/learning-hub.test.mjs tests/service-directory.test.ts tests/meaning-simulation.test.ts",
    "typecheck:workbench": "tsc -p tsconfig.workbench.json --noEmit",
    "test:workbench:browser": "node scripts/qa/workbench-browser.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/starlight": "0.41.7",
    "@tailwindcss/postcss": "^4.2.2",
    "astro": "7.2.0",
    "neo4j-driver": "^6.0.1",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "playwright": "1.63.0",
    "typescript": "^5.9.3"
  }
}
