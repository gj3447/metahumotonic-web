{
  "name": "metahumotonic-web",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build/assemble-site.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "prebuild:kg": "node scripts/prebuild/dump-kg.mjs",
    "test:compute-consent": "node --test tests/compute-consent.test.mjs",
    "test:site-surface": "node --test tests/surface-split.test.mjs",
    "test:release": "npm run test:compute-consent && npm run test:site-surface",
    "verify:build-trace": "node scripts/ooptdd/emit-build-trace.mjs && uv run --python 3.12 --with pyyaml python scripts/ooptdd/verify-build-trace.py"
  },
  "dependencies": {
    "@astrojs/starlight": "0.41.7",
    "@tailwindcss/postcss": "^4.2.2",
    "astro": "7.2.0",
    "neo4j-driver": "^6.0.1",
    "tailwindcss": "^4.2.2"
  }
}
