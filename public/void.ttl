@prefix void:  <http://rdfs.org/ns/void#> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix mh:    <https://metahumotonic.com/ontology#> .

# KG: ATOM_Landing_LinkedDataFiles, TASK_Landing_LinkedDataFiles
# SA: MetaHumotonic_Landing_v2 | L1: SemanticWeb

<https://metahumotonic.com/#kg>
    a                  void:Dataset ;
    dcterms:title      "MetaHumotonic Knowledge Graph"@en ;
    dcterms:title      "메타휴모토닉 지식 그래프"@ko ;
    dcterms:description "12 axioms, 12 apostles, 548K+ entities across 13 domains. Philosophy and technology unified in a single Neo4j graph."@en ;
    dcterms:creator    <https://metahumotonic.com/#person> ;
    dcterms:created    "2021-01-01"^^xsd:date ;
    dcterms:modified   "2026-04-10"^^xsd:date ;
    dcterms:license    <https://creativecommons.org/licenses/by-sa/4.0/> ;
    void:sparqlEndpoint <https://metahumotonic.com/sparql> ;
    void:dataDump      <https://metahumotonic.com/ontology.ttl> ;
    void:triples       1065068 ;
    void:entities      548109 ;
    void:properties    3020 ;
    void:distinctSubjects 548109 ;
    void:uriSpace      "https://metahumotonic.com/entity/" ;
    void:vocabulary     <https://metahumotonic.com/ontology#> ;
    void:vocabulary     <http://xmlns.com/foaf/0.1/> ;
    void:vocabulary     <https://schema.org/> ;
    foaf:homepage      <https://metahumotonic.com> .

# Domain subsets
