mh:edge_foundational_shell_12 a mh:Hyperedge ;
    rdfs:label "edge-foundational-shell-12" ;
    rdfs:comment "CHU 공리 전체 shell — all 12 apostles form a single instance (cardinality=12)." .

mh:edge_vertical_4_8_10 a mh:Hyperedge ;
    rdfs:label "edge-vertical-4-8-10" ;
    rdfs:comment "CHU vertical axis = Kubernetes Scheduler/Node/GC — apostles #4 #8 #10." .

mh:edge_mirror_5_12 a mh:Hyperedge ;
    rdfs:label "edge-mirror-5-12-A" ;
    rdfs:comment "Spacegirl (boundary-crossing) ↔ Monsoon (surface) θ=π." .

mh:edge_mirror_9_12 a mh:Hyperedge ;
    rdfs:label "edge-mirror-9-12-B" ;
    rdfs:comment "Jesus (Incarnation) ↔ Monsoon (Inverted-Incarnation)." .

mh:edge_mediation_5_6_9 a mh:Hyperedge ;
    rdfs:label "edge-mediation-5-6-9" ;
    rdfs:comment "Universalization-mediation triad — Spacegirl + River + Jesus." .

mh:edge_selfref_7_8_10 a mh:Hyperedge ;
    rdfs:label "edge-selfref-7-8-10-void" ;
    rdfs:comment "Self-reference-boundary-void axis — Tree-of-Liquest + OMC + Gipbazon (Lean PASS 9 theorems)." .

mh:edge_tension_9_11 a mh:Hyperedge ;
    rdfs:label "edge-tension-9-11" ;
    rdfs:comment "Heaven-axis dual manifestation — Jesus + HOH." .

mh:edge_peer_3_11 a mh:Hyperedge ;
    rdfs:label "apostle-3-11-peer-equality" ;
    rdfs:comment "Hero-of-the-Great-Void and HOH are horizontal peers (not vertical)." .

