{
  "schema_version": "fsm-spec/v1",
  "name": "metahumotonic-wiki-lifecycles",
  "execution": {
    "step_interface": "step(configuration, typed_event) -> next_configuration, effect_intents",
    "event_queue": "External events are FIFO per page stream; emitted intents never re-enter the reducer synchronously.",
    "run_to_completion": "One typed event is selected and reduced completely before the next stream event.",
    "action_order": "Validate payload, evaluate pure guard, select one transition, compute next state, then emit data-only intents."
  },
  "runtime_binding": {
    "typescript_reference": "wiki-event/v1 implements page_lifecycle and the legacy KG review topology; its unbound publisher intent is disabled at the adapter boundary.",
    "python_backend_target": "Implements the public revision surface and must bind this exact reactive quarantine machine before public writes are activated.",
    "compatibility_rule": "Shared state/effect names and golden outcomes are normative. A runtime may omit moderation only while its public write routes remain disabled. KG canon dispatch remains disabled-unbound-v1 independently of community visibility."
  },
  "context_schema": {
    "head_revision_id": {"type": "string"},
    "head_actor_id": {"type": "actor-id"},
    "submitter_id": {"type": "actor-id"},
    "reviewed_revision_id": {"type": "string"},
    "reviewed_content_hash": {"type": "string"},
    "authorized_revision_id": {"type": "string"},
    "authorized_content_hash": {"type": "string"},
    "authorized_approval_receipt_id": {"type": "string"},
    "head_content_hash": {"type": "sha256"},
    "moderated_revision_id": {"type": "string"},
    "moderated_content_hash": {"type": "string"},
    "proposal_id": {"type": "string"},
    "proposal_plan_hash": {"type": "sha256"}
  },
  "event_schemas": {
    "PAGE_REPORTED": {
      "type": "object",
      "required": ["page_id", "revision_id", "content_hash", "report_id", "reason", "actor", "event_id"],
      "properties": {
        "page_id": {"type": "string"},
        "revision_id": {"type": "string"},
        "content_hash": {"type": "sha256"},
        "report_id": {"type": "string"},
        "reason": {"type": "string"},
        "actor": {"type": "actor-id"},
        "event_id": {"type": "string"}
      }
    },
    "PAGE_QUARANTINED": {
      "type": "object",
      "required": ["page_id", "revision_id", "content_hash", "moderator_id", "reason_code", "policy_version", "moderation_receipt_id", "actor", "event_id"],
      "properties": {
        "page_id": {"type": "string"}, "revision_id": {"type": "string"}, "content_hash": {"type": "sha256"},
        "moderator_id": {"type": "actor-id"}, "reason_code": {"type": "string"}, "policy_version": {"type": "string"},
        "moderation_receipt_id": {"type": "string"}, "actor": {"type": "actor-id"}, "event_id": {"type": "string"}
      }
    },
    "PAGE_RELEASED": {
      "type": "object",
      "required": ["page_id", "revision_id", "content_hash", "moderator_id", "reason_code", "policy_version", "moderation_receipt_id", "actor", "event_id"],
      "properties": {
        "page_id": {"type": "string"}, "revision_id": {"type": "string"}, "content_hash": {"type": "sha256"},
        "moderator_id": {"type": "actor-id"}, "reason_code": {"type": "string"}, "policy_version": {"type": "string"},
        "moderation_receipt_id": {"type": "string"}, "actor": {"type": "actor-id"}, "event_id": {"type": "string"}
      }
    },
    "PAGE_CREATED": {
      "type": "object",
      "required": ["page_id", "revision_id", "content_hash", "actor", "event_id"],
      "properties": {
        "page_id": {"type": "string"},
        "revision_id": {"type": "string"},
        "content_hash": {"type": "sha256"},
        "actor": {"type": "actor-id"},
        "event_id": {"type": "string"}
      }
    },
    "REVISION_COMMITTED": {
      "type": "object",
      "required": ["page_id", "revision_id", "parent_revision_id", "content_hash", "actor", "event_id"],
      "properties": {
        "page_id": {"type": "string"},
        "revision_id": {"type": "string"},
        "parent_revision_id": {"type": "string"},
        "content_hash": {"type": "sha256"},
        "actor": {"type": "actor-id"},
        "event_id": {"type": "string"}
      }
    },
    "PAGE_DELETED": {
      "type": "object",
      "required": ["page_id", "revision_id", "actor", "event_id"],
      "properties": {
        "page_id": {"type": "string"},
        "revision_id": {"type": "string"},
        "actor": {"type": "actor-id"},
        "event_id": {"type": "string"}
      }
    },
    "PAGE_RESTORED": {
      "type": "object",
      "required": ["page_id", "revision_id", "actor", "event_id"],
      "properties": {
        "page_id": {"type": "string"},
        "revision_id": {"type": "string"},
        "actor": {"type": "actor-id"},
        "event_id": {"type": "string"}
      }
    },
    "KG_REVIEW_SUBMITTED": {
      "type": "object",
      "required": ["page_id", "proposal_id", "revision_id", "content_hash", "target_kind", "target_stable_id", "base_kg_snapshot_hash", "change_set", "plan_hash", "mapping_version", "policy_version", "source_refs", "actor", "event_id"],
      "properties": {
        "page_id": {"type": "string"},
        "proposal_id": {"type": "string"},
        "revision_id": {"type": "string"},
        "content_hash": {"type": "sha256"},
        "target_kind": {"type": "enum", "values": ["node", "relationship", "property-set"]},
        "target_stable_id": {"type": "string"},
        "base_kg_snapshot_hash": {"type": "sha256"},
        "change_set": {"type": "array", "items": "typed-allowlisted-operation", "minItems": 1},
        "plan_hash": {"type": "sha256"},
        "mapping_version": {"type": "string"},
        "policy_version": {"type": "string"},
        "source_refs": {"type": "array", "items": "source-ref", "minItems": 1},
        "actor": {"type": "actor-id"},
        "event_id": {"type": "string"}
      }
    },
    "KG_PROPOSAL_APPROVED": {
      "type": "object",
      "required": ["page_id", "proposal_id", "revision_id", "content_hash", "plan_hash", "actor", "event_id"],
      "properties": {
        "page_id": {"type": "string"},
        "proposal_id": {"type": "string"},
        "revision_id": {"type": "string"},
        "content_hash": {"type": "sha256"},
        "plan_hash": {"type": "sha256"},
        "actor": {"type": "actor-id"},
        "event_id": {"type": "string"}
      }
    },
    "KG_PROPOSAL_REJECTED": {
      "type": "object",
      "required": ["page_id", "proposal_id", "revision_id", "content_hash", "plan_hash", "reason", "actor", "event_id"],
      "properties": {
        "page_id": {"type": "string"},
        "proposal_id": {"type": "string"},
        "revision_id": {"type": "string"},
        "content_hash": {"type": "sha256"},
        "plan_hash": {"type": "sha256"},
        "reason": {"type": "string"},
        "actor": {"type": "actor-id"},
        "event_id": {"type": "string"}
      }
    },
    "KG_CANON_AUTHORIZED": {
      "type": "object",
      "required": ["page_id", "proposal_id", "revision_id", "content_hash", "plan_hash", "base_kg_snapshot_hash", "approval_receipt_id", "actor", "event_id"],
      "properties": {
        "page_id": {"type": "string"},
        "proposal_id": {"type": "string"},
        "revision_id": {"type": "string"},
        "content_hash": {"type": "sha256"},
        "plan_hash": {"type": "sha256"},
        "base_kg_snapshot_hash": {"type": "sha256"},
        "approval_receipt_id": {"type": "string"},
        "actor": {"type": "actor-id"},
        "event_id": {"type": "string"}
      }
    },
    "KG_CANON_APPLIED": {
      "type": "object",
      "required": ["page_id", "proposal_id", "revision_id", "content_hash", "plan_hash", "base_kg_snapshot_hash", "result_kg_snapshot_hash", "approval_receipt_id", "application_receipt_id", "actor", "event_id"],
      "properties": {
        "page_id": {"type": "string"},
        "proposal_id": {"type": "string"},
        "revision_id": {"type": "string"},
        "content_hash": {"type": "sha256"},
        "plan_hash": {"type": "sha256"},
        "base_kg_snapshot_hash": {"type": "sha256"},
        "result_kg_snapshot_hash": {"type": "sha256"},
        "approval_receipt_id": {"type": "string"},
        "application_receipt_id": {"type": "string"},
        "actor": {"type": "actor-id"},
        "event_id": {"type": "string"}
      }
    },
    "KG_PROPOSAL_SUPERSEDED": {
      "type": "object",
      "required": ["page_id", "proposal_id", "revision_id", "content_hash", "plan_hash", "previous_status", "replacement_revision_id", "reason", "actor", "event_id"],
      "properties": {
        "page_id": {"type": "string"},
        "proposal_id": {"type": "string"},
        "revision_id": {"type": "string"},
        "content_hash": {"type": "sha256"},
        "plan_hash": {"type": "sha256"},
        "previous_status": {"type": "enum", "values": ["in_review", "review_approved", "rejected"]},
        "replacement_revision_id": {"type": "revision-id-or-null"},
        "reason": {"type": "enum", "values": ["new_revision", "page_deleted"]},
        "actor": {"type": "actor-id"},
        "event_id": {"type": "string"}
      }
    }
  },
  "guards": {
    "moderator_can_quarantine_head": {
      "reads": ["head_revision_id", "head_content_hash", "head_actor_id"],
      "event_reads": ["revision_id", "content_hash", "actor"],
      "required_capability": "wiki:moderate",
      "predicate": "event.actor != head_actor_id && event.revision_id == head_revision_id && event.content_hash == head_content_hash",
      "pure": true,
      "synchronous": true
    },
    "moderator_can_release_bound_revision": {
      "reads": ["moderated_revision_id", "moderated_content_hash", "head_actor_id"],
      "event_reads": ["revision_id", "content_hash", "actor"],
      "required_capability": "wiki:moderate",
      "predicate": "event.actor != head_actor_id && event.revision_id == moderated_revision_id && event.content_hash == moderated_content_hash",
      "pure": true,
      "synchronous": true
    },
    "head_matches": {
      "reads": ["head_revision_id"],
      "event_reads": ["parent_revision_id"],
      "pure": true,
      "synchronous": true
    },
    "reviewer_is_distinct": {
      "reads": ["submitter_id"],
      "event_reads": ["actor"],
      "pure": true,
      "synchronous": true
    },
    "authorization_matches_review": {
      "reads": ["reviewed_revision_id", "reviewed_content_hash"],
      "event_reads": ["revision_id", "content_hash"],
      "pure": true,
      "synchronous": true
    },
    "application_matches_authorization": {
      "reads": ["authorized_revision_id", "authorized_content_hash", "authorized_approval_receipt_id"],
      "event_reads": ["revision_id", "content_hash", "approval_receipt_id", "application_receipt_id"],
      "pure": true,
      "synchronous": true
    }
  },
  "effects": {
    "QueueModerationReport": {
      "kind": "command",
      "payload_schema": {
        "type": "object",
        "required": ["page_id", "revision_id", "content_hash", "report_id", "reason"],
        "properties": {
          "page_id": {"type": "string"}, "revision_id": {"type": "string"},
          "content_hash": {"type": "sha256"}, "report_id": {"type": "string"}, "reason": {"type": "string"}
        }
      }
    },
    "RecordModerationStatus": {
      "kind": "command",
      "payload_schema": {
        "type": "object",
        "required": ["page_id", "revision_id", "content_hash", "status"],
        "properties": {
          "page_id": {"type": "string"}, "revision_id": {"type": "string"},
          "content_hash": {"type": "sha256"}, "status": {"type": "string"}
        }
      }
    },
    "RecordPageProjection": {
      "kind": "command",
      "payload_schema": {
        "type": "object",
        "required": ["page_id", "event_id"],
        "properties": {"page_id": {"type": "string"}, "event_id": {"type": "string"}}
      }
    },
    "RecordRevisionProjection": {
      "kind": "command",
      "payload_schema": {
        "type": "object",
        "required": ["page_id", "revision_id"],
        "properties": {"page_id": {"type": "string"}, "revision_id": {"type": "string"}}
      }
    },
    "RecordLifecycleChange": {
      "kind": "command",
      "payload_schema": {
        "type": "object",
        "required": ["page_id", "event_id"],
        "properties": {"page_id": {"type": "string"}, "event_id": {"type": "string"}}
      }
    },
    "RecordReviewStatus": {
      "kind": "command",
      "payload_schema": {
        "type": "object",
        "required": ["page_id", "revision_id", "status"],
        "properties": {
          "page_id": {"type": "string"},
          "revision_id": {"type": "string"},
          "status": {"type": "string"}
        }
      }
    },
    "QueueCanonApplication": {
      "kind": "command",
      "dispatch_status": "disabled-unbound-v1",
      "disabled_reason": "Legacy intent lacks proposal_id, typed target/change_set, plan_hash, mapping/policy versions, source refs, and base KG snapshot binding.",
      "payload_schema": {
        "type": "object",
        "required": ["page_id", "revision_id", "content_hash", "approval_receipt_id"],
        "properties": {
          "page_id": {"type": "string"},
          "revision_id": {"type": "string"},
          "content_hash": {"type": "string"},
          "approval_receipt_id": {"type": "string"}
        }
      }
    },
    "AuditInvalidTransition": {
      "kind": "audit",
      "payload_schema": {
        "type": "object",
        "required": ["state", "event", "actor", "reason", "event_id"],
        "properties": {
          "state": {"type": "string"},
          "event": {"type": "string"},
          "actor": {"type": "actor-id"},
          "reason": {"type": "string"},
          "event_id": {"type": "string"}
        }
      }
    }
  },
  "machines": [
    {
      "id": "page_lifecycle",
      "initial": "absent",
      "states": [
        {"id": "absent", "kind": "atomic"},
        {"id": "active", "kind": "atomic"},
        {"id": "deleted", "kind": "atomic"}
      ],
      "events": ["PAGE_CREATED", "REVISION_COMMITTED", "PAGE_DELETED", "PAGE_RESTORED"],
      "invalid_event_policy": {
        "mode": "reject-and-audit",
        "guard_false": "reject-and-audit",
        "state_change": "none",
        "effect": "AuditInvalidTransition",
        "effect_binding": {
          "state": "configuration.state",
          "event": "event.type",
          "actor": "event.actor",
          "reason": "rejection.reason",
          "event_id": "event.event_id"
        }
      },
      "transitions": [
        {
          "id": "create_page",
          "from": "absent",
          "event": "PAGE_CREATED",
          "to": "active",
          "effects": ["RecordPageProjection"],
          "effect_bindings": {"RecordPageProjection": {"page_id": "event.page_id", "event_id": "event.event_id"}}
        },
        {
          "id": "commit_revision",
          "from": "active",
          "event": "REVISION_COMMITTED",
          "to": "active",
          "guard": "head_matches",
          "effects": ["RecordRevisionProjection"],
          "effect_bindings": {"RecordRevisionProjection": {"page_id": "event.page_id", "revision_id": "event.revision_id"}}
        },
        {
          "id": "delete_page",
          "from": "active",
          "event": "PAGE_DELETED",
          "to": "deleted",
          "effects": ["RecordLifecycleChange"],
          "effect_bindings": {"RecordLifecycleChange": {"page_id": "event.page_id", "event_id": "event.event_id"}}
        },
        {
          "id": "restore_page",
          "from": "deleted",
          "event": "PAGE_RESTORED",
          "to": "active",
          "effects": ["RecordLifecycleChange"],
          "effect_bindings": {"RecordLifecycleChange": {"page_id": "event.page_id", "event_id": "event.event_id"}}
        }
      ]
    },
    {
      "id": "content_moderation",
      "initial": "visible",
      "implementation_status": "python-runtime-binding-required-before-public-write-activation; typescript-reference-contract-only",
      "states": [
        {"id": "visible", "kind": "atomic"},
        {"id": "quarantined", "kind": "atomic"}
      ],
      "events": ["PAGE_CREATED", "REVISION_COMMITTED", "PAGE_REPORTED", "PAGE_QUARANTINED", "PAGE_RELEASED"],
      "invalid_event_policy": {
        "mode": "reject-and-audit", "guard_false": "reject-and-audit", "state_change": "none", "effect": "AuditInvalidTransition",
        "effect_binding": {"state": "configuration.state", "event": "event.type", "actor": "event.actor", "reason": "rejection.reason", "event_id": "event.event_id"}
      },
      "transitions": [
        {"id": "create_visible", "from": "visible", "event": "PAGE_CREATED", "to": "visible", "effects": ["RecordModerationStatus"], "effect_bindings": {"RecordModerationStatus": {"page_id": "event.page_id", "revision_id": "event.revision_id", "content_hash": "event.content_hash", "status": "literal:visible"}}},
        {"id": "edit_visible", "from": "visible", "event": "REVISION_COMMITTED", "to": "visible", "effects": ["RecordModerationStatus"], "effect_bindings": {"RecordModerationStatus": {"page_id": "event.page_id", "revision_id": "event.revision_id", "content_hash": "event.content_hash", "status": "literal:visible"}}},
        {"id": "report_visible", "from": "visible", "event": "PAGE_REPORTED", "to": "visible", "effects": ["QueueModerationReport"], "effect_bindings": {"QueueModerationReport": {"page_id": "event.page_id", "revision_id": "event.revision_id", "content_hash": "event.content_hash", "report_id": "event.report_id", "reason": "event.reason"}}},
        {"id": "quarantine_head", "from": "visible", "event": "PAGE_QUARANTINED", "to": "quarantined", "guard": "moderator_can_quarantine_head", "effects": ["RecordModerationStatus"], "effect_bindings": {"RecordModerationStatus": {"page_id": "event.page_id", "revision_id": "event.revision_id", "content_hash": "event.content_hash", "status": "literal:quarantined"}}},
        {"id": "release_bound_revision", "from": "quarantined", "event": "PAGE_RELEASED", "to": "visible", "guard": "moderator_can_release_bound_revision", "effects": ["RecordModerationStatus"], "effect_bindings": {"RecordModerationStatus": {"page_id": "event.page_id", "revision_id": "event.revision_id", "content_hash": "event.content_hash", "status": "literal:visible"}}}
      ]
    },
    {
      "id": "kg_canon_workflow",
      "initial": "unsubmitted",
      "states": [
        {"id": "unsubmitted", "kind": "atomic"},
        {"id": "in_review", "kind": "atomic"},
        {"id": "review_approved", "kind": "atomic"},
        {"id": "canon_authorized", "kind": "atomic"},
        {"id": "canon_applied", "kind": "atomic"},
        {"id": "rejected", "kind": "atomic"},
        {"id": "superseded", "kind": "atomic"}
      ],
      "events": [
        "KG_REVIEW_SUBMITTED",
        "KG_PROPOSAL_APPROVED",
        "KG_PROPOSAL_REJECTED",
        "KG_CANON_AUTHORIZED",
        "KG_CANON_APPLIED",
        "KG_PROPOSAL_SUPERSEDED"
      ],
      "invalid_event_policy": {
        "mode": "reject-and-audit",
        "guard_false": "reject-and-audit",
        "state_change": "none",
        "effect": "AuditInvalidTransition",
        "effect_binding": {
          "state": "configuration.state",
          "event": "event.type",
          "actor": "event.actor",
          "reason": "rejection.reason",
          "event_id": "event.event_id"
        }
      },
      "transitions": [
        {
          "id": "submit_new",
          "from": "unsubmitted",
          "event": "KG_REVIEW_SUBMITTED",
          "to": "in_review",
          "effects": ["RecordReviewStatus"],
          "effect_bindings": {"RecordReviewStatus": {"page_id": "event.page_id", "revision_id": "event.revision_id", "status": "literal:in_review"}}
        },
        {
          "id": "resubmit_rejected",
          "from": "rejected",
          "event": "KG_REVIEW_SUBMITTED",
          "to": "in_review",
          "effects": ["RecordReviewStatus"],
          "effect_bindings": {"RecordReviewStatus": {"page_id": "event.page_id", "revision_id": "event.revision_id", "status": "literal:in_review"}}
        },
        {
          "id": "resubmit_superseded",
          "from": "superseded",
          "event": "KG_REVIEW_SUBMITTED",
          "to": "in_review",
          "effects": ["RecordReviewStatus"],
          "effect_bindings": {"RecordReviewStatus": {"page_id": "event.page_id", "revision_id": "event.revision_id", "status": "literal:in_review"}}
        },
        {
          "id": "submit_after_applied",
          "from": "canon_applied",
          "event": "KG_REVIEW_SUBMITTED",
          "to": "in_review",
          "effects": ["RecordReviewStatus"],
          "effect_bindings": {"RecordReviewStatus": {"page_id": "event.page_id", "revision_id": "event.revision_id", "status": "literal:in_review"}}
        },
        {
          "id": "approve_proposal",
          "from": "in_review",
          "event": "KG_PROPOSAL_APPROVED",
          "to": "review_approved",
          "guard": "reviewer_is_distinct",
          "effects": ["RecordReviewStatus"],
          "effect_bindings": {"RecordReviewStatus": {"page_id": "event.page_id", "revision_id": "event.revision_id", "status": "literal:review_approved"}}
        },
        {
          "id": "reject_proposal",
          "from": "in_review",
          "event": "KG_PROPOSAL_REJECTED",
          "to": "rejected",
          "guard": "reviewer_is_distinct",
          "effects": ["RecordReviewStatus"],
          "effect_bindings": {"RecordReviewStatus": {"page_id": "event.page_id", "revision_id": "event.revision_id", "status": "literal:rejected"}}
        },
        {
          "id": "authorize_canon",
          "from": "review_approved",
          "event": "KG_CANON_AUTHORIZED",
          "to": "canon_authorized",
          "guard": "authorization_matches_review",
          "effects": ["QueueCanonApplication"],
          "effect_bindings": {"QueueCanonApplication": {"page_id": "event.page_id", "revision_id": "event.revision_id", "content_hash": "event.content_hash", "approval_receipt_id": "event.approval_receipt_id"}}
        },
        {
          "id": "record_canon_application",
          "from": "canon_authorized",
          "event": "KG_CANON_APPLIED",
          "to": "canon_applied",
          "guard": "application_matches_authorization",
          "effects": ["RecordReviewStatus"],
          "effect_bindings": {"RecordReviewStatus": {"page_id": "event.page_id", "revision_id": "event.revision_id", "status": "literal:canon_applied"}}
        },
        {
          "id": "supersede_review",
          "from": "in_review",
          "event": "KG_PROPOSAL_SUPERSEDED",
          "to": "superseded",
          "effects": ["RecordReviewStatus"],
          "effect_bindings": {"RecordReviewStatus": {"page_id": "event.page_id", "revision_id": "event.revision_id", "status": "literal:superseded"}}
        },
        {
          "id": "supersede_review_approval",
          "from": "review_approved",
          "event": "KG_PROPOSAL_SUPERSEDED",
          "to": "superseded",
          "effects": ["RecordReviewStatus"],
          "effect_bindings": {"RecordReviewStatus": {"page_id": "event.page_id", "revision_id": "event.revision_id", "status": "literal:superseded"}}
        },
        {
          "id": "supersede_rejection",
          "from": "rejected",
