        {"event": "KG_CANON_AUTHORIZED", "guard_results": {"authorization_matches_review": true}, "expected_state": "canon_authorized", "expected_effects": ["QueueCanonApplication"]},
        {"event": "KG_CANON_APPLIED", "guard_results": {"application_matches_authorization": true}, "expected_state": "canon_applied", "expected_effects": ["RecordReviewStatus"]}
      ]
    },
