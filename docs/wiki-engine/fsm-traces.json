{
  "cases": [
    {
      "id": "page-create-edit-delete-restore",
      "machine": "page_lifecycle",
      "steps": [
        {"event": "PAGE_CREATED", "guard_results": {}, "expected_state": "active", "expected_effects": ["RecordPageProjection"]},
        {"event": "REVISION_COMMITTED", "guard_results": {"head_matches": true}, "expected_state": "active", "expected_effects": ["RecordRevisionProjection"]},
        {"event": "PAGE_DELETED", "guard_results": {}, "expected_state": "deleted", "expected_effects": ["RecordLifecycleChange"]},
        {"event": "PAGE_RESTORED", "guard_results": {}, "expected_state": "active", "expected_effects": ["RecordLifecycleChange"]}
      ]
    },
    {
      "id": "page-stale-parent",
      "machine": "page_lifecycle",
      "steps": [
        {"event": "PAGE_CREATED", "guard_results": {}, "expected_state": "active", "expected_effects": ["RecordPageProjection"]},
        {"event": "REVISION_COMMITTED", "guard_results": {"head_matches": false}, "expected_state": "active", "expected_effects": ["AuditInvalidTransition"]}
      ]
    },
    {
      "id": "page-invalid-delete-before-create",
      "machine": "page_lifecycle",
      "steps": [
        {"event": "PAGE_DELETED", "guard_results": {}, "expected_state": "absent", "expected_effects": ["AuditInvalidTransition"]}
      ]
    },
