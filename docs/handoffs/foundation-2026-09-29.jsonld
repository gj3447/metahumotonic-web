    },
    {
      "@id": "urn:metahumotonic:handoff:foundation:2026-09-29#claim-backend-scope",
      "@type": [
        "schema:CreativeWork",
        "prov:Entity"
      ],
      "schema:about": {
        "@id": "https://github.com/gj3447/metahumotonic-web"
      },
      "schema:text": "The work covered static web content, public Foundation projections and Foundation documents. It did not perform a TypeScript/Effect production backend cutover or PostgreSQL/MCP migration. Backend runtime claims require a separate current audit.",
      "prov:wasDerivedFrom": {
        "@id": "https://github.com/gj3447/metahumotonic-web/blob/6bc8aa2672731655453be8cb1bb2c4accc8a0c65/docs/SERVICE_HUB_2026-09-28.md"
