    },
    {
      "@id": "urn:metahumotonic:handoff:foundation:2026-09-29#apply-nginx-mime",
      "@type": "schema:Action",
      "schema:name": "Apply and verify Foundation JSON-LD media type",
      "schema:actionStatus": {
        "@id": "schema:PotentialActionStatus"
      },
      "schema:object": [
        {
          "@id": "urn:metahumotonic:handoff:foundation:2026-09-29#live-nginx"
