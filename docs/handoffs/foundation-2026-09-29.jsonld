      },
      "schema:subjectOf": {
        "@id": "urn:metahumotonic:handoff:foundation:2026-09-29#evidence"
      },
      "schema:description": "Responsible role: public edge operator, unassigned. Python-urllib/3.13 returned 403 with a Cloudflare server header while curl/8.0.1 returned 200 in the same urllib transport. Inspect the matching edge event before attributing a rule or changing policy. Acceptance: document the intended public machine-client policy and verify it with the two probes. No policy change was made in this handoff.",
      "mh:authority": "SECONDARY_AI_HANDOFF_TASK",
      "mh:status": "OPEN_INVESTIGATION"
