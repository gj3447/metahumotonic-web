@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix shape: <https://metahumotonic.com/apostles/shapes#> .

shape:Concept a sh:NodeShape ;
  sh:targetClass skos:Concept ; sh:nodeKind sh:IRI ;
  sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:maxCount 1 ; sh:languageIn ("ko") ] ;
  sh:property [ sh:path skos:notation ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^apostle-([1-9]|1[0-2])$" ] ;
  sh:property [ sh:path skos:inScheme ; sh:minCount 1 ; sh:maxCount 1 ; sh:class skos:ConceptScheme ] ;
  sh:property [ sh:path schema:subjectOf ; sh:minCount 2 ; sh:maxCount 2 ; sh:class schema:WebPage ] ;
  sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:class prov:Entity ] ;
  sh:property [ sh:path skos:editorialNote ; sh:hasValue "EDITORIAL_SUMMARY" ; sh:maxCount 1 ] ;
  sh:property [ sh:path owl:sameAs ; sh:maxCount 0 ] ;
  sh:property [ sh:path skos:exactMatch ; sh:maxCount 0 ] .

shape:Page a sh:NodeShape ;
  sh:targetClass schema:WebPage ; sh:nodeKind sh:IRI ;
  sh:property [ sh:path schema:about ; sh:minCount 1 ; sh:maxCount 1 ; sh:class skos:Concept ; sh:equals schema:mainEntity ] ;
  sh:property [ sh:path schema:url ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:maxCount 1 ] .

shape:Scheme a sh:NodeShape ;
  sh:targetNode <https://metahumotonic.com/apostles/#scheme> ;
  sh:class skos:ConceptScheme ;
  sh:property [ sh:path skos:hasTopConcept ; sh:minCount 12 ; sh:maxCount 12 ; sh:class skos:Concept ] .

shape:Collection a sh:NodeShape ;
  sh:targetNode <https://metahumotonic.com/apostles/#collection> ;
  sh:class skos:OrderedCollection ;
  sh:property [ sh:path skos:memberList ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path (skos:memberList [sh:zeroOrMorePath rdf:rest] rdf:first) ;
    sh:minCount 12 ; sh:maxCount 12 ; sh:class skos:Concept ] .
