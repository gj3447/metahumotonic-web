---
import WorkbenchLayout from '../layouts/WorkbenchLayout.astro';
import { pageGraph } from '../lib/public-content';

const resources = [
  { label: '연구 데이터', title: 'Research feed', href: '/api/research/summary', note: '공개 연구 요약을 JSON으로 읽습니다.', kind: 'READ ONLY' },
  { label: '연구 데이터', title: 'Agent feed', href: '/api/research/agent', note: '에이전트가 읽을 수 있는 연구 피드입니다.', kind: 'READ ONLY' },
  { label: '커뮤니티', title: 'Wiki index', href: '/api/wiki/v1', note: '공개 Community Wiki의 API 시작점입니다.', kind: 'READ ONLY' },
  { label: '연결 데이터', title: 'Learning graph', href: '/learn/graph.jsonld', note: '철학, 프로그램, 공개 자료의 JSON-LD 그래프입니다.', kind: 'JSON-LD' },
  { label: '연결 데이터', title: 'USL graph', href: '/learn/usl.json', note: '공개 학습 지도를 USL 입력으로 읽습니다.', kind: 'USL' },
  { label: 'Agent discovery', title: 'MCP registry', href: '/mcp/', note: '등록 현황을 추측하지 않고, 공개 레지스트리 안내로 연결합니다.', kind: 'DIRECTORY' },
];
---

<WorkbenchLayout title="공개 API와 데이터 — MetaHumotonic" description="MetaHumotonic의 공개 읽기 전용 API와 JSON-LD·USL 연결 데이터를 한곳에서 찾습니다." path="/api/" structuredData={pageGraph('/api/', '공개 API와 데이터', ['hswm', 'usl', 'projects'])}>
  <main id="main-content" class="developer-main shell">
    <nav class="breadcrumb" aria-label="현재 위치"><a href="/">홈</a><span aria-hidden="true">/</span><span aria-current="page">API</span></nav>
    <header class="developer-hero">
      <div>
        <p class="eyebrow">PUBLIC DATA · DEVELOPER ENTRY</p>
        <h1>읽을 수 있는<br /><em>연결의 표면.</em></h1>
        <p>이 페이지는 공개적으로 읽을 수 있는 데이터 입구만 모읍니다. 운영 콘솔, 인프라 주소, 자격증명과 연결 방법은 여기에 두지 않습니다.</p>
      </div>
      <div class="developer-art" aria-hidden="true"><i></i><i></i><i></i><b>API</b><span>PUBLIC<br />READ</span></div>
    </header>

    <section class="developer-principles" aria-label="공개 API 원칙">
      <article><span>01</span><h2>읽기 전용부터</h2><p>문서와 연구, 연결 데이터를 확인할 수 있는 입구를 우선 공개합니다.</p></article>
      <article><span>02</span><h2>상태는 응답으로</h2><p>이 화면은 서비스가 살아 있다고 단정하지 않습니다. 최신 상태는 각 응답에서 확인합니다.</p></article>
      <article><span>03</span><h2>경계는 분명하게</h2><p>접근 권한이 필요한 운영 기능은 공개 디렉터리에서 분리합니다.</p></article>
    </section>

    <section class="developer-directory" aria-labelledby="resource-title">
      <div class="section-heading"><div><p class="eyebrow">PUBLIC DIRECTORY</p><h2 id="resource-title">데이터를 찾는 여섯 길.</h2></div><p>사람은 페이지로, 도구는 JSON과 JSON-LD로<br />같은 공개 자료에 도달합니다.</p></div>
      <div class="resource-grid">
        {resources.map((resource, index) => <a class="resource-card" href={resource.href}>
          <div><span class="mini-label">{String(index + 1).padStart(2, '0')} / {resource.label}</span><span class="resource-kind">{resource.kind}</span></div>
          <h3>{resource.title}</h3><p>{resource.note}</p><span class="resource-open" aria-hidden="true">↗</span>
        </a>)}
      </div>
    </section>

    <aside class="developer-callout"><div><p class="eyebrow">SERVICE DIRECTORY</p><h2>제품과 자료, 개발 표면을<br />한 장의 지도로.</h2></div><div><p>전체 서비스의 공개 접근 경로는 서비스 디렉터리에서 분야별로 정리합니다. 내부 운영 기능은 권한이 필요한 별도 표면으로 남겨 둡니다.</p><a class="text-link" href="/services/">서비스 디렉터리 열기 →</a></div></aside>
  </main>
</WorkbenchLayout>

<style>
  .developer-main { padding-block: 30px 100px; }
  .developer-hero { display:grid; grid-template-columns:1.1fr .9fr; gap:70px; align-items:center; padding:50px 0 84px; border-bottom:1px solid var(--border); }
  .developer-hero h1 { font-size:clamp(44px, 6vw, 76px); font-weight:550; letter-spacing:-.065em; line-height:1.13; }
  .developer-hero h1 em { color:#566e5c; font-style:normal; }
  .developer-hero p:last-child { max-width:54ch; margin-top:24px; color:var(--muted); font-size:16px; line-height:1.9; }
  .developer-art { min-height:310px; position:relative; display:grid; place-items:center; overflow:hidden; border-radius:7px; background:#17221e; color:#e6eee5; }
  .developer-art i { position:absolute; width:68%; aspect-ratio:1; border:1px solid rgba(206,226,207,.27); border-radius:50%; }
  .developer-art i:nth-child(2) { width:46%; border-color:rgba(0,229,255,.6); }
  .developer-art i:nth-child(3) { width:25%; border-color:rgba(255,230,0,.7); }
  .developer-art b { position:relative; font:500 clamp(40px,6vw,68px)/1 var(--mono); letter-spacing:.1em; }
  .developer-art span { position:absolute; top:24px; left:25px; font:10px/1.5 var(--mono); letter-spacing:.1em; color:#b4c3b5; }
  .developer-principles { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); border-bottom:1px solid var(--border); }
  .developer-principles article { padding:32px 26px 36px; border-left:1px solid var(--border); }
  .developer-principles article:first-child { border-left:0; padding-left:0; }
  .developer-principles article:last-child { padding-right:0; }
  .developer-principles span { font:11px var(--mono); color:var(--muted); }
  .developer-principles h2 { margin:19px 0 11px; font-size:22px; letter-spacing:-.04em; }
  .developer-principles p { color:var(--muted); font-size:14px; line-height:1.75; }
  .developer-directory { padding-top:94px; }
  .resource-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); border-top:1px solid var(--border); border-left:1px solid var(--border); }
  .resource-card { min-height:240px; position:relative; display:flex; flex-direction:column; padding:25px; border-right:1px solid var(--border); border-bottom:1px solid var(--border); transition:background .18s; }
  .resource-card:hover { background:var(--surface); }
  .resource-card > div { display:flex; justify-content:space-between; gap:12px; }
  .resource-kind { font:10px var(--mono); color:var(--muted); }
  .resource-card h3 { margin:34px 0 10px; font-size:25px; line-height:1.2; letter-spacing:-.045em; font-weight:550; }
  .resource-card p { max-width:29ch; color:var(--muted); font-size:14px; line-height:1.75; }
  .resource-open { margin-top:auto; align-self:flex-end; font-size:21px; }
  .developer-callout { display:grid; grid-template-columns:1fr 1fr; gap:60px; margin-top:94px; padding:50px; background:#e5ece2; border-radius:7px; }
  .developer-callout h2 { font-size:clamp(27px,3vw,39px); line-height:1.35; }
  .developer-callout > div:last-child { color:#4e6254; }
  .developer-callout .text-link { margin-top:20px; color:var(--text); }
  @media (max-width:760px) { .developer-hero,.developer-callout { grid-template-columns:1fr; gap:34px; } .developer-hero { padding:32px 0 60px; } .developer-art { min-height:220px; } .developer-principles,.resource-grid { grid-template-columns:1fr; } .developer-principles article,.developer-principles article:first-child,.developer-principles article:last-child { padding:25px 0; border-left:0; border-top:1px solid var(--border); } .developer-principles article:first-child { border-top:0; } .resource-card { min-height:190px; } .developer-callout { margin-top:60px; padding:30px; } }
</style>
