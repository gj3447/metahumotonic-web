---
// KG: TASK_FE_MetaDemo, CONTRACT_FE_MetaDemo
import '../styles/cosmos.css';
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>333 Platform — MetaHumotonic</title>
  <meta name="description" content="333: Decentralized apps platform. Your browser is the server." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body style="background:#050810; color:#e0e6f0; margin:0;">
  <div class="starfield-bg" aria-hidden="true"></div>
  <div class="vignette" aria-hidden="true"></div>

  <div style="position:relative; z-index:1;">
    <nav style="padding:1rem 1.5rem; border-bottom:1px solid rgba(107,76,153,0.2);">
      <div style="max-width:960px; margin:0 auto; display:flex; align-items:center; justify-content:space-between;">
        <a href="/" style="color:#e0e6f0; text-decoration:none; font-weight:700;">← MetaHumotonic</a>
        <span style="color:#a78bfa; font-weight:600;">333 Platform</span>
      </div>
    </nav>

    <main style="max-width:960px; margin:0 auto; padding:2rem 1.5rem;">
      <!-- Hero -->
      <section style="text-align:center; padding:3rem 0 2rem;">
        <h1 style="font-size:3rem; font-weight:900;">
          <span style="color:#f472b6;">333</span> Platform
        </h1>
        <p style="color:#a78bfa; font-size:1.2rem; font-weight:600; letter-spacing:0.05em; margin:0.5rem 0;">
          Decentralized Apps. No Server. Just Browsers.
        </p>
        <p style="color:#8892b0; max-width:550px; margin:1rem auto 2rem; line-height:1.7;">
          333 is a decentralized WeChat built on Rust/WASM. Your browser is the server &mdash;
          WebRTC for P2P, CRDT for state sync, BFT for consensus. 152 tests. 150KB WASM.
        </p>
        <div style="display:flex; gap:1rem; justify-content:center; flex-wrap:wrap;">
          <a href="#demo" class="btn-glow btn-glow--pink">Try Live Demo</a>
          <a href="#apps" class="btn-glow btn-glow--purple">Browse Apps</a>
        </div>
      </section>

      <!-- Stats -->
      <section class="counters" style="margin:2rem 0;">
        <div class="counter-box">
          <span class="counter" data-count="8134">8,134</span>
          <span class="counter-box__label">Lines of Rust</span>
        </div>
        <div class="counter-box">
          <span class="counter" data-count="152">152</span>
          <span class="counter-box__label">Tests Passing</span>
        </div>
        <div class="counter-box">
          <span class="counter" data-count="150">150KB</span>
          <span class="counter-box__label">WASM Size</span>
        </div>
        <div class="counter-box">
          <span class="counter" data-count="0">0</span>
          <span class="counter-box__label">Servers Needed</span>
        </div>
      </section>

      <!-- 3 Pillars -->
      <section style="display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; margin:2rem 0;">
        <div class="domain-card" style="text-align:center">
          <div style="font-size:2rem; margin-bottom:0.5rem;">⚡</div>
          <h3>Compute</h3>
          <p style="font-size:0.8rem;">Rust → WASM · 150KB Runtime · Browser-native execution</p>
        </div>
        <div class="domain-card" style="text-align:center">
          <div style="font-size:2rem; margin-bottom:0.5rem;">🔗</div>
          <h3>Communication</h3>
          <p style="font-size:0.8rem;">WebRTC P2P · Signaling relay · Direct peer connections</p>
        </div>
        <div class="domain-card" style="text-align:center">
          <div style="font-size:2rem; margin-bottom:0.5rem;">💾</div>
          <h3>Storage</h3>
          <p style="font-size:0.8rem;">CRDT + DHT · IndexedDB cache · Serverless persistence</p>
        </div>
      </section>

      <!-- Interactive Demo -->
      <section id="demo" style="margin:3rem 0;">
        <h2 class="section-title">Live Demo — Block World</h2>
        <p style="color:#8892b0; text-align:center; margin-bottom:1.5rem; font-size:0.9rem;">
          Click blocks to place them. Open in two tabs to see CRDT sync in action.
        </p>
        <div class="domain-card" style="display:flex; flex-direction:column; align-items:center; gap:1rem; padding:2rem;">
          <div style="display:flex; gap:0.5rem;" id="block-palette">
            <button class="block-btn active" data-type="stone" style="background:#6b7280;">stone</button>
            <button class="block-btn" data-type="grass" style="background:#34d399;">grass</button>
            <button class="block-btn" data-type="water" style="background:#67e8f9;">water</button>
            <button class="block-btn" data-type="fire" style="background:#f472b6;">fire</button>
          </div>
          <div id="block-grid" style="display:grid; grid-template-columns:repeat(8,40px); gap:2px;"></div>
          <div style="display:flex; gap:2rem; color:#8892b0; font-size:0.8rem;">
            <span>Blocks: <strong id="block-count" style="color:#fbbf24;">0</strong></span>
          </div>
        </div>
      </section>

      <!-- Apps -->
      <section id="apps" style="margin:3rem 0;">
        <h2 class="section-title">Platform Apps</h2>
        <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(250px,1fr)); gap:1rem; margin-top:1.5rem;">
          <div class="domain-card">
            <span style="display:inline-block; background:rgba(52,211,153,0.15); color:#34d399; font-size:0.7rem; padding:0.15rem 0.5rem; border-radius:10px; font-weight:600;">LIVE</span>
            <h3 style="margin-top:0.5rem;">🧱 Block World</h3>
            <p style="font-size:0.8rem;">P2P block placement. CRDT LWW-Map real-time sync.</p>
          </div>
          <div class="domain-card">
            <span style="display:inline-block; background:rgba(52,211,153,0.15); color:#34d399; font-size:0.7rem; padding:0.15rem 0.5rem; border-radius:10px; font-weight:600;">LIVE</span>
            <h3 style="margin-top:0.5rem;">📝 CollabEditor</h3>
            <p style="font-size:0.8rem;">P2P text co-editing. RGA CRDT — no server sync.</p>
          </div>
          <div class="domain-card">
            <span style="display:inline-block; background:rgba(52,211,153,0.15); color:#34d399; font-size:0.7rem; padding:0.15rem 0.5rem; border-radius:10px; font-weight:600;">LIVE</span>
            <h3 style="margin-top:0.5rem;">🖥️ Compute</h3>
            <p style="font-size:0.8rem;">Browser distributed computing. Image, hash, matrix ops.</p>
          </div>
          <div class="domain-card" style="opacity:0.5;">
            <span style="display:inline-block; background:rgba(251,191,36,0.15); color:#fbbf24; font-size:0.7rem; padding:0.15rem 0.5rem; border-radius:10px; font-weight:600;">COMING</span>
            <h3 style="margin-top:0.5rem;">💬 Social Network</h3>
            <p style="font-size:0.8rem;">P2P social with OR-Set followers and DHT storage.</p>
          </div>
          <div class="domain-card" style="opacity:0.5;">
            <span style="display:inline-block; background:rgba(251,191,36,0.15); color:#fbbf24; font-size:0.7rem; padding:0.15rem 0.5rem; border-radius:10px; font-weight:600;">COMING</span>
            <h3 style="margin-top:0.5rem;">⚔️ StarCraft RTS</h3>
            <p style="font-size:0.8rem;">P2P real-time strategy with lockstep + CRDT hybrid.</p>
          </div>
        </div>
      </section>

      <!-- Tech Stack -->
      <section style="margin:3rem 0;">
        <h2 class="section-title">Tech Stack</h2>
        <div style="display:grid; grid-template-columns:repeat(2,1fr); gap:1rem; margin-top:1.5rem;">
          <div class="domain-card"><h3>CRDT</h3><p style="font-size:0.8rem;">HLC · Lamport · LWW-Map · OR-Set · RGA</p></div>
          <div class="domain-card"><h3>BFT Consensus</h3><p style="font-size:0.8rem;">HotStuff 3-phase · ViewChange · Executor</p></div>
          <div class="domain-card"><h3>333 Coin</h3><p style="font-size:0.8rem;">Utility Token · Stake · Slash · Halving · PoUW</p></div>
          <div class="domain-card"><h3>P2P Network</h3><p style="font-size:0.8rem;">WebRTC DataChannel · Signaling · MeshRoom</p></div>
        </div>
      </section>

      <!-- CTA -->
      <section style="text-align:center; padding:3rem 0; border-top:1px solid rgba(107,76,153,0.2);">
        <h2 style="font-size:1.5rem; margin-bottom:1rem;">
          Ready to go <span style="color:#f472b6;">serverless</span>?
        </h2>
        <p style="color:#8892b0; margin-bottom:1.5rem;">
          333 is open source. Run it in your browser. Contribute compute. Earn tokens.
        </p>
        <a href="/" class="btn-glow btn-glow--cyan" style="margin-right:0.5rem;">Back to MetaHumotonic</a>
      </section>
    </main>

    <footer style="text-align:center; padding:2rem; border-top:1px solid rgba(107,76,153,0.15); color:#4a5578; font-size:0.8rem;">
      <p><span style="color:#f472b6">333</span> Platform &mdash; <a href="/" style="color:#67e8f9">MetaHumotonic</a></p>
      <p style="margin-top:0.3rem">by Gyeongjun Ra · Rust · WASM · WebRTC · CRDT · HotStuff BFT</p>
    </footer>
  </div>

  <script is:inline>
    // Block world demo
    const colors = { stone:'#6b7280', grass:'#34d399', water:'#67e8f9', fire:'#f472b6', empty:'rgba(107,76,153,0.1)' };
    let selected = 'stone';
    const blocks = new Map();
    const grid = document.getElementById('block-grid');
    const countEl = document.getElementById('block-count');

    // Build grid
    for (let y = 0; y < 8; y++) {
      for (let x = 0; x < 8; x++) {
        const cell = document.createElement('button');
        cell.style.cssText = `width:40px;height:40px;border-radius:4px;border:none;cursor:pointer;background:${colors.empty};transition:transform 0.1s`;
        cell.addEventListener('mouseenter', () => cell.style.transform = 'scale(1.1)');
        cell.addEventListener('mouseleave', () => cell.style.transform = 'scale(1)');
        cell.addEventListener('click', () => {
          const key = `${x},${y}`;
          if (blocks.get(key) === selected) { blocks.delete(key); cell.style.background = colors.empty; }
          else { blocks.set(key, selected); cell.style.background = colors[selected]; }
          countEl.textContent = blocks.size;
        });
        cell.dataset.x = x; cell.dataset.y = y;
        grid.appendChild(cell);
      }
    }

    // Palette
    document.querySelectorAll('.block-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.block-btn').forEach(b => b.style.outline = 'none');
        btn.style.outline = '2px solid #fbbf24';
        selected = btn.dataset.type;
      });
    });
    document.querySelector('.block-btn').style.outline = '2px solid #fbbf24';
  </script>

  <style>
    .block-btn {
      padding: 0.3rem 0.7rem; border: none; border-radius: 6px;
      color: #050810; font-size: 0.75rem; font-weight: 700;
      cursor: pointer; text-transform: uppercase;
    }
    .block-btn:hover { opacity: 0.8; }
    @media (max-width: 640px) {
      section[style*="grid-template-columns:repeat(3"] { grid-template-columns: 1fr !important; }
      section[style*="grid-template-columns:repeat(2"] { grid-template-columns: 1fr !important; }
    }
  </style>
</body>
</html>
