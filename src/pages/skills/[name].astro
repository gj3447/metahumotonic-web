---
// KG: CONTRACT_Web_SkillDetail, ATOM_Web_SkillDetail
import '../../styles/cosmos.css';
import { getSkillDetail } from '../../lib/kg';

export function getStaticPaths() {
  const skills = [
    { name:'apt', description:'APT v24 orchestrator — KG 정본 기반. SA→SP→ST→SCW 순환.', category:'Methodology' },
    { name:'apt-sa', description:'SemanticAnchor — project identity and context bootstrap.', category:'Methodology' },
    { name:'apt-sp', description:'SemanticPyramid — recursive Span decomposition.', category:'Methodology' },
    { name:'apt-st', description:'SemanticTwin — crystallization of AtomicSpans into Contract + Task.', category:'Methodology' },
    { name:'apt-scw', description:'SourceCodeWorld — TDD implementation of crystallized Contracts.', category:'Methodology' },
    { name:'naesengmoon', description:'나생문 (canonical, alias taliban) — APT 면역 시스템. GAN 적대적 검증. 9-lens constitutional.', category:'Verification' },
    { name:'88-naesengmoon', description:'113-lens mathematical meta-verification — 수학적 렌즈로 적대적 검증.', category:'Verification' },
    { name:'prometheus', description:'Research-first methodology — 지식이 행동에 선행한다.', category:'Research' },
    { name:'longinus', description:'KG-Code traceability — KG↔Code 관통 바인딩.', category:'Methodology' },
    { name:'harness', description:'Architecture-as-constraint — 구조가 에이전트를 제약한다.', category:'Methodology' },
    { name:'solve', description:'Systematic problem resolution — 오답노트 체계적 해결 사이클.', category:'Research' },
    { name:'db-query', description:'Database query execution — Neo4j, PostgreSQL, MongoDB, Redis.', category:'Operations' },
    { name:'server-status', description:'Server health check — Docker, DB, 스토리지, 네트워크.', category:'Operations' },
    { name:'docker-logs', description:'Container log inspection — 서비스 장애 원인 파악.', category:'Operations' },
    { name:'kafka-manage', description:'Kafka topic management — 토픽, 메시지, 클러스터 상태.', category:'Operations' },
    { name:'deploy', description:'Service deployment — 서비스 배포 자동화.', category:'Operations' },
    { name:'backup', description:'Backup management — 백업 생성, 복원, 스케줄링.', category:'Operations' },
    { name:'skill-creator', description:'Skill creation wizard — SKILL.md 파일 작성.', category:'Operations' },
  ];
  return skills.map(s => ({ params: { name: s.name }, props: { skill: s, allSkills: skills } }));
}

const skillData = Astro.props.allSkills || [];

const { name } = Astro.params;
const { skill } = Astro.props;

// SKILL.md 파일에서 실제 내용 읽기
let skillDetail: any = null;
try { skillDetail = await getSkillDetail(name!); } catch {}

const catColor: Record<string, string> = {
  Methodology: '#a78bfa', Verification: '#f472b6', Research: '#67e8f9', Operations: '#fbbf24',
};
const color = catColor[skill.category] || '#a78bfa';

// frontmatter에서 버전 추출
const version = skillDetail?.frontmatter?.version || '';
---

<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>/{skill.name} — MetaHumotonic Skills</title>
  <meta name="description" content={skill.description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": `/${skill.name}`,
    "description": skill.description,
    "applicationCategory": skill.category,
    "url": `https://metahumotonic.com/skills/${name}`
  })} />
</head>

<body>
  <div class="starfield-bg" aria-hidden="true"></div>
  <div class="vignette" aria-hidden="true"></div>

  <div class="page-wrap">
    <nav class="breadcrumb">
      <a href="/">MetaHumotonic</a> <span>›</span> <a href="/#skills">Skills</a> <span>›</span> <span>/{skill.name}</span>
    </nav>

    <header class="skill-header fade-in">
      <span class="cat-badge" style={`color:${color}; border-color:${color}`}>{skill.category}</span>
      <h1><code style={`color:${color}`}>/{skill.name}</code></h1>
      {version && <span class="version">v{version}</span>}
      <p class="skill-desc">{skill.description}</p>
    </header>

    {/* Usage */}
    <section class="section fade-in">
      <h2>사용법</h2>
      <div class="code-block">
        <code>/{skill.name}</code>
      </div>
      <p class="usage-note">Claude Code CLI 또는 연결된 에이전트에서 호출합니다.</p>
    </section>

    {/* SKILL.md 상세 — 섹션별 렌더링 */}
    {skillDetail?.sections && skillDetail.sections.length > 0 && (
      <section class="section fade-in">
        <h2>상세 설명</h2>
        {skillDetail.sections.map((sec: any) => (
          <div class="skill-section">
            <h3>{sec.title}</h3>
            <pre class="skill-content">{sec.content.slice(0, 800)}</pre>
          </div>
        ))}
      </section>
    )}

    {/* Frontmatter 메타 */}
    {skillDetail?.frontmatter && Object.keys(skillDetail.frontmatter).length > 0 && (
      <section class="section fade-in">
        <h2>메타데이터</h2>
        <div class="meta-grid">
          {Object.entries(skillDetail.frontmatter).map(([k, v]) => (
            <div class="meta-item">
              <span class="meta-key">{k}</span>
              <span class="meta-val">{String(v)}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    {/* 같은 카테고리의 다른 스킬 */}
    <section class="section fade-in">
      <h2>같은 카테고리</h2>
      <div class="related-skills">
        {skillData.filter(s => s.category === skill.category && s.name !== skill.name).map(s => (
          <a href={`/skills/${s.name}`} class="related-link">
            <code>/{s.name}</code>
          </a>
        ))}
      </div>
    </section>

    <footer class="page-footer">
      <a href="/" class="back-link">← Home</a>
      <a href="/#skills" class="back-link">All Skills →</a>
    </footer>
  </div>
</body>
</html>

<style is:global>
  *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  body { font-family:'Inter',system-ui,sans-serif; background:#050810; color:#e0e6f0; line-height:1.6; overflow-x:hidden; }
  a { color:inherit; text-decoration:none; }
  .page-wrap { position:relative; z-index:1; max-width:900px; margin:0 auto; padding:0 clamp(1rem,3vw,3rem); }

  .breadcrumb { padding:1.5rem 0; font-size:0.85rem; color:#4a5578; }
  .breadcrumb a { color:#67e8f9; }
  .breadcrumb a:hover { text-decoration:underline; }
  .breadcrumb span { margin:0 0.3rem; }

  .skill-header { text-align:center; padding:2rem 0 3rem; }
  .cat-badge { display:inline-block; font-size:0.75rem; font-weight:600; text-transform:uppercase; letter-spacing:0.1em; border:1px solid; border-radius:20px; padding:0.2rem 0.8rem; margin-bottom:1rem; }
  .skill-header h1 { font-size:clamp(2rem,5vw,3.5rem); font-weight:800; margin-bottom:0.5rem; }
  .skill-header h1 code { font-family:'JetBrains Mono','Fira Code',monospace; }
  .version { font-size:0.85rem; color:#4a5578; font-weight:500; }
  .skill-desc { font-size:1.1rem; color:#8892b0; max-width:560px; margin:1rem auto 0; }

  .section { padding:2rem 0; }
  .section h2 { font-size:1.3rem; font-weight:700; color:#fff; margin-bottom:1.5rem; }

  .code-block { display:inline-block; background:rgba(13,27,42,0.6); border:1px solid rgba(107,76,153,0.15); border-radius:12px; padding:1rem 2rem; backdrop-filter:blur(8px); font-family:'JetBrains Mono',monospace; font-size:1.2rem; color:#67e8f9; }
  .usage-note { margin-top:1rem; font-size:0.85rem; color:#4a5578; text-align:center; }

  .skill-section { margin-bottom:1.5rem; }
  .skill-section h3 { font-size:1.05rem; color:#a78bfa; font-weight:600; margin-bottom:0.5rem; }
  .skill-content { font-family:'JetBrains Mono',monospace; font-size:0.8rem; color:#8892b0; background:rgba(13,27,42,0.4); border:1px solid rgba(107,76,153,0.1); border-radius:8px; padding:1rem; overflow-x:auto; white-space:pre-wrap; word-break:break-word; line-height:1.5; }

  .meta-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:0.75rem; }
  .meta-item { background:rgba(13,27,42,0.6); border:1px solid rgba(107,76,153,0.15); border-radius:10px; padding:0.6rem 1rem; backdrop-filter:blur(8px); }
  .meta-key { display:block; font-size:0.7rem; color:#4a5578; text-transform:uppercase; letter-spacing:0.08em; font-weight:600; }
  .meta-val { font-size:0.9rem; color:#fff; word-break:break-all; }

  .related-skills { display:flex; flex-wrap:wrap; gap:0.5rem; }
  .related-link { display:inline-block; background:rgba(13,27,42,0.6); border:1px solid rgba(107,76,153,0.15); border-radius:8px; padding:0.4rem 0.8rem; backdrop-filter:blur(8px); transition:border-color 0.3s; }
  .related-link:hover { border-color:rgba(167,139,250,0.3); }
  .related-link code { font-size:0.85rem; color:#67e8f9; }

  .page-footer { display:flex; justify-content:space-between; padding:3rem 0; }
  .back-link { color:#67e8f9; font-size:0.9rem; font-weight:500; }
  .back-link:hover { text-decoration:underline; }

  .fade-in { opacity:0; transform:translateY(20px); transition:opacity 0.6s ease,transform 0.6s ease; }
  .fade-in.visible { opacity:1; transform:none; }
</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
  }, { threshold: 0, rootMargin: '0px 0px 50px 0px' });
  document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));
  setTimeout(() => document.querySelectorAll('.fade-in:not(.visible)').forEach(el => el.classList.add('visible')), 1500);
</script>
