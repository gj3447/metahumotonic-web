---
import WorkbenchLayout from '../../layouts/WorkbenchLayout.astro';
import { directoryEdition, directoryJsonLd, directoryProjects, internalSystems, publicDirectoryServices } from '../../lib/service-directory';
import '../../styles/services.css';

const allServices = publicDirectoryServices();
const experience = allServices.filter(service => service.group === 'experience');
const knowledge = allServices.filter(service => service.group === 'knowledge');
const developer = allServices.filter(service => service.group === 'developer');
const projects = directoryProjects();
const isExternal = (href: string) => href.startsWith('https://');
---
<WorkbenchLayout title="서비스 — MetaHumotonic" description="제품과 연구, 철학과 자료, 공개 코드와 개발자 문서까지. 메타휴모토닉의 검토된 공개 접근 경로를 한곳에서 찾으세요." path="/services/" structuredData={directoryJsonLd()}>
  <main id="main-content" class="service-directory">
    <header class="service-hero shell">
      <div class="service-hero-copy">
        <nav class="breadcrumb" aria-label="현재 위치"><a href="/">홈</a><span aria-hidden="true">/</span><span aria-current="page">서비스</span></nav>
        <p class="eyebrow">THE METAHUMOTONIC NETWORK</p>
        <h1>하나의 입구에서,<br /><span>각자의 세계로.</span></h1>
        <p class="service-hero-lead">메타휴모토닉의 제품과 연구, 생각과 도구를 연결합니다. 관심 있는 곳에서 시작해 보세요.</p>
        <div class="service-hero-actions"><a class="button button-primary" href="#open-services">서비스 바로가기 <span aria-hidden="true">↓</span></a><a class="text-link" href="#project-directory">프로젝트 둘러보기 <span aria-hidden="true">↗</span></a></div>
        <p class="service-freshness">공개 링크 확인 · <time datetime={directoryEdition}>{directoryEdition.replaceAll('-', '.')}</time> <span aria-hidden="true">·</span> 서비스의 운영 상태는 각 페이지에서 확인하세요.</p>
      </div>
      <div class="service-map" aria-hidden="true">
        <div class="service-map-grid"></div>
        <svg class="service-map-lines" viewBox="0 0 500 420" preserveAspectRatio="none"><path d="M250 210 L104 97 M250 210 L395 95 M250 210 L95 320 M250 210 L400 326" /></svg>
        <div class="service-map-core"><span>MH</span><small>METAHUMOTONIC</small></div>
        <div class="service-map-node service-map-node--a"><span>01</span><strong>PRODUCTS</strong><small>제품과 경험</small></div>
        <div class="service-map-node service-map-node--b"><span>02</span><strong>IDEAS</strong><small>철학과 지식</small></div>
        <div class="service-map-node service-map-node--c"><span>03</span><strong>CODE</strong><small>공개 기술</small></div>
        <div class="service-map-node service-map-node--d"><span>04</span><strong>PLATFORM</strong><small>사내 운영</small></div>
      </div>
    </header>

    <nav class="service-index shell" aria-label="서비스 분야"><a href="#open-services"><span>01</span> 바로가기 <span aria-hidden="true">↘</span></a><a href="#project-directory"><span>02</span> 프로젝트 <span aria-hidden="true">↘</span></a><a href="#knowledge-services"><span>03</span> 지식과 자료 <span aria-hidden="true">↘</span></a><a href="#developer-services"><span>04</span> 코드와 도구 <span aria-hidden="true">↘</span></a></nav>

    <section id="open-services" class="service-section service-section--featured shell" aria-labelledby="open-services-title">
      <div class="section-heading"><div><p class="eyebrow">PUBLIC EXPERIENCES</p><h2 id="open-services-title">지금 열어볼 수 있는 곳.</h2></div><p>공개 경로가 확인된 경험입니다.<br />각 프로젝트의 구현 범위는 해당 페이지를 참고하세요.</p></div>
      <div class="service-feature-grid">{experience.map((service, index) => <article class={`service-feature service-feature--${index}`}>
        <div class="service-feature-top"><span class="mini-label">{service.label}</span><span aria-hidden="true">{service.mark}</span></div>
        <div class="service-feature-body"><h3>{service.name}</h3><p>{service.description}</p><a href={service.href} target={isExternal(service.href) ? '_blank' : undefined} rel={isExternal(service.href) ? 'noopener noreferrer' : undefined} aria-label={`${service.name} ${service.id === '333' ? '알파 범위 보기' : '사이트 열기'}${isExternal(service.href) ? ' (새 창)' : ''}`}>{service.id === '333' ? '알파 범위 보기' : '사이트 열기'} <span aria-hidden="true">↗</span></a></div>
        <div class="service-feature-art" aria-hidden="true"><i></i><i></i><i></i></div>
      </article>)}</div>
    </section>

    <section id="project-directory" class="service-projects" aria-labelledby="service-projects-title"><div class="shell">
      <div class="section-heading"><div><p class="eyebrow">PRODUCTS, GAMES & RESEARCH</p><h2 id="service-projects-title">만들고 있는 모든 방향.</h2></div><a class="text-link" href="/projects/">프로젝트 전체 보기 <span aria-hidden="true">↗</span></a></div>
      <p class="service-section-intro">소개 페이지는 각 작업의 목표와 범위를 설명합니다. 실제 실행 경로가 확인된 작업만 별도 링크를 표시합니다.</p>
      <div class="service-project-grid">{projects.map((project, index) => <article class="service-project" data-service-project={project.id}>
        <div class="service-project-meta"><span>{String(index + 1).padStart(2, '0')} / {project.category.toUpperCase()}</span><span>{project.status}</span></div>
        <span class:list={['service-availability', { 'service-availability--live': project.liveHref }]}>{project.id === 'soopoolim' ? '공개 사이트' : project.id === '333' ? '알파 체험' : '소개 페이지'}</span>
        <div class="service-project-title"><span aria-hidden="true">{project.symbol}</span><h3><a href={project.href}>{project.name}</a></h3></div>
        <p>{project.summary}</p>
        <div class="service-project-actions"><a href={project.href}>소개 보기 <span aria-hidden="true">↗</span></a>{project.liveHref && <a href={project.liveHref} target={isExternal(project.liveHref) ? '_blank' : undefined} rel={isExternal(project.liveHref) ? 'noopener noreferrer' : undefined}>{project.liveLabel} <span aria-hidden="true">↗</span>{isExternal(project.liveHref) && <span class="sr-only">새 창</span>}</a>}</div>
      </article>)}</div>
    </div></section>

    <section id="knowledge-services" class="service-section shell" aria-labelledby="knowledge-services-title"><div class="section-heading"><div><p class="eyebrow">IDEAS & KNOWLEDGE</p><h2 id="knowledge-services-title">읽고, 이해하고, 연결하기.</h2></div><p>원문과 편집 소개를 구분하며<br />관심사에 맞는 출발점을 고르세요.</p></div>
      <div class="service-link-grid">{knowledge.map(service => <a class="service-link-card" href={service.href}><span class="service-link-mark" aria-hidden="true">{service.mark}</span><span class="service-link-content"><span class="mini-label">{service.label}</span><strong>{service.name}</strong><span>{service.description}</span></span><span class="service-link-arrow" aria-hidden="true">↗</span></a>)}</div>
    </section>

    <section id="developer-services" class="service-developer" aria-labelledby="developer-services-title"><div class="shell service-developer-layout"><div class="service-developer-heading"><p class="eyebrow">OPEN CODE & INTERFACES</p><h2 id="developer-services-title">생각을 넘어,<br />구현을 살펴보기.</h2><p>공개 코드와 영상, API와 MCP 안내로 이어집니다. MCP 서버 등록·가동 상태는 발견 문서에서 확인하세요.</p></div><div class="service-developer-list">{developer.map(service => <a href={service.href} target={isExternal(service.href) ? '_blank' : undefined} rel={isExternal(service.href) ? 'noopener noreferrer' : undefined}><span class="service-developer-mark" aria-hidden="true">{service.mark}</span><span><small>{service.label}</small><strong>{service.name}</strong><em>{service.description}</em></span><span aria-hidden="true">↗</span>{isExternal(service.href) && <span class="sr-only">새 창</span>}</a>)}<a class="service-data-link" href="/learn/graph.jsonld"><span class="service-developer-mark" aria-hidden="true">↗</span><span><small>SEMANTIC WEB</small><strong>공개 학습 그래프</strong><em>JSON-LD와 USL로 철학·프로젝트의 관계 읽기</em></span><span aria-hidden="true">↗</span></a></div></div></section>

    <section class="service-internal shell" aria-labelledby="internal-services-title"><div class="section-heading"><div><p class="eyebrow">INTERNAL PLATFORM</p><h2 id="internal-services-title">서비스를 받치는 시스템.</h2></div><p>사내 인증 영역의 역할을 공개 범위에서 소개합니다.<br />관리 화면과 데이터에 접근하려면 별도 권한이 필요합니다.</p></div><div class="service-internal-list">{internalSystems.map(system => <article><span class="service-internal-dot" aria-hidden="true"></span><div><h3>{system.name}</h3><p>{system.role}</p></div><span>{system.note}</span></article>)}</div></section>

    <section class="service-machine shell" aria-labelledby="machine-title"><div><p class="eyebrow">CONNECTED BY MEANING</p><h2 id="machine-title">이 지도를 데이터로도.</h2><p>화면과 데이터는 같은 검토된 공개 목록을 사용합니다. 연결은 탐색 안내이며 서비스의 실시간 건강 상태나 접근 권한을 뜻하지 않습니다.</p></div><div class="service-machine-links"><a href="/#semantic-simulation">의미 그래프 시뮬레이션 <span aria-hidden="true">↗</span></a><a href="/services/data.json">공개 목록 JSON <span aria-hidden="true">↗</span></a><a href="/services/graph.jsonld">JSON-LD 그래프 <span aria-hidden="true">↗</span></a><a href="/services/usl.json">USL 연결 <span aria-hidden="true">↗</span></a></div></section>
  </main>
</WorkbenchLayout>
