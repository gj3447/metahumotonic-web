---
import WorkbenchLayout from '../../layouts/WorkbenchLayout.astro';
import SemanticLinks from '../../components/SemanticLinks.astro';
import { apostles, pageGraph } from '../../lib/public-content';
import '../../styles/ideas.css';
export const getStaticPaths = () => apostles.map((apostle, index) => ({ params: { slug: apostle.slug }, props: { apostle, next: apostles[(index + 1) % apostles.length] } }));
const { apostle, next } = Astro.props;
---
<WorkbenchLayout title={`${apostle.name} — 사도 — MetaHumotonic`} description={apostle.summary} path={apostle.href} structuredData={pageGraph(apostle.href, apostle.name, [apostle.nodeId])}>
  <main id="main-content" class="ideas-main shell">
    <nav class="breadcrumb" aria-label="현재 위치"><a href="/">홈</a><span>/</span><a href="/apostles/">사도</a><span>/</span><span aria-current="page">{apostle.name}</span></nav>
    <header class="apostle-detail-hero"><div><p class="eyebrow">APOSTLE {apostle.numeral} / METAHUMOTONIC</p><h1>{apostle.name}</h1><p class="apostle-epithet">{apostle.epithet}</p><p>{apostle.summary}</p></div><div class="apostle-art" aria-hidden="true"><span class="apostle-orbit"></span><span class="apostle-glyph">{apostle.icon}</span><span class="apostle-number">{apostle.numeral}</span></div></header>
    <div class="ideas-reading-grid"><article class="original-reading"><p class="eyebrow">FROM THE PUBLIC RECORD</p><h2>이름에 담긴 이야기.</h2><blockquote>{apostle.body}</blockquote><p class="source-caption">기존 공개 정전 미러의 본문입니다. 세계관의 서술을 기술의 성능이나 과학적 입증으로 읽지는 않습니다.</p>{apostle.number === 9 && <p class="source-caption">여기는 기존 공개판의 ‘예수’ 항목입니다. 다른 자료에서 쓰는 아텐의 이름과 같은 존재로 합치지 않습니다.</p>}<a class="text-link" href={apostle.sourceHref}>위키의 본질·역할·출처 읽기 ↗</a></article><SemanticLinks nodeId={apostle.nodeId} /></div>
    <p><a class="text-link" href="/apostles/graph.jsonld">사도·문서·출처의 연결 데이터 ↗</a></p>
    <nav class="next-reading" aria-label="다음 사도"><a href="/apostles/">모든 사도 ←</a><a href={next.href}>다음 이야기 · {next.name} →</a></nav>
  </main>
</WorkbenchLayout>
