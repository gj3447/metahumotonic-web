---
// KG: ATOM_Web_ApostleDetail
// KG: SPAN_MH_Web_v3_Root, sa-metahumotonic-web-v3-apostle-centric-2026-05-22
// KG: rs-mh-web-v3-src-pages-apostles-_slug__astro-2026-05-22 (forward L5 binding)
// 12사도 개별 상세 페이지. data/apostles.json 정전 (KG 미러).
import apostlesData from '../../data/apostles.json';
import FamilyBadge from '../../components/FamilyBadge.astro';            // KG: CONTRACT_FamilyBadge_v1
import KGAnchorBox from '../../components/KGAnchorBox.astro';            // KG: CONTRACT_KGAnchorBox_v1
import CanonFieldSurface from '../../components/CanonFieldSurface.astro'; // KG: CONTRACT_CanonFieldSurface_v1

export async function getStaticPaths() {
  return apostlesData.apostles.map((a, i) => ({
    params: { slug: a.slug },
    props: {
      apostle: a,
      prev: apostlesData.apostles[(i - 1 + apostlesData.apostles.length) % apostlesData.apostles.length],
      next: apostlesData.apostles[(i + 1) % apostlesData.apostles.length],
    },
  }));
}

const { apostle, prev, next } = Astro.props;
const isOpen = apostle.status?.startsWith('OPEN');
---

<html lang="ko" prefix="foaf: http://xmlns.com/foaf/0.1/ schema: https://schema.org/">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{apostle.num}. {apostle.name} — MetaHumotonic</title>
  <meta name="description" content={`${apostle.name}: ${apostle.epithet}. ${apostle.essence.slice(0, 120)}`} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": {
      "@vocab": "https://schema.org/",
      "mh": "https://metahumotonic.com/ontology#"
    },
    "@graph": [
      {
        "@type": "Person",
        "additionalType": ["mh:Apostle", "FictionalCharacter"],
        "@id": `https://metahumotonic.com/apostles/${apostle.slug}#person`,
        "name": apostle.name,
        "alternateName": apostle.epithet,
        "description": apostle.essence,
        "url": `https://metahumotonic.com/apostles/${apostle.slug}`,
        "knowsAbout": [
          apostle.external_referent,
          ...(apostle.crystallizations || []).map((c: any) => c.title + ': ' + c.body),
          ...(apostle.hyperedges || [])
        ].filter(Boolean),
        "subjectOf": (apostle.crystallizations || []).map((c: any) => ({
          "@type": "CreativeWork",
          "name": c.title,
          "abstract": c.body
        })),
        "memberOf": {
          "@id": "https://metahumotonic.com/ontology#Apostle",
          "name": "MetaHumotonic 12 사도",
          "@type": "Organization"
        },
        "affiliation": {
          "@id": "https://metahumotonic.com/#org",
          "name": "MetaHumotonic",
          "@type": "Organization"
        },
        "mh:role": apostle.role,
        "mh:familyEngineering": apostle.family,
        "mh:externalReferent": apostle.external_referent
      }
    ]
  })} />
  <style>
    /* 개발자 스타일 전환 2026-05-22 — 사용자 verdict 'monospace + 정보 밀도' */
    *,*:before,*:after { margin:0; padding:0; box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body {
      font-family: 'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace;
      background: #faf6ec;
      color: #1a1815;
      line-height: 1.55;
      font-size: 14px;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; }

    .wrap { max-width: 760px; margin: 0 auto; padding: clamp(1rem, 3vw, 2rem) clamp(0.8rem, 3vw, 1.6rem) 4rem; }

    .crumb {
      font-size: 11px;
      letter-spacing: 0.05em;
      color: #8a8273;
      text-transform: uppercase;
      margin-bottom: 1.4rem;
      border-bottom: 1px dotted #d9ceb0;
      padding-bottom: 0.6rem;
    }
    .crumb a { color: #8a8273; text-decoration: none; border-bottom: 1px solid transparent; transition: border-color 0.2s; }
    .crumb a:hover { border-color: currentColor; }
    .crumb-sep { margin: 0 0.4rem; opacity: 0.5; }

    /* Header — tight monospace */
    header {
      display: grid;
      grid-template-columns: 60px 1fr;
      gap: 8px 14px;
      align-items: baseline;
      padding-bottom: 0.8rem;
      border-bottom: 1px solid #d9ceb0;
      margin-bottom: 1.2rem;
    }
    .num {
      grid-row: 1 / 3;
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 28px;
      line-height: 1;
      color: #c0b48f;
      font-weight: 500;
      text-align: right;
      padding-top: 4px;
    }
    .icon {
      display: inline-block;
      font-size: 14px;
      margin-left: 4px;
      opacity: 0.55;
    }
    h1 {
      font-size: 22px;
      font-weight: 600;
      line-height: 1.2;
      letter-spacing: 0;
      color: #1a1815;
    }
    .epithet {
      grid-column: 2;
      font-size: 12px;
      color: #6b6357;
      margin-top: 2px;
    }
    .open-tag {
      display: inline-block;
      margin-left: 0.6rem;
      padding: 1px 6px;
      font-size: 10px;
      letter-spacing: 0.08em;
      color: #8a4d00;
      background: #fce7c4;
      border-radius: 2px;
      vertical-align: middle;
      text-transform: uppercase;
    }

    hr { border: 0; height: 1px; background: #d9ceb0; margin: 1.4rem 0; }

    /* Body — 자연체 prose는 짧게 */
    .body-ko {
      font-size: 13.5px;
      line-height: 1.6;
      color: #2a2620;
      margin: 1rem 0 0.6rem;
      padding-left: 12px;
      border-left: 2px solid #d9ceb0;
    }
    .body-en {
      font-size: 12px;
      color: #6b6357;
      line-height: 1.55;
      padding-left: 12px;
      border-left: 2px solid #d9ceb0;
      opacity: 0.85;
    }

    /* Canonical cards — tight monospace dl */
    .canon-grid {
      display: grid;
      grid-template-columns: 110px 1fr;
      gap: 4px 14px;
      align-items: baseline;
      margin: 1.2rem 0;
      font-size: 12px;
    }
    .canon-label {
      font-size: 10.5px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #8a8273;
      white-space: nowrap;
    }
    .canon-val { font-size: 12px; color: #2a2620; line-height: 1.5; }
    .canon-val.essence { color: #4a4338; }
    .canon-val.referent { font-size: 11.5px; color: #2a2620; }
    .canon-val.family { font-size: 11.5px; color: #6b6357; }
    .canon-val.path { font-size: 11px; color: #8a8273; word-break: break-all; }

    /* Pager — tight */
    .pager {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      margin-top: 2.4rem;
      padding-top: 0.8rem;
      border-top: 1px solid #d9ceb0;
      font-size: 12px;
    }
    .pager a {
      flex: 1;
      text-decoration: none;
      color: #4a4338;
      padding: 0.4rem 0;
      transition: color 0.2s;
    }
    .pager a:hover { color: #1a1815; }
    .pager .dir {
      display: block;
      font-size: 10px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #8a8273;
      margin-bottom: 2px;
    }
    .pager .label { font-size: 12.5px; }
    .pager .next { text-align: right; }

    .back-home {
      display: inline-block;
      margin-top: 3rem;
      font-size: 0.85rem;
      color: #6b6357;
      text-decoration: none;
      border-bottom: 1px dotted #b8a98a;
    }
    .back-home:hover { color: #1a1815; }

    /* Crystallizations 섹션 — KG 결정화 발췌 */
    .crystallizations {
      margin: 2.4rem 0;
      padding: 1.4rem 1.6rem;
      border: 1px solid #d9ceb0;
      border-left: 3px solid #6366f1;
      background: rgba(99, 102, 241, 0.04);
    }
    .crystallizations__head {
      display: flex;
      align-items: baseline;
      gap: 0.6rem;
      margin-bottom: 1rem;
    }
    .crystallizations__eyebrow {
      font-size: 0.72rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #4338ca;
      font-weight: 500;
    }
    .crystallizations__count {
      font-family: 'Cormorant Garamond', 'Times New Roman', serif;
      font-style: italic;
      font-size: 1.2rem;
      color: #4338ca;
    }
    .crystallizations__list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 1.2rem;
    }
    .crystallizations__item {
      border-top: 1px dotted #c7d2fe;
      padding-top: 0.9rem;
    }
    .crystallizations__item:first-child { border-top: 0; padding-top: 0; }
    .crystallizations__title {
      font-family: 'Cormorant Garamond', 'Times New Roman', serif;
      font-size: 1.1rem;
      font-weight: 500;
      color: #1e1b4b;
      margin: 0 0 0.4rem;
      letter-spacing: -0.005em;
    }
    .crystallizations__body {
      font-size: 0.88rem;
      color: #2a2620;
      line-height: 1.65;
      margin: 0;
    }

    /* Hyperedges 섹션 */
    .hyperedges {
      margin: 2rem 0;
      padding: 1.1rem 1.4rem;
      border: 1px solid #d9ceb0;
      border-left: 3px solid #10b981;
      background: rgba(16, 185, 129, 0.04);
    }
    .hyperedges__head {
      display: flex;
      align-items: baseline;
      gap: 0.6rem;
      margin-bottom: 0.7rem;
    }
    .hyperedges__eyebrow {
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #047857;
      font-weight: 500;
    }
    .hyperedges__count {
      font-family: 'Cormorant Garamond', 'Times New Roman', serif;
      font-style: italic;
      font-size: 1.1rem;
      color: #047857;
    }
    .hyperedges__list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 0.5rem;
    }
    .hyperedges__item {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 0.78rem;
      color: #064e3b;
      padding: 0.35rem 0.55rem;
      background: rgba(16, 185, 129, 0.08);
      border-radius: 2px;
      line-height: 1.5;
    }

    /* Lessons 섹션 */
    .lessons {
      margin: 1.4rem 0;
      padding: 0.9rem 1.1rem;
      border: 1px solid #d9ceb0;
      border-left: 3px solid #8a4d00;
      background: rgba(252, 231, 196, 0.12);
    }
    .lessons__head { display:flex; align-items:baseline; gap:0.5rem; margin-bottom:0.6rem; }
    .lessons__eyebrow { font-size:10.5px; letter-spacing:0.08em; text-transform:uppercase; color:#8a4d00; }
    .lessons__count { font-size:13px; color:#8a4d00; }
    .lessons__list { list-style:none; padding:0; margin:0; display:grid; gap:0.6rem; }
    .lessons__item { border-top:1px dotted #e5d3a8; padding-top:0.5rem; }
    .lessons__item:first-child { border-top:0; padding-top:0; }
    .lessons__title { display:block; font-size:12px; color:#5a3a00; margin-bottom:2px; }
    .lessons__body { font-size:11.5px; color:#3a2d10; line-height:1.5; margin:0; }

    /* Open Questions 섹션 */
    .open-questions {
      margin: 1.4rem 0;
      padding: 0.9rem 1.1rem;
      border: 1px solid #d9ceb0;
      border-left: 3px solid #ec4899;
      background: rgba(252, 231, 243, 0.18);
    }
    .open-questions__head { display:flex; align-items:baseline; gap:0.5rem; margin-bottom:0.6rem; }
    .open-questions__eyebrow { font-size:10.5px; letter-spacing:0.08em; text-transform:uppercase; color:#9d174d; }
    .open-questions__count { font-size:13px; color:#9d174d; }
    .open-questions__list { list-style:none; padding:0; margin:0; display:grid; gap:0.6rem; }
    .open-questions__item { border-top:1px dotted #f9a8d4; padding-top:0.5rem; }
    .open-questions__item:first-child { border-top:0; padding-top:0; }
    .open-questions__title { display:block; font-size:12px; color:#831843; margin-bottom:2px; }
    .open-questions__body { font-size:11.5px; color:#500724; line-height:1.5; margin:0; }

    /* Axis Proposals 섹션 */
    .axis-proposals {
      margin: 1.4rem 0;
      padding: 0.8rem 1.1rem;
      border: 1px solid #d9ceb0;
      border-left: 3px solid #06b6d4;
      background: rgba(207, 250, 254, 0.18);
    }
    .axis-proposals__head { display:flex; align-items:baseline; gap:0.5rem; margin-bottom:0.5rem; }
    .axis-proposals__eyebrow { font-size:10.5px; letter-spacing:0.08em; text-transform:uppercase; color:#0e7490; }
    .axis-proposals__count { font-size:13px; color:#0e7490; }
    .axis-proposals__list { list-style:none; padding:0; margin:0; display:grid; gap:0.3rem; }
    .axis-proposals__item { font-size:11.5px; color:#155e75; padding:0.25rem 0.5rem; background:rgba(6,182,212,0.08); border-radius:2px; line-height:1.5; }

    /* Legion Commanders 섹션 */
    .legion-commanders {
      margin: 2rem 0;
      padding: 1.2rem 1.4rem;
      border: 1px solid #d9ceb0;
      border-left: 3px solid #8a4d00;
      background: rgba(252, 231, 196, 0.18);
    }
    .legion-commanders__head {
      display: flex;
      align-items: baseline;
      gap: 0.6rem;
      margin-bottom: 0.8rem;
    }
    .legion-commanders__eyebrow {
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #8a4d00;
      font-weight: 500;
    }
    .legion-commanders__count {
      font-family: 'Cormorant Garamond', 'Times New Roman', serif;
      font-style: italic;
      font-size: 1.1rem;
      color: #8a4d00;
    }
    .legion-commanders__list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 0.6rem;
    }
    .legion-commanders__item {
      display: grid;
      grid-template-columns: max-content 1fr;
      gap: 0.6rem 1rem;
      align-items: baseline;
      font-size: 0.85rem;
    }
    .legion-commanders__name {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 0.82rem;
      color: #2a2620;
      background: rgba(192, 180, 143, 0.25);
      padding: 0.1rem 0.45rem;
      border-radius: 2px;
    }
    .legion-commanders__note {
      color: #4a4338;
      line-height: 1.5;
      font-size: 0.78rem;
    }
    @media (max-width: 540px) {
      .legion-commanders__item { grid-template-columns: 1fr; }
    }

    /* Wave 6: ExternalReferentCard — KG: CONTRACT_ExternalReferentCard_v1 */
    .ext-referent-card {
      margin: 2.4rem 0 1.2rem;
      padding: 1.4rem 1.6rem;
      border: 1px solid #d9ceb0;
      background: #f8f3e6;
      border-radius: 2px;
      position: relative;
    }
    .ext-referent-card__head {
      display: flex;
      align-items: center;
      margin-bottom: 0.6rem;
    }
    .ext-referent-card__eyebrow {
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #8a4d00;
      font-weight: 500;
    }
    .ext-referent-card__prose {
      font-family: 'JetBrains Mono', ui-monospace, monospace;
      font-size: 0.85rem;
      line-height: 1.65;
      color: #2a2620;
      margin: 0;
      word-break: break-word;
    }
    .family-badge { margin-top: 0.8rem; }

    @media (max-width: 540px) {
      .canon-grid { grid-template-columns: 1fr; gap: 0.2rem 0; }
      .canon-label { padding-top: 0.8rem; }
      .pager { flex-direction: column; gap: 1rem; }
      .pager .next { text-align: left; }
    }
  </style>
</head>
<body>
  <main class="wrap">
    <nav class="crumb">
      <a href="/">metahumotonic</a>
      <span class="crumb-sep">›</span>
      <a href="/apostles/">사도</a>
      <span class="crumb-sep">›</span>
      <span>{apostle.name}</span>
    </nav>

    <header>
      <div class="num">{apostle.num}.<span class="icon" aria-hidden="true">{apostle.icon}</span></div>
      <h1>
        {apostle.name}
        {isOpen && <span class="open-tag">사용자 verdict 대기</span>}
      </h1>
      <p class="epithet">{apostle.epithet}</p>
      {apostle.family && <FamilyBadge family={apostle.family} apostleId={apostle.id} />}
    </header>

    <hr />

    <p class="body-ko">{apostle.body_ko}</p>
    <p class="body-en">{apostle.body_en}</p>

    {/* Wave 4: CanonFieldSurface — KG 정전 4 필드 conditional callout */}
    <CanonFieldSurface
      canonical_meaning={apostle.canonical_meaning}
      mythology_referent_v2={apostle.mythology_referent_v2}
      role={apostle.role}
      essence_v4={apostle.essence_v4}
    />

    <hr />

    <dl class="canon-grid">
      <dt class="canon-label">본질</dt>
      <dd class="canon-val essence">{apostle.essence}</dd>

      <dt class="canon-label">공학 family</dt>
      <dd class="canon-val family">{apostle.family}</dd>

      <dt class="canon-label">사용자 정전 경로</dt>
      <dd class="canon-val path">{apostle.mind_path}</dd>

      <dt class="canon-label">이해 상태</dt>
      <dd class="canon-val">{apostle.status}</dd>
    </dl>

    {/* Wave 6: ExternalReferentCard — referent 표시를 card 형태로 시각 보강 */}
    <section class="ext-referent-card" aria-label="외부 정전 referent">
      <header class="ext-referent-card__head">
        <span class="ext-referent-card__eyebrow">외부 정전 · External Canonical Referent</span>
      </header>
      <p class="ext-referent-card__prose">{apostle.external_referent}</p>
    </section>

    {/* KG Crystallizations — 사도별 풍부 본문 발췌 */}
    {apostle.crystallizations && apostle.crystallizations.length > 0 && (
      <section class="crystallizations" aria-label="Crystallizations — KG 결정화 발췌">
        <header class="crystallizations__head">
          <span class="crystallizations__eyebrow">결정화 · Crystallizations</span>
          <span class="crystallizations__count">{apostle.crystallizations.length}</span>
        </header>
        <ol class="crystallizations__list">
          {apostle.crystallizations.map((c: any) => (
            <li class="crystallizations__item">
              <h3 class="crystallizations__title">{c.title}</h3>
              <p class="crystallizations__body">{c.body}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    {/* Cross-apostle Hyperedges — KG 측 관계 hyperedge */}
    {apostle.hyperedges && apostle.hyperedges.length > 0 && (
      <section class="hyperedges" aria-label="Hyperedges — cross-apostle 관계">
        <header class="hyperedges__head">
          <span class="hyperedges__eyebrow">관계 · Cross-Apostle Hyperedges</span>
          <span class="hyperedges__count">{apostle.hyperedges.length}</span>
        </header>
        <ul class="hyperedges__list">
          {apostle.hyperedges.map((h: string) => (
            <li class="hyperedges__item">{h}</li>
          ))}
        </ul>
      </section>
    )}

    {/* Lessons — KG :Lesson 본문 */}
    {apostle.lessons && apostle.lessons.length > 0 && (
      <section class="lessons" aria-label="Lessons — KG 결정화 교훈">
        <header class="lessons__head">
          <span class="lessons__eyebrow">교훈 · Lessons</span>
          <span class="lessons__count">{apostle.lessons.length}</span>
        </header>
        <ul class="lessons__list">
          {apostle.lessons.map((l: any) => (
            <li class="lessons__item">
              <strong class="lessons__title">{l.title}</strong>
              {l.body && <p class="lessons__body">{l.body}</p>}
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* Open Questions — KG :OpenQuestion */}
    {apostle.open_questions && apostle.open_questions.length > 0 && (
      <section class="open-questions" aria-label="Open Questions">
        <header class="open-questions__head">
          <span class="open-questions__eyebrow">열린 질문 · Open Questions</span>
          <span class="open-questions__count">{apostle.open_questions.length}</span>
        </header>
        <ul class="open-questions__list">
          {apostle.open_questions.map((o: any) => (
            <li class="open-questions__item">
              <strong class="open-questions__title">{o.title}</strong>
              {o.body && <p class="open-questions__body">{o.body}</p>}
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* Axis Proposals — KG :Canonical PROPOSES_AXIS_FOR_APOSTLE */}
    {apostle.axis_proposals && apostle.axis_proposals.length > 0 && (
      <section class="axis-proposals" aria-label="Axis Proposals — 학문 정전 axis 후보">
        <header class="axis-proposals__head">
          <span class="axis-proposals__eyebrow">축 후보 · Axis Proposals</span>
          <span class="axis-proposals__count">{apostle.axis_proposals.length}</span>
        </header>
        <ul class="axis-proposals__list">
          {apostle.axis_proposals.map((ax: string) => (
            <li class="axis-proposals__item">{ax}</li>
          ))}
        </ul>
      </section>
    )}

    {/* 군단장 (Legion Commanders) — 사도별 하위 commander cluster
        KG: omc-legioncommanders-2026-05-20, engineboy-canonical-2026-05-19,
            hitomi_la_sexvoid_substrate, pornhub_sexvoid_substrate */}
    {apostle.legion_commanders && apostle.legion_commanders.length > 0 && (
      <section class="legion-commanders" aria-label="군단장 — Legion Commanders">
        <header class="legion-commanders__head">
          <span class="legion-commanders__eyebrow">군단장 · Legion Commanders</span>
          <span class="legion-commanders__count">{apostle.legion_commanders.length}</span>
        </header>
        <ul class="legion-commanders__list">
          {apostle.legion_commanders.map((c: any) => (
            <li class="legion-commanders__item">
              <strong class="legion-commanders__name">{c.name}</strong>
              {c.note && <span class="legion-commanders__note">{c.note}</span>}
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* Wave 3: KGAnchorBox — apostle 측 ReferenceSite 7-tuple 노출 */}
    <KGAnchorBox apostleId={apostle.id} />

    <nav class="pager">
      <a href={`/apostles/${prev.slug}`} class="prev">
        <span class="dir">← {prev.num}</span>
        <span class="label">{prev.name}</span>
      </a>
      <a href={`/apostles/${next.slug}`} class="next">
        <span class="dir">{next.num} →</span>
        <span class="label">{next.name}</span>
      </a>
    </nav>

    <a href="/apostles/" class="back-home">← 12 사도 전체</a>
  </main>
</body>
</html>
