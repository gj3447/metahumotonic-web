---
// KG: ATOM_Web_ApostleDetail
// KG: SPAN_MH_Web_v3_Root, sa-metahumotonic-web-v3-apostle-centric-2026-05-22
// KG: rs-mh-web-v3-src-pages-apostles-_slug__astro-2026-05-22 (forward L5 binding)
// 12사도 개별 상세 페이지. data/apostles.json 정전 (KG 미러).
import apostlesData from '../../data/apostles.json';
import FamilyBadge from '../../components/FamilyBadge.astro';            // KG: CONTRACT_FamilyBadge_v1
import KGAnchorBox from '../../components/KGAnchorBox.astro';            // KG: CONTRACT_KGAnchorBox_v1
import CanonFieldSurface from '../../components/CanonFieldSurface.astro'; // KG: CONTRACT_CanonFieldSurface_v1

export async function getStaticPaths() {
  return apostlesData.apostles.map((a, i) => ({
    params: { slug: a.slug },
    props: {
      apostle: a,
      prev: apostlesData.apostles[(i - 1 + apostlesData.apostles.length) % apostlesData.apostles.length],
      next: apostlesData.apostles[(i + 1) % apostlesData.apostles.length],
    },
  }));
}

const { apostle, prev, next } = Astro.props;
const isOpen = apostle.status?.startsWith('OPEN');
---

<html lang="ko" prefix="foaf: http://xmlns.com/foaf/0.1/ schema: https://schema.org/">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{apostle.num}. {apostle.name} — MetaHumotonic</title>
  <meta name="description" content={`${apostle.name}: ${apostle.epithet}. ${apostle.essence.slice(0, 120)}`} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": {
      "@vocab": "https://schema.org/",
      "mh": "https://metahumotonic.com/ontology#"
    },
    "@graph": [
      {
        "@type": "Person",
        "additionalType": ["mh:Apostle", "FictionalCharacter"],
        "@id": `https://metahumotonic.com/apostles/${apostle.slug}#person`,
        "name": apostle.name,
        "alternateName": apostle.epithet,
        "description": apostle.essence,
        "url": `https://metahumotonic.com/apostles/${apostle.slug}`,
        "knowsAbout": [
          apostle.external_referent,
          ...(apostle.crystallizations || []).map((c: any) => c.title + ': ' + c.body),
          ...(apostle.hyperedges || [])
        ].filter(Boolean),
        "subjectOf": (apostle.crystallizations || []).map((c: any) => ({
          "@type": "CreativeWork",
          "name": c.title,
          "abstract": c.body
        })),
        "memberOf": {
          "@id": "https://metahumotonic.com/ontology#Apostle",
          "name": "MetaHumotonic 12 사도",
          "@type": "Organization"
        },
        "affiliation": {
          "@id": "https://metahumotonic.com/#org",
          "name": "MetaHumotonic",
          "@type": "Organization"
        },
        "mh:role": apostle.role,
        "mh:familyEngineering": apostle.family,
        "mh:externalReferent": apostle.external_referent
      }
    ]
  })} />
  <style>
    /* 개발자 스타일 datasheet — 사용자 verdict '아직도 여백 뒤지게 많다' */
    *,*:before,*:after { margin:0; padding:0; box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body {
      font-family: 'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace;
      background: #faf6ec;
      color: #1a1815;
      line-height: 1.45;
      font-size: 13px;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; }

    .wrap { max-width: 880px; margin: 0 auto; padding: 12px 14px 24px; }

    .crumb {
      font-size: 10.5px;
      letter-spacing: 0.05em;
      color: #8a8273;
      text-transform: uppercase;
      margin-bottom: 8px;
      padding-bottom: 4px;
      border-bottom: 1px dotted #d9ceb0;
    }
    .crumb a { color: #8a8273; text-decoration: none; }
    .crumb a:hover { color: #1a1815; }
    .crumb-sep { margin: 0 0.3rem; opacity: 0.5; }

    /* Header — 최소 여백 */
    header {
      display: grid;
      grid-template-columns: 40px 1fr;
      gap: 2px 10px;
      align-items: baseline;
      padding-bottom: 6px;
      border-bottom: 1px solid #d9ceb0;
      margin-bottom: 8px;
    }
    .num {
      grid-row: 1 / 3;
      font-size: 22px;
      line-height: 1;
      color: #c0b48f;
      font-weight: 500;
      text-align: right;
      padding-top: 3px;
    }
    .icon {
      display: inline-block;
      font-size: 12px;
      margin-left: 3px;
      opacity: 0.55;
    }
    h1 {
      font-size: 17px;
      font-weight: 600;
      line-height: 1.2;
      color: #1a1815;
    }
    .epithet {
      grid-column: 2;
      font-size: 11px;
      color: #6b6357;
    }
    .open-tag {
      display: inline-block;
      margin-left: 6px;
      padding: 0 5px;
      font-size: 9.5px;
      letter-spacing: 0.06em;
      color: #8a4d00;
      background: #fce7c4;
      border-radius: 2px;
      vertical-align: middle;
      text-transform: uppercase;
    }

    hr { border: 0; height: 1px; background: #d9ceb0; margin: 8px 0; }

    /* Body — inline tight */
    .body-ko {
      font-size: 12.5px;
      line-height: 1.5;
      color: #2a2620;
      margin: 6px 0 4px;
      padding-left: 8px;
      border-left: 2px solid #d9ceb0;
    }
    .body-en {
      font-size: 11px;
      color: #6b6357;
      line-height: 1.5;
      padding-left: 8px;
      border-left: 2px solid #d9ceb0;
      opacity: 0.85;
    }

    /* Canonical cards — datasheet dl */
    .canon-grid {
      display: grid;
      grid-template-columns: 100px 1fr;
      gap: 2px 12px;
      align-items: baseline;
      margin: 8px 0;
      font-size: 11.5px;
    }
    .canon-label {
      font-size: 10px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #8a8273;
      white-space: nowrap;
    }
    .canon-val { font-size: 11.5px; color: #2a2620; line-height: 1.45; }
    .canon-val.essence { color: #4a4338; }
    .canon-val.referent { font-size: 11px; color: #2a2620; }
    .canon-val.family { font-size: 11px; color: #6b6357; }
    .canon-val.path { font-size: 10.5px; color: #8a8273; word-break: break-all; }

    /* Pager — flat dense */
    .pager {
      display: flex;
      justify-content: space-between;
      gap: 8px;
      margin-top: 12px;
      padding-top: 6px;
      border-top: 1px solid #d9ceb0;
      font-size: 11px;
    }
    .pager a { flex:1; text-decoration:none; color:#4a4338; padding:2px 0; }
    .pager a:hover { color:#1a1815; }
    .pager .dir { display:block; font-size:9.5px; letter-spacing:0.06em; text-transform:uppercase; color:#8a8273; }
    .pager .label { font-size:11.5px; }
    .pager .next { text-align:right; }

    .back-home { display:inline-block; margin-top:10px; font-size:10.5px; color:#6b6357; text-decoration:none; border-bottom:1px dotted #b8a98a; }
    .back-home:hover { color:#1a1815; }

    /* Crystallizations — datasheet dense */
    .crystallizations {
      margin: 10px 0;
      padding: 8px 10px;
      border: 1px solid #d9ceb0;
      border-left: 3px solid #6366f1;
      background: rgba(99,102,241,0.04);
    }
    .crystallizations__head { display:flex; align-items:baseline; gap:6px; margin-bottom:5px; }
    .crystallizations__eyebrow { font-size:10px; letter-spacing:0.06em; text-transform:uppercase; color:#4338ca; font-weight:500; }
    .crystallizations__count { font-size:12px; color:#4338ca; }
    .crystallizations__list { list-style:none; padding:0; margin:0; display:grid; gap:5px; }
    .crystallizations__item { border-top:1px dotted #c7d2fe; padding-top:4px; }
    .crystallizations__item:first-child { border-top:0; padding-top:0; }
    .crystallizations__title { display:block; font-size:11.5px; color:#1e1b4b; margin-bottom:1px; font-weight:600; }
    .crystallizations__body { font-size:11px; color:#2a2620; line-height:1.45; margin:0; }

    /* Hyperedges — single line list */
    .hyperedges {
      margin: 8px 0;
      padding: 6px 10px;
      border: 1px solid #d9ceb0;
      border-left: 3px solid #10b981;
      background: rgba(16,185,129,0.04);
    }
    .hyperedges__head { display:flex; align-items:baseline; gap:6px; margin-bottom:4px; }
    .hyperedges__eyebrow { font-size:10px; letter-spacing:0.06em; text-transform:uppercase; color:#047857; font-weight:500; }
    .hyperedges__count { font-size:12px; color:#047857; }
    .hyperedges__list { list-style:none; padding:0; margin:0; display:grid; gap:2px; }
    .hyperedges__item { font-size:10.5px; color:#064e3b; padding:2px 5px; background:rgba(16,185,129,0.08); border-radius:2px; line-height:1.4; }

    /* Lessons — datasheet */
    .lessons { margin:8px 0; padding:6px 10px; border:1px solid #d9ceb0; border-left:3px solid #8a4d00; background:rgba(252,231,196,0.12); }
    .lessons__head { display:flex; align-items:baseline; gap:6px; margin-bottom:4px; }
    .lessons__eyebrow { font-size:10px; letter-spacing:0.06em; text-transform:uppercase; color:#8a4d00; }
    .lessons__count { font-size:12px; color:#8a4d00; }
    .lessons__list { list-style:none; padding:0; margin:0; display:grid; gap:4px; }
    .lessons__item { border-top:1px dotted #e5d3a8; padding-top:3px; }
    .lessons__item:first-child { border-top:0; padding-top:0; }
    .lessons__title { display:block; font-size:11px; color:#5a3a00; font-weight:600; }
    .lessons__body { font-size:10.5px; color:#3a2d10; line-height:1.4; margin:0; }

    /* Open Questions */
    .open-questions { margin:8px 0; padding:6px 10px; border:1px solid #d9ceb0; border-left:3px solid #ec4899; background:rgba(252,231,243,0.18); }
    .open-questions__head { display:flex; align-items:baseline; gap:6px; margin-bottom:4px; }
    .open-questions__eyebrow { font-size:10px; letter-spacing:0.06em; text-transform:uppercase; color:#9d174d; }
    .open-questions__count { font-size:12px; color:#9d174d; }
    .open-questions__list { list-style:none; padding:0; margin:0; display:grid; gap:4px; }
    .open-questions__item { border-top:1px dotted #f9a8d4; padding-top:3px; }
    .open-questions__item:first-child { border-top:0; padding-top:0; }
    .open-questions__title { display:block; font-size:11px; color:#831843; font-weight:600; }
    .open-questions__body { font-size:10.5px; color:#500724; line-height:1.4; margin:0; }

    /* Axis Proposals */
    .axis-proposals { margin:8px 0; padding:6px 10px; border:1px solid #d9ceb0; border-left:3px solid #06b6d4; background:rgba(207,250,254,0.18); }
    .axis-proposals__head { display:flex; align-items:baseline; gap:6px; margin-bottom:4px; }
    .axis-proposals__eyebrow { font-size:10px; letter-spacing:0.06em; text-transform:uppercase; color:#0e7490; }
    .axis-proposals__count { font-size:12px; color:#0e7490; }
    .axis-proposals__list { list-style:none; padding:0; margin:0; display:grid; gap:2px; }
    .axis-proposals__item { font-size:10.5px; color:#155e75; padding:2px 5px; background:rgba(6,182,212,0.08); border-radius:2px; line-height:1.4; }

    /* Legion Commanders — datasheet */
    .legion-commanders { margin:8px 0; padding:6px 10px; border:1px solid #d9ceb0; border-left:3px solid #8a4d00; background:rgba(252,231,196,0.18); }
    .legion-commanders__head { display:flex; align-items:baseline; gap:6px; margin-bottom:4px; }
    .legion-commanders__eyebrow { font-size:10px; letter-spacing:0.06em; text-transform:uppercase; color:#8a4d00; font-weight:500; }
    .legion-commanders__count { font-size:12px; color:#8a4d00; }
    .legion-commanders__list { list-style:none; padding:0; margin:0; display:grid; gap:3px; }
    .legion-commanders__item { display:grid; grid-template-columns:max-content 1fr; gap:4px 8px; align-items:baseline; }
    .legion-commanders__name { font-size:10.5px; color:#2a2620; background:rgba(192,180,143,0.25); padding:1px 5px; border-radius:2px; }
    .legion-commanders__note { color:#4a4338; line-height:1.4; font-size:10.5px; }

    /* ExternalReferentCard — datasheet */
    .ext-referent-card { margin:8px 0; padding:6px 10px; border:1px solid #d9ceb0; border-left:3px solid #8a4d00; background:#f8f3e6; }
    .ext-referent-card__head { margin-bottom:3px; }
    .ext-referent-card__eyebrow { font-size:10px; letter-spacing:0.06em; text-transform:uppercase; color:#8a4d00; }
    .ext-referent-card__prose { font-size:11px; line-height:1.45; color:#2a2620; margin:0; word-break:break-word; }
    .family-badge { margin-top:4px; }

    @media (max-width: 540px) {
      .canon-grid { grid-template-columns: 1fr; gap: 1px 0; }
      .canon-label { padding-top: 4px; }
      .pager { flex-direction: column; gap: 6px; }
      .pager .next { text-align: left; }
      .legion-commanders__item { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <main class="wrap">
    <nav class="crumb">
      <a href="/">metahumotonic</a>
      <span class="crumb-sep">›</span>
      <a href="/apostles/">사도</a>
      <span class="crumb-sep">›</span>
      <span>{apostle.name}</span>
    </nav>

    <header>
      <div class="num">{apostle.num}.<span class="icon" aria-hidden="true">{apostle.icon}</span></div>
      <h1>
        {apostle.name}
        {isOpen && <span class="open-tag">사용자 verdict 대기</span>}
      </h1>
      <p class="epithet">{apostle.epithet}</p>
      {apostle.family && <FamilyBadge family={apostle.family} apostleId={apostle.id} />}
    </header>

    <hr />

    <p class="body-ko">{apostle.body_ko}</p>
    <p class="body-en">{apostle.body_en}</p>

    {/* Wave 4: CanonFieldSurface — KG 정전 4 필드 conditional callout */}
    <CanonFieldSurface
      canonical_meaning={apostle.canonical_meaning}
      mythology_referent_v2={apostle.mythology_referent_v2}
      role={apostle.role}
      essence_v4={apostle.essence_v4}
    />

    <hr />

    <dl class="canon-grid">
      <dt class="canon-label">본질</dt>
      <dd class="canon-val essence">{apostle.essence}</dd>

      <dt class="canon-label">공학 family</dt>
      <dd class="canon-val family">{apostle.family}</dd>

      <dt class="canon-label">사용자 정전 경로</dt>
      <dd class="canon-val path">{apostle.mind_path}</dd>

      <dt class="canon-label">이해 상태</dt>
      <dd class="canon-val">{apostle.status}</dd>
    </dl>

    {/* Wave 6: ExternalReferentCard — referent 표시를 card 형태로 시각 보강 */}
    <section class="ext-referent-card" aria-label="외부 정전 referent">
      <header class="ext-referent-card__head">
        <span class="ext-referent-card__eyebrow">외부 정전 · External Canonical Referent</span>
      </header>
      <p class="ext-referent-card__prose">{apostle.external_referent}</p>
    </section>

    {/* KG Crystallizations — 사도별 풍부 본문 발췌 */}
    {apostle.crystallizations && apostle.crystallizations.length > 0 && (
      <section class="crystallizations" aria-label="Crystallizations — KG 결정화 발췌">
        <header class="crystallizations__head">
          <span class="crystallizations__eyebrow">결정화 · Crystallizations</span>
          <span class="crystallizations__count">{apostle.crystallizations.length}</span>
        </header>
        <ol class="crystallizations__list">
          {apostle.crystallizations.map((c: any) => (
            <li class="crystallizations__item">
              <h3 class="crystallizations__title">{c.title}</h3>
              <p class="crystallizations__body">{c.body}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    {/* Cross-apostle Hyperedges — KG 측 관계 hyperedge */}
    {apostle.hyperedges && apostle.hyperedges.length > 0 && (
      <section class="hyperedges" aria-label="Hyperedges — cross-apostle 관계">
        <header class="hyperedges__head">
          <span class="hyperedges__eyebrow">관계 · Cross-Apostle Hyperedges</span>
          <span class="hyperedges__count">{apostle.hyperedges.length}</span>
        </header>
        <ul class="hyperedges__list">
          {apostle.hyperedges.map((h: string) => (
            <li class="hyperedges__item">{h}</li>
          ))}
        </ul>
      </section>
    )}

    {/* Lessons — KG :Lesson 본문 */}
    {apostle.lessons && apostle.lessons.length > 0 && (
      <section class="lessons" aria-label="Lessons — KG 결정화 교훈">
        <header class="lessons__head">
          <span class="lessons__eyebrow">교훈 · Lessons</span>
          <span class="lessons__count">{apostle.lessons.length}</span>
        </header>
        <ul class="lessons__list">
          {apostle.lessons.map((l: any) => (
            <li class="lessons__item">
              <strong class="lessons__title">{l.title}</strong>
              {l.body && <p class="lessons__body">{l.body}</p>}
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* Open Questions — KG :OpenQuestion */}
    {apostle.open_questions && apostle.open_questions.length > 0 && (
      <section class="open-questions" aria-label="Open Questions">
        <header class="open-questions__head">
          <span class="open-questions__eyebrow">열린 질문 · Open Questions</span>
          <span class="open-questions__count">{apostle.open_questions.length}</span>
        </header>
        <ul class="open-questions__list">
          {apostle.open_questions.map((o: any) => (
            <li class="open-questions__item">
              <strong class="open-questions__title">{o.title}</strong>
              {o.body && <p class="open-questions__body">{o.body}</p>}
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* Axis Proposals — KG :Canonical PROPOSES_AXIS_FOR_APOSTLE */}
    {apostle.axis_proposals && apostle.axis_proposals.length > 0 && (
      <section class="axis-proposals" aria-label="Axis Proposals — 학문 정전 axis 후보">
        <header class="axis-proposals__head">
          <span class="axis-proposals__eyebrow">축 후보 · Axis Proposals</span>
          <span class="axis-proposals__count">{apostle.axis_proposals.length}</span>
        </header>
        <ul class="axis-proposals__list">
          {apostle.axis_proposals.map((ax: string) => (
            <li class="axis-proposals__item">{ax}</li>
          ))}
        </ul>
      </section>
    )}

    {/* 군단장 (Legion Commanders) — 사도별 하위 commander cluster
        KG: omc-legioncommanders-2026-05-20, engineboy-canonical-2026-05-19,
            hitomi_la_sexvoid_substrate, pornhub_sexvoid_substrate */}
    {apostle.legion_commanders && apostle.legion_commanders.length > 0 && (
      <section class="legion-commanders" aria-label="군단장 — Legion Commanders">
        <header class="legion-commanders__head">
          <span class="legion-commanders__eyebrow">군단장 · Legion Commanders</span>
          <span class="legion-commanders__count">{apostle.legion_commanders.length}</span>
        </header>
        <ul class="legion-commanders__list">
          {apostle.legion_commanders.map((c: any) => (
            <li class="legion-commanders__item">
              <strong class="legion-commanders__name">{c.name}</strong>
              {c.note && <span class="legion-commanders__note">{c.note}</span>}
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* Wave 3: KGAnchorBox — apostle 측 ReferenceSite 7-tuple 노출 */}
    <KGAnchorBox apostleId={apostle.id} />

    <nav class="pager">
      <a href={`/apostles/${prev.slug}`} class="prev">
        <span class="dir">← {prev.num}</span>
        <span class="label">{prev.name}</span>
      </a>
      <a href={`/apostles/${next.slug}`} class="next">
        <span class="dir">{next.num} →</span>
        <span class="label">{next.name}</span>
      </a>
    </nav>

    <a href="/apostles/" class="back-home">← 12 사도 전체</a>
  </main>
</body>
</html>
