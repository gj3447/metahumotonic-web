---
// KG: ATOM_Web_ApostleIndex
// KG: rs-mh-web-v3-src-pages-apostles-index_astro-2026-05-22
// Wave 5b (F-Fulfill-2 carry-over): family-badge per card
import apostlesData from '../../data/apostles.json';
import FamilyBadge from '../../components/FamilyBadge.astro';  // KG: CONTRACT_FamilyBadge_v1
const apostles = apostlesData.apostles;
---

<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>12 사도 — MetaHumotonic</title>
  <meta name="description" content="메타휴모토닉 12 사도 — 디멘션워커, ICE ORCA DRAGON, 초공동의용사, 비행기맨, 스페이스걸, 인류역사흐름의강물, 리퀘스트의나무, 입체운행구름, 예수, 깊바존, HOH, 몬순." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style>
    *,*:before,*:after { margin:0; padding:0; box-sizing:border-box; }
    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background: #faf6ec;
      color: #1a1815;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; text-decoration: none; }

    .wrap { max-width: 920px; margin: 0 auto; padding: clamp(2.5rem, 6vw, 5rem) clamp(1rem, 4vw, 2.5rem) 6rem; }

    .crumb {
      font-size: 0.78rem;
      letter-spacing: 0.05em;
      color: #8a8273;
      text-transform: uppercase;
      margin-bottom: 3rem;
    }
    .crumb a { border-bottom: 1px solid transparent; transition: border-color 0.2s; }
    .crumb a:hover { border-color: currentColor; }
    .crumb-sep { margin: 0 0.6rem; opacity: 0.5; }

    .eyebrow {
      font-size: 0.78rem;
      letter-spacing: 0.12em;
      color: #8a8273;
      text-transform: uppercase;
      margin-bottom: 1rem;
    }
    h1 {
      font-family: 'Cormorant Garamond', 'Times New Roman', serif;
      font-size: clamp(2.4rem, 5vw, 3.4rem);
      font-weight: 500;
      letter-spacing: -0.01em;
      line-height: 1.1;
    }
    .lede {
      font-size: 1.05rem;
      color: #6b6357;
      margin-top: 0.8rem;
      max-width: 56ch;
      font-style: italic;
    }

    hr { border: 0; height: 1px; background: #d9ceb0; margin: 2.5rem 0 0; }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1px;
      background: #d9ceb0;
      margin-top: 2.5rem;
      border-top: 1px solid #d9ceb0;
      border-bottom: 1px solid #d9ceb0;
    }
    .card {
      background: #faf6ec;
      padding: 1.6rem 1.4rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      transition: background 0.25s;
      min-height: 200px;
    }
    .card:hover { background: #f3edda; }

    .card-num {
      font-family: 'Cormorant Garamond', 'Times New Roman', serif;
      font-style: italic;
      font-size: 1.6rem;
      color: #c0b48f;
      line-height: 1;
    }
    .card-icon { display: inline-block; opacity: 0.5; margin-left: 0.3rem; }
    .card-name {
      font-family: 'Cormorant Garamond', 'Times New Roman', serif;
      font-size: 1.35rem;
      font-weight: 500;
      letter-spacing: -0.005em;
      line-height: 1.15;
      margin-top: 0.2rem;
    }
    .card-epithet {
      font-size: 0.85rem;
      color: #6b6357;
      font-style: italic;
    }
    .card-essence {
      font-size: 0.83rem;
      color: #4a4338;
      line-height: 1.55;
      margin-top: auto;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .card-tag {
      display: inline-block;
      font-size: 0.7rem;
      letter-spacing: 0.05em;
      color: #8a4d00;
    }
    .card-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      margin-top: 0.6rem;
    }

    .footer-line {
      font-size: 0.9rem;
      color: #6b6357;
      margin-top: 3rem;
      font-style: italic;
    }
  </style>
</head>
<body>
  <main class="wrap">
    <nav class="crumb">
      <a href="/">metahumotonic</a>
      <span class="crumb-sep">›</span>
      <span>사도</span>
    </nav>

    <p class="eyebrow">PART TWO · The Twelve Apostles</p>
    <h1>12 사도</h1>
    <p class="lede">메타휴모토닉 세계관의 12 기둥. 신화 측 존재가 공학 측 무기 / family 와 짝패를 이룬다. 4년의 발견으로 완성.</p>

    <hr />

    <section class="grid">
      {apostles.map(a => (
        <a class="card" href={`/apostles/${a.slug}`} aria-label={`${a.num}. ${a.name} — ${a.epithet}`}>
          <span class="card-num">{a.num}.<span class="card-icon" aria-hidden="true">{a.icon}</span></span>
          <h2 class="card-name">{a.name}</h2>
          <p class="card-epithet">{a.epithet}</p>
          <p class="card-essence">{a.essence}</p>
          <div class="card-meta">
            {a.family && <FamilyBadge family={a.family} apostleId={a.id} />}
            {a.status?.startsWith('OPEN') && <span class="card-tag">verdict 대기</span>}
          </div>
        </a>
      ))}
    </section>

    <p class="footer-line">현실 인물 제외. 사용자 자기 신앙시 정전 (MIND/metahumotonic/) 1차 소스.</p>
  </main>
</body>
</html>
