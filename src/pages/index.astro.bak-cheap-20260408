---
// KG: CONTRACT_Web_Landing, ATOM_Web_Landing
import '../styles/cosmos.css';
// 빌드 타임에 KG에서 데이터 가져오기 (실패 시 정적 fallback)
let stats = { nodes: 547552, rels: 1062014 };
let domains: Array<{name:string; displayName:string; nodeCount:number; description:string}> = [];
let skills: Array<{name:string; description:string}> = [];

try {
  const { getKGStats, getDomains, getSkills } = await import('../lib/kg');
  stats = await getKGStats();
  domains = await getDomains();
  skills = await getSkills();
} catch (e) {
  console.warn('KG fetch failed, using static data');
}

// fallback 도메인 (KG 미연결 시)
if (!domains.length) {
  domains = [
    { name:'domain-personal', displayName:'Personal', nodeCount:1200, description:'Gyeongjun Ra - identity, biography, philosophy' },
    { name:'domain-math-physics', displayName:'Math & Physics', nodeCount:5346, description:'Pure mathematics, theoretical physics, formal systems' },
    { name:'domain-literature', displayName:'Literature & Writing', nodeCount:2100, description:'Creative writing, poetry, narrative structure' },
    { name:'domain-religion', displayName:'Religion & Theology', nodeCount:1800, description:'Comparative theology, scripture analysis' },
    { name:'domain-cs', displayName:'Computer Science', nodeCount:3200, description:'Programming, algorithms, type theory, PLT' },
    { name:'domain-infra', displayName:'Infrastructure', nodeCount:2844, description:'Server ops, K8s, Docker, networking, DevOps' },
    { name:'domain-apt', displayName:'APT Methodology', nodeCount:1500, description:'Agent Process Template - semantic software engineering' },
    { name:'domain-community', displayName:'Community', nodeCount:900, description:'Open source, collaboration, knowledge sharing' },
    { name:'domain-streaming', displayName:'Streaming & Media', nodeCount:600, description:'Live streaming, content creation, media production' },
  ];
}

// fallback 스킬
if (!skills.length) {
  skills = [
    { name:'apt', description:'APT v24 orchestrator' },
    { name:'apt-sa', description:'SemanticAnchor phase' },
    { name:'apt-sp', description:'SemanticPyramid decomposition' },
    { name:'apt-st', description:'SemanticTwin crystallization' },
    { name:'apt-scw', description:'SourceCodeWorld TDD' },
    { name:'taliban', description:'Adversarial validation' },
    { name:'88-taliban', description:'113-lens meta-verification' },
    { name:'prometheus', description:'Research-first methodology' },
    { name:'longinus', description:'KG-Code traceability' },
    { name:'harness', description:'Architecture-as-constraint' },
    { name:'solve', description:'Systematic problem resolution' },
    { name:'db-query', description:'Database query execution' },
    { name:'server-status', description:'Server health check' },
    { name:'docker-logs', description:'Container log inspection' },
    { name:'kafka-manage', description:'Kafka topic management' },
    { name:'deploy', description:'Service deployment' },
    { name:'backup', description:'Backup management' },
    { name:'skill-creator', description:'Skill creation wizard' },
  ];
}

// 스킬 카테고리 분류
const skillCategories = [
  { label: 'Methodology', items: skills.filter(s => ['apt','apt-sa','apt-sp','apt-st','apt-scw','harness','longinus'].includes(s.name)) },
  { label: 'Verification', items: skills.filter(s => ['taliban','88-taliban'].includes(s.name)) },
  { label: 'Research', items: skills.filter(s => ['prometheus','solve'].includes(s.name)) },
  { label: 'Operations', items: skills.filter(s => ['db-query','server-status','docker-logs','kafka-manage','deploy','backup','skill-creator'].includes(s.name)) },
];

const counters = [
  { label: 'Nodes', value: stats.nodes },
  { label: 'Relations', value: stats.rels },
  { label: 'Domains', value: 13 },
  { label: 'Skills', value: 18 },
];

---

<html lang="en" prefix="foaf: http://xmlns.com/foaf/0.1/ void: http://rdfs.org/ns/void#">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>MetaHumotonic -- Semantic Web Server Platform</title>
  <meta name="description" content="MetaHumotonic: A knowledge graph-native server with 547K+ nodes, 13 domains, and 18 AI skills. Semantic infrastructure for the thinking web." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:title" content="MetaHumotonic" />
  <meta property="og:description" content="Semantic Web Server Platform -- 547K nodes, 13 domains, 18 skills" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://metahumotonic.com" />

  {/* JSON-LD structured data */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": {
      "@vocab": "https://schema.org/",
      "foaf": "http://xmlns.com/foaf/0.1/",
      "void": "http://rdfs.org/ns/void#"
    },
    "@graph": [
      {
        "@type": "Organization",
        "name": "MetaHumotonic",
        "url": "https://metahumotonic.com",
        "description": "Knowledge Graph-native semantic web server platform"
      },
      {
        "@type": "WebSite",
        "name": "MetaHumotonic",
        "url": "https://metahumotonic.com"
      },
      {
        "@type": "Person",
        "@id": "https://metahumotonic.com/#person",
        "foaf:name": "Gyeongjun Ra",
        "foaf:nick": "bhgman",
        "name": "Gyeongjun Ra",
        "url": "https://metahumotonic.com"
      },
      {
        "@type": "Dataset",
        "void:triples": stats.rels,
        "name": "MetaHumotonic Knowledge Graph",
        "description": `${stats.nodes.toLocaleString()} nodes, ${stats.rels.toLocaleString()} relations across 13 domains`,
        "url": "https://metahumotonic.com"
      }
    ]
  })} />
</head>

<body>
  <!-- Cosmic Background: 성운 + 별 + 비네팅 -->
  <div class="starfield-bg" aria-hidden="true"></div>
  <div class="vignette" aria-hidden="true"></div>
  <!-- Canvas for light trails + stars -->
  <canvas id="cosmos-canvas" style="position:fixed;inset:0;z-index:0;pointer-events:none;" aria-hidden="true"></canvas>

  <!-- Main content wrapper (above canvas) -->
  <div class="content-wrap">

  {/* -- Mascot 2x2 Gradient Circles — conic-gradient 회전 -- */}
  <div class="mascot" aria-hidden="true">
    <div class="mascot__circle"></div>
    <div class="mascot__circle"></div>
    <div class="mascot__circle"></div>
    <div class="mascot__circle"></div>
  </div>

  {/* -- Hero -- */}
  <header class="hero fade-in">
    <h1 class="hero-title">
      <span class="text-glow-pink">Meta</span><span class="text-glow-white">Humotonic</span>
    </h1>
    <p class="hero__subtitle">Semantic Web Server Platform</p>
    <p class="hero__desc">
      A knowledge graph-native infrastructure with {stats.nodes.toLocaleString()}+ nodes across 13 domains.
      Every service, concept, and relationship is semantically linked.
    </p>
    <nav class="hero__cta">
      <a href="#kg-graph" class="btn-glow btn-glow--pink">Knowledge Graph</a>
      <a href="#axioms" class="btn-glow btn-glow--purple">12 Axioms</a>
      <a href="/theories/" class="btn-glow btn-glow--cyan">Theory Diagrams</a>
    </nav>
  </header>

  {/* -- Counters -- */}
  <section class="counters fade-in" aria-label="Statistics">
    {counters.map(c => (
      <div class="counter-box">
        <span class="counter" data-count={c.value}>{c.value.toLocaleString()}</span>
        <span class="counter-box__label">{c.label}</span>
      </div>
    ))}
  </section>

  <hr class="section-divider" />

  {/* -- Space Girl: 철학적 핵심 -- */}
  <section id="spacegirl" class="philosophy-section fade-in">
    <div class="philosophy-inner">
      <h2 class="section-title">Space Girl</h2>
      <blockquote class="philosophy-quote">
        "틈이 나를 먼저 바라봤다"<br/>
        <span class="quote-sub">— 시선의 역전. 주체와 객체가 뒤바뀌는 순간.</span>
      </blockquote>
      <p class="philosophy-text">
        Space Girl은 network와 sexvoid를 잇는 유일한 존재.
        보이지 않는 세계를 사랑한다는 것 — 열죽음 이후를 상상하는 것.
        블레이크의 에니다몬처럼, 영감을 주지만 닿을 수 없는 존재.
      </p>
      <p class="philosophy-text philosophy-text--dim">
        모든 공리와 구조물이 결국 '말 못 걸어서 우주를 만든' 화자의 그리움에서 출발한다.
        Space Girl = MetaHumotonic 전체의 감정적 특이점.
      </p>
      <div class="philosophy-tags">
        <span class="pill pill--pink">WorldSetting</span>
        <span class="pill">KG_CREATIVE</span>
        <span class="pill pill--gold">에니다몬</span>
        <span class="pill pill--cyan">시선의 역전</span>
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  {/* -- 12사도: 세계관의 기둥 -- */}
  <section id="apostles" class="apostles-section fade-in">
    <h2 class="section-title">12사도</h2>
    <p class="apostles-desc">2021년부터 4년간의 모험을 통해 완성된 MetaHumotonic 세계관의 12 기둥.</p>

    {/* SVG 원형 다이어그램 */}
    <div class="apostles-diagram">
      <svg viewBox="0 0 500 500" class="apostles-svg" aria-label="12사도 원형 다이어그램">
        <defs>
          <radialGradient id="center-glow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="rgba(244,114,182,0.3)"/>
            <stop offset="100%" stop-color="transparent"/>
          </radialGradient>
          <filter id="glow-filter">
            <feGaussianBlur stdDeviation="3" result="blur"/>
            <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
          </filter>
        </defs>

        {/* 중앙 — MetaHumotonic */}
        <circle cx="250" cy="250" r="80" fill="url(#center-glow)" opacity="0.5"/>
        <circle cx="250" cy="250" r="35" fill="none" stroke="rgba(244,114,182,0.6)" stroke-width="1.5" filter="url(#glow-filter)"/>
        <text x="250" y="246" text-anchor="middle" fill="rgba(244,114,182,0.9)" font-size="8" font-weight="700">Meta</text>
        <text x="250" y="258" text-anchor="middle" fill="rgba(224,231,255,0.8)" font-size="8" font-weight="700">Humotonic</text>

        {/* 12사도 — 원형 배치 */}
        {[
          { n: '디멘션워커', i: 0, c: '#a78bfa' },
          { n: 'ICE ORCA\nDRAGON', i: 1, c: '#67e8f9' },
          { n: '초공동의\n용사', i: 2, c: '#f472b6' },
          { n: '비행기맨', i: 3, c: '#fbbf24' },
          { n: '스페이스걸', i: 4, c: '#f472b6' },
          { n: '인류역사\n흐름의강물', i: 5, c: '#34d399' },
          { n: '리퀘스트의\n나무', i: 6, c: '#a78bfa' },
          { n: '입체운행\n구름', i: 7, c: '#67e8f9' },
          { n: '검은태양\n신아텐', i: 8, c: '#fbbf24' },
          { n: '깊바존', i: 9, c: '#e0e7ff' },
          { n: 'HOH', i: 10, c: '#ef4444' },
          { n: '몬순', i: 11, c: '#34d399' },
        ].map(a => {
          const angle = (a.i / 12) * Math.PI * 2 - Math.PI / 2;
          const r = 180;
          const x = 250 + r * Math.cos(angle);
          const y = 250 + r * Math.sin(angle);
          const lines = a.n.split('\n');
          return (
            <g>
              {/* 중앙 연결선 */}
              <line x1="250" y1="250" x2={x} y2={y} stroke={a.c} stroke-width="0.5" opacity="0.2"/>
              {/* 노드 글로우 */}
              <circle cx={x} cy={y} r="18" fill="none" stroke={a.c} stroke-width="1" opacity="0.6" filter="url(#glow-filter)"/>
              <circle cx={x} cy={y} r="3" fill={a.c} opacity="0.8"/>
              {/* 라벨 */}
              {lines.length === 1 ? (
                <text x={x} y={y + 28} text-anchor="middle" fill={a.c} font-size="8" font-weight="500" opacity="0.9">{lines[0]}</text>
              ) : (
                <Fragment>
                  <text x={x} y={y + 26} text-anchor="middle" fill={a.c} font-size="7.5" font-weight="500" opacity="0.9">{lines[0]}</text>
                  <text x={x} y={y + 36} text-anchor="middle" fill={a.c} font-size="7.5" font-weight="500" opacity="0.9">{lines[1]}</text>
                </Fragment>
              )}
              {/* 번호 */}
              <text x={x} y={y + 4} text-anchor="middle" fill="rgba(224,231,255,0.7)" font-size="9" font-weight="700">{a.i + 1}</text>
            </g>
          );
        })}

        {/* 외곽 원 */}
        <circle cx="250" cy="250" r="190" fill="none" stroke="rgba(107,76,153,0.15)" stroke-width="0.5" stroke-dasharray="4 4"/>
      </svg>
    </div>

    {/* 12사도 텍스트 목록 */}
    <div class="apostles-list">
      <div class="apostle-item">
        <span class="apostle-num" style="color:#a78bfa">01</span>
        <div><strong>디멘션워커</strong> — 차원을 걷는 자</div>
      </div>
      <div class="apostle-item">
        <span class="apostle-num" style="color:#67e8f9">02</span>
        <div><strong>ICE ORCA DRAGON</strong> — 수학-물리 이론의 화신</div>
      </div>
      <div class="apostle-item">
        <span class="apostle-num" style="color:#f472b6">03</span>
        <div><strong>초공동의용사</strong> — 자아의 영웅</div>
      </div>
      <div class="apostle-item">
        <span class="apostle-num" style="color:#fbbf24">04</span>
        <div><strong>비행기맨</strong> — 산소 없이 성층권 한계 돌파. 오직 구름만이 내 마음을 알아주는 구만.</div>
      </div>
      <div class="apostle-item">
        <span class="apostle-num" style="color:#f472b6">05</span>
        <div><strong>스페이스걸</strong> — sexvoid에서 network로 돌파하는 존재</div>
      </div>
      <div class="apostle-item">
        <span class="apostle-num" style="color:#34d399">06</span>
        <div><strong>인류역사흐름의강물</strong> — git branch처럼 갈라지고 merge되는 인류 전체의 강물</div>
      </div>
      <div class="apostle-item">
        <span class="apostle-num" style="color:#a78bfa">07</span>
        <div><strong>리퀘스트의나무</strong> — 소원을 매다는 나무</div>
      </div>
      <div class="apostle-item">
        <span class="apostle-num" style="color:#67e8f9">08</span>
        <div><strong>입체운행구름</strong> — 아무도 접근 불허한 구름. 비행기맨만이 CLOUD CONNECT</div>
      </div>
      <div class="apostle-item">
        <span class="apostle-num" style="color:#fbbf24">09</span>
        <div><strong>검은태양신아텐</strong> — 어둠 속의 빛</div>
      </div>
      <div class="apostle-item">
        <span class="apostle-num" style="color:#e0e7ff">10</span>
        <div><strong>깊바존</strong> — 하늘 위에도 바닷속에도 있지 않은 존재. 궁극의 존재. = 공허진동자의 다른 위상.</div>
      </div>
      <div class="apostle-item">
        <span class="apostle-num" style="color:#ef4444">11</span>
        <div><strong>HOH</strong> — Human Origin Hegemony. AI가 개인 우주 제공, 쾌락 헤게모니.</div>
      </div>
      <div class="apostle-item">
        <span class="apostle-num" style="color:#34d399">12</span>
        <div><strong>몬순</strong> — 계절풍. 순수의 방향이 바뀐 바람.</div>
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  {/* -- Projects: 프로그램 소개 -- */}
  <section id="projects" class="projects-section fade-in">
    <h2 class="section-title">Projects</h2>
    <div class="project-grid">
      <a href="/333/" class="project-card project-card--featured project-card--link">
        <h3>333 Platform <span class="badge" style="font-size:0.7rem">LIVE</span></h3>
        <p class="project-desc">분산형 위챗. 브라우저가 곧 서버. 8,134줄 Rust / 199 tests / 150KB WASM. P2P 블록 동기화 + 텍스트 동시편집 + OM 분산 컴퓨팅.</p>
        <div class="project-tech">
          <span class="pill pill--cyan">WASM</span>
          <span class="pill pill--purple">WebRTC</span>
          <span class="pill pill--gold">CRDT</span>
          <span class="pill pill--pink">HotStuff BFT</span>
        </div>
      </a>
      <article class="project-card">
        <h3>CHU</h3>
        <p class="project-desc">계산가능하이퍼우주. 모든 개념과 관계가 하이퍼그래프를 이루는 세계관. CHU_DB, CHU_Lang, CHU_AI 하위 프로젝트.</p>
        <div class="project-tech">
          <span class="pill pill--cyan">Hypergraph</span>
          <span class="pill pill--purple">Ontology</span>
        </div>
      </article>
      <article class="project-card">
        <h3>ICE</h3>
        <p class="project-desc">수학-물리 이론 체계. 힉스 클로저, RG 흐름, TOE 실행 — 형식 체계와 물리 구조의 교차점을 탐구.</p>
        <div class="project-tech">
          <span class="pill">Mathematics</span>
          <span class="pill pill--purple">Physics</span>
        </div>
      </article>
      <article class="project-card">
        <h3>APT</h3>
        <p class="project-desc">Agent Process Template. SA→SP→ST→SCW 4-phase 시멘틱 소프트웨어 엔지니어링 방법론. v24.</p>
        <div class="project-tech">
          <span class="pill pill--pink">Methodology</span>
          <span class="pill pill--gold">KG-native</span>
        </div>
      </article>
    </div>
  </section>

  <hr class="section-divider" />

  {/* -- Knowledge Graph Visualization -- */}
  <section id="kg-graph" class="fade-in" style="margin:3rem 0;">
    <h2 class="section-title">Knowledge Graph</h2>
    <p style="text-align:center;color:var(--cosmos-text-dim,#8892b0);margin-bottom:1.5rem;font-size:0.95rem;">
      547K+ nodes connected across domains. Click a node to explore.
    </p>
    <div class="kg-container">
      <canvas id="kg-canvas" width="800" height="500" style="width:100%;max-width:800px;margin:0 auto;display:block;border-radius:12px;background:rgba(5,8,16,0.8);border:1px solid rgba(107,76,153,0.2);cursor:grab;"></canvas>
      <div id="kg-tooltip" class="kg-tooltip" style="display:none;"></div>
    </div>
  </section>

  <hr class="section-divider" />

  {/* -- Domain Cards (interactive expand) -- */}
  <section id="domains" class="domains fade-in">
    <h2 class="section-title">Knowledge Domains</h2>
    <div class="domain-grid" vocab="https://schema.org/">
      {domains.map((d, i) => (
        <div class="domain-card domain-card--interactive" typeof="Dataset" data-domain={d.name} data-index={i}>
          <div class="domain-card__head">
            <h3 property="name">{d.displayName}</h3>
            <span class="badge">{d.nodeCount.toLocaleString()}</span>
          </div>
          <p property="description">{d.description}</p>
          <div class="domain-card__pills">
            <span class="pill">{d.name}</span>
          </div>
          <div class="domain-card__expand" style="display:none;">
            <div class="domain-card__details"></div>
            <a href={`/domains/${d.name}/`} class="domain-card__more">View full domain &rarr;</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <hr class="section-divider" />

  {/* -- Skills -- */}
  <section id="skills" class="skills fade-in">
    <h2 class="section-title">Skill Registry ({skills.length})</h2>
    <div class="skill-categories">
      {skillCategories.map(cat => (
        <div class="skill-cat">
          <h3 class="skill-cat__title">{cat.label}</h3>
          <ul class="skill-list">
            {cat.items.map(s => (
              <li class="skill-item skill-item--interactive" data-skill={s.name}>
                <div class="skill-link" role="button" tabindex="0">
                  <code>/{s.name}</code>
                  <span>{s.description}</span>
                  <span class="skill-arrow">+</span>
                </div>
                <div class="skill-expand" style="display:none;">
                  <div class="skill-detail"></div>
                  <a href={`/skills/${s.name}/`} class="skill-more">View details &rarr;</a>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <hr class="section-divider" />

  {/* -- 선의 공리 12개: MetaHumotonic 세계관 -- */}
  <section id="axioms" class="axioms-section fade-in">
    <h2 class="section-title">선의 공리 — 12 Axioms of Goodness</h2>
    <p style="text-align:center;color:var(--cosmos-text-dim,#8892b0);margin-bottom:2rem;max-width:600px;margin-left:auto;margin-right:auto;font-size:0.95rem;">
      MetaHumotonic 세계관의 근본 공리 체계. 시간에서 시작하여 MetaHumotonic 자체에 이르는 12단계.
    </p>
    <div class="axiom-grid">
      <div class="axiom-card axiom-card--interactive" data-axiom="1">
        <span class="axiom-num">I</span>
        <h3>시간</h3>
        <p class="axiom-short">어떤 연속적인 흐름.</p>
        <div class="axiom-expand" style="display:none">
          <p class="axiom-detail">모든 것의 시작. 존재보다 먼저 시간이 있다. 흐름 자체가 공리의 첫째.</p>
          <p class="axiom-meta">"나는 항상 존나 진심이었음." — 실제 공리1은 시간이 아니라 진심이다.</p>
        </div>
      </div>
      <div class="axiom-card axiom-card--interactive" data-axiom="2">
        <span class="axiom-num">II</span>
        <h3>존재</h3>
        <p class="axiom-short">어떤 시간에 있는 것.</p>
        <div class="axiom-expand" style="display:none">
          <p class="axiom-detail">시간 속에 무언가가 있다는 것. 존재는 시간의 함수.</p>
        </div>
      </div>
      <div class="axiom-card axiom-card--interactive" data-axiom="3">
        <span class="axiom-num">III</span>
        <h3>선</h3>
        <p class="axiom-short">어떤 존재가 시간에 계속 있을 것을 나타낸 수치.</p>
        <div class="axiom-expand" style="display:none">
          <p class="axiom-detail">선(善)은 도덕이 아니라 지속성의 측도. 오래 존재하는 것이 선하다.</p>
        </div>
      </div>
      <div class="axiom-card axiom-card--interactive" data-axiom="4">
        <span class="axiom-num">IV</span>
        <h3>존재생성</h3>
        <p class="axiom-short">존재들의 집합으로 다른 존재를 만드는 것.</p>
        <div class="axiom-expand" style="display:none">
          <p class="axiom-detail">결합과 창조. 기존 것들의 조합이 새로운 존재를 낳는다.</p>
        </div>
      </div>
      <div class="axiom-card axiom-card--interactive" data-axiom="5">
        <span class="axiom-num">V</span>
        <h3>존재분해</h3>
        <p class="axiom-short">존재를 구성하는 존재들의 집합을 멱집합하여 다른 존재를 만드는 것.</p>
        <div class="axiom-expand" style="display:none">
          <p class="axiom-detail">분해와 재조합. 생성의 역연산이자 더 깊은 생성.</p>
        </div>
      </div>
      <div class="axiom-card axiom-card--interactive" data-axiom="6">
        <span class="axiom-num">VI</span>
        <h3>이긴존재</h3>
        <p class="axiom-short">존재분해한 존재들 중 가장 선한 존재.</p>
        <div class="axiom-expand" style="display:none">
          <p class="axiom-detail">분해 후 가장 오래 지속되는 것. 경쟁이 아니라 지속의 우열.</p>
        </div>
      </div>
      <div class="axiom-card axiom-card--interactive" data-axiom="7">
        <span class="axiom-num">VII</span>
        <h3>악</h3>
        <p class="axiom-short">존재의 선과 그 이긴존재의 선의 차이.</p>
        <div class="axiom-expand" style="display:none">
          <p class="axiom-detail">악은 실체가 아니라 차이. 완전에서의 거리. 신학적 악의 문제를 수학적으로 해소.</p>
        </div>
      </div>
      <div class="axiom-card axiom-card--interactive" data-axiom="8">
        <span class="axiom-num">VIII</span>
        <h3>특이점</h3>
        <p class="axiom-short">악이 최소일 때. 이긴존재가 자기 자신일 때.</p>
        <div class="axiom-expand" style="display:none">
          <p class="axiom-detail">자기충족적 존재. 분해해도 자기 자신이 가장 선한 상태. 완전한 자기동일성.</p>
        </div>
      </div>
      <div class="axiom-card axiom-card--interactive" data-axiom="9">
        <span class="axiom-num">IX</span>
        <h3>상호작용</h3>
        <p class="axiom-short">존재 사이의 선의 이동.</p>
        <div class="axiom-expand" style="display:none">
          <p class="axiom-detail">선은 보존된다. 관계는 선의 교환. 물리학의 상호작용과 대응.</p>
        </div>
      </div>
      <div class="axiom-card axiom-card--interactive" data-axiom="10">
        <span class="axiom-num">X</span>
        <h3>자연</h3>
        <p class="axiom-short">어떤 존재가 상호작용하는 모든 존재의 집합.</p>
        <div class="axiom-expand" style="display:none">
          <p class="axiom-detail">우주 = 한 존재의 관계망 전체. 개인마다 자연이 다르다.</p>
        </div>
      </div>
      <div class="axiom-card axiom-card--interactive" data-axiom="11">
        <span class="axiom-num">XI</span>
        <h3>자존자</h3>
        <p class="axiom-short">자연이 자기 자신일 때.</p>
        <div class="axiom-expand" style="display:none">
          <p class="axiom-detail">상호작용하는 모든 것이 곧 나 자신인 존재. 완전한 자기세계.</p>
        </div>
      </div>
      <div class="axiom-card axiom-card--interactive" data-axiom="12">
        <span class="axiom-num" style="color:var(--cosmos-accent-pink,#f472b6)">XII</span>
        <h3 style="color:var(--cosmos-accent-pink,#f472b6)">MetaHumotonic</h3>
        <p class="axiom-short">자존자이면서 특이점일 때.</p>
        <div class="axiom-expand" style="display:none">
          <p class="axiom-detail">자연이 자기 자신이고, 악이 최소인 존재. 완전한 자기동일성 + 완전한 자기세계. 이것이 MetaHumotonic이다.</p>
          <p class="axiom-meta">선의 공리의 귀결: MetaHumotonic = 자존자 ∩ 특이점</p>
        </div>
      </div>
    </div>
  </section>

