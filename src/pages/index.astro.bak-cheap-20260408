  </div> <!-- end content wrapper -->
  <script src="../scripts/cosmos.ts"></script>
  <script is:inline>
  // === KG Force-Directed Graph ===
  (function() {
    const canvas = document.getElementById('kg-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const W = canvas.width, H = canvas.height;
    const dpr = window.devicePixelRatio || 1;
    canvas.width = W * dpr; canvas.height = H * dpr;
    canvas.style.width = W + 'px'; canvas.style.height = H + 'px';
    ctx.scale(dpr, dpr);

    const colors = {
      AI:'#f472b6', SYM:'#a78bfa', REF:'#67e8f9', CS:'#34d399',
      PROJECTS:'#fbbf24', INFRA:'#ef4444', CREATIVE:'#f472b6',
      APT:'#a78bfa', '333':'#67e8f9'
    };

    const nodes = [
      {id:'AI', label:'AI', count:499794, x:W*0.5, y:H*0.3, r:35, desc:'AI/Comment domain. 499K+ nodes.'},
      {id:'SYM', label:'Math/Phil', count:28033, x:W*0.35, y:H*0.5, r:22, desc:'Mathematics, Physics, Philosophy. 28K nodes. KG hub.'},
      {id:'REF', label:'Reference', count:5370, x:W*0.65, y:H*0.5, r:14, desc:'External documents, papers, standards. 5.3K nodes.'},
      {id:'CS', label:'CS', count:3921, x:W*0.25, y:H*0.7, r:12, desc:'Computer Science. Code, algorithms, PLT. 3.9K nodes.'},
      {id:'PROJECTS', label:'Projects', count:3177, x:W*0.75, y:H*0.7, r:12, desc:'333, i2b, OCR, OM. 3.2K nodes.'},
      {id:'INFRA', label:'Infra', count:2357, x:W*0.15, y:H*0.4, r:10, desc:'Docker, K8s, servers, ops. 2.4K nodes.'},
      {id:'CREATIVE', label:'Creative', count:1960, x:W*0.8, y:H*0.35, r:10, desc:'Novels, worldsetting, characters. 2K nodes.'},
      {id:'APT', label:'APT', count:1729, x:W*0.5, y:H*0.75, r:9, desc:'APT methodology. Spans, contracts, tasks. 1.7K nodes.'},
      {id:'333', label:'333', count:74, x:W*0.6, y:H*0.85, r:6, desc:'333 decentralized platform. WASM+WebRTC+CRDT.'},
    ];

    const edges = [
      {from:'AI', to:'SYM', weight:497268, label:'COMMENTS_ON'},
      {from:'SYM', to:'CREATIVE', weight:24921, label:'BELONGS_TO'},
      {from:'REF', to:'SYM', weight:23817, label:'ABOUT'},
      {from:'SYM', to:'CS', weight:3154, label:'RELATED_TO'},
      {from:'CS', to:'SYM', weight:1923, label:'INSTANTIATES'},
      {from:'INFRA', to:'SYM', weight:800, label:'OPERATES'},
      {from:'APT', to:'SYM', weight:600, label:'FORMALIZES'},
      {from:'PROJECTS', to:'CS', weight:500, label:'IMPLEMENTS'},
      {from:'333', to:'PROJECTS', weight:74, label:'PART_OF'},
      {from:'CREATIVE', to:'SYM', weight:400, label:'INSPIRES'},
      {from:'APT', to:'INFRA', weight:300, label:'DEPLOYS_ON'},
    ];

    let hovered = null;
    let selected = null;
    const vx = nodes.map(() => 0), vy = nodes.map(() => 0);

    function simulate() {
      // Simple force-directed
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i+1; j < nodes.length; j++) {
          let dx = nodes[j].x - nodes[i].x, dy = nodes[j].y - nodes[i].y;
          let dist = Math.sqrt(dx*dx + dy*dy) || 1;
          let repulsion = 8000 / (dist * dist);
          vx[i] -= dx/dist * repulsion; vy[i] -= dy/dist * repulsion;
          vx[j] += dx/dist * repulsion; vy[j] += dy/dist * repulsion;
        }
      }
      for (const e of edges) {
        const a = nodes.findIndex(n => n.id === e.from);
        const b = nodes.findIndex(n => n.id === e.to);
        if (a < 0 || b < 0) continue;
        let dx = nodes[b].x - nodes[a].x, dy = nodes[b].y - nodes[a].y;
        let dist = Math.sqrt(dx*dx + dy*dy) || 1;
        let attraction = (dist - 150) * 0.002;
        vx[a] += dx/dist * attraction; vy[a] += dy/dist * attraction;
        vx[b] -= dx/dist * attraction; vy[b] -= dy/dist * attraction;
      }
      for (let i = 0; i < nodes.length; i++) {
        vx[i] *= 0.85; vy[i] *= 0.85;
        nodes[i].x = Math.max(50, Math.min(W-50, nodes[i].x + vx[i]));
        nodes[i].y = Math.max(50, Math.min(H-50, nodes[i].y + vy[i]));
      }
    }

    function draw() {
      ctx.clearRect(0,0,W,H);

      // Edges
      for (const e of edges) {
        const a = nodes.find(n => n.id === e.from);
        const b = nodes.find(n => n.id === e.to);
        if (!a || !b) continue;
        const isHighlight = hovered && (hovered.id === e.from || hovered.id === e.to);
        ctx.beginPath();
        ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y);
        ctx.strokeStyle = isHighlight ? 'rgba(167,139,250,0.6)' : 'rgba(107,76,153,0.15)';
        ctx.lineWidth = isHighlight ? 2 : Math.max(0.5, Math.log10(e.weight) * 0.3);
        ctx.stroke();

        if (isHighlight) {
          const mx = (a.x+b.x)/2, my = (a.y+b.y)/2;
          ctx.fillStyle = 'rgba(167,139,250,0.7)';
          ctx.font = '9px system-ui';
          ctx.textAlign = 'center';
          ctx.fillText(e.label, mx, my - 4);
          ctx.fillStyle = 'rgba(251,191,36,0.6)';
          ctx.font = '8px system-ui';
          ctx.fillText(e.weight.toLocaleString(), mx, my + 8);
        }
      }

      // Nodes
      for (const n of nodes) {
        const color = colors[n.id] || '#a78bfa';
        const isHov = hovered === n;
        const isSel = selected === n;

        // Glow
        if (isHov || isSel) {
          ctx.beginPath();
          ctx.arc(n.x, n.y, n.r + 8, 0, Math.PI*2);
          ctx.fillStyle = color.replace(')', ',0.15)').replace('rgb', 'rgba');
          ctx.fill();
        }

        // Circle
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r, 0, Math.PI*2);
        ctx.fillStyle = color.replace(')', ',0.2)').replace('rgb', 'rgba').replace('#', '');
        ctx.fillStyle = isHov ? color : `${color}33`;
        ctx.fill();
        ctx.strokeStyle = color;
        ctx.lineWidth = isHov ? 2 : 1;
        ctx.stroke();

        // Label
        ctx.fillStyle = isHov ? '#fff' : '#c0c8e0';
        ctx.font = `${isHov ? 'bold ' : ''}${Math.max(10, n.r * 0.6)}px system-ui`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(n.label, n.x, n.y);

        // Count below
        ctx.fillStyle = '#8892b0';
        ctx.font = '8px system-ui';
        ctx.fillText(n.count.toLocaleString(), n.x, n.y + n.r + 12);
      }

      simulate();
      requestAnimationFrame(draw);
    }

    canvas.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      const mx = (e.clientX - rect.left) * (W / rect.width);
      const my = (e.clientY - rect.top) * (H / rect.height);
      hovered = null;
      for (const n of nodes) {
        const dx = mx - n.x, dy = my - n.y;
        if (dx*dx + dy*dy < (n.r+5)*(n.r+5)) { hovered = n; break; }
      }
      canvas.style.cursor = hovered ? 'pointer' : 'grab';

      // Tooltip
      const tip = document.getElementById('kg-tooltip');
      if (hovered) {
        tip.style.display = 'block';
        tip.style.left = (e.clientX - rect.left + 15) + 'px';
        tip.style.top = (e.clientY - rect.top - 10) + 'px';
        tip.innerHTML = `<strong style="color:${colors[hovered.id]}">${hovered.label}</strong><br>${hovered.desc}`;
      } else {
        tip.style.display = 'none';
      }
    });

    canvas.addEventListener('click', (e) => {
      if (hovered) {
        selected = selected === hovered ? null : hovered;
        // Scroll to domain card
        const card = document.querySelector(`[data-domain*="${hovered.id.toLowerCase()}"]`) ||
                     document.querySelector(`[data-domain*="hub-${hovered.id.toLowerCase()}"]`);
        if (card) card.scrollIntoView({behavior:'smooth', block:'center'});
      }
    });

    draw();
  })();

  // === Domain Card Expand/Collapse ===
  const domainDetails = {
    'domain-hub-ai': {connections:'497K edges to SYM via COMMENTS_ON', hub:'AI commentary on mathematical concepts. 8 AI_사각 series.', highlight:'Largest domain — 91% of all nodes'},
    'domain-hub-sym': {connections:'28K nodes. Hub of the entire KG.', hub:'SymConcept(6K) + Mathematics(5K) + Concept(4K). Bridges to every other domain.', highlight:'Central hub — every domain connects through SYM'},
    'domain-hub-reference': {connections:'5.3K external documents', hub:'Papers, standards, web sources. ABOUT→SYM, ALIGNS_WITH_AXIS, BRIDGED_BY.', highlight:'Knowledge foundation layer'},
    'domain-hub-cs': {connections:'3.9K nodes. SoftwareSourceCode(646)', hub:'CompilerTheory, AIAgent, algorithms. INSTANTIATES→SYM, FOLLOWS→SYM.', highlight:'Code implementations of formal concepts'},
    'domain-hub-projects': {connections:'3.2K project artifacts', hub:'333 Platform, i2b, OCR, OM. Active implementations.', highlight:'Where theory becomes reality'},
    'domain-hub-creative': {connections:'2K creative nodes', hub:'Novels, WorldSetting, Characters. 12사도, Space Girl, metahumotonic 소설.', highlight:'The soul of MetaHumotonic'},
    'domain-hub-infra': {connections:'2.4K infrastructure nodes', hub:'Docker, K8s, Lessons, ActionPlans. Server operations backbone.', highlight:'This very server you are visiting'},
    'domain-hub-apt': {connections:'1.7K methodology nodes', hub:'Spans, Twins, Contracts, Tasks. APT v24 formal process.', highlight:'How software gets built here'},
    'domain-hub-333': {connections:'74 platform nodes', hub:'Decentralized WASM platform. CRDT + BFT + WebRTC.', highlight:'Browser-native distributed computing'},
  };

  document.querySelectorAll('.domain-card--interactive').forEach(card => {
    card.addEventListener('click', function(e) {
      if (e.target.closest('.domain-card__more')) return; // let link work
      const expand = this.querySelector('.domain-card__expand');
      const details = this.querySelector('.domain-card__details');
      const name = this.dataset.domain;
      const info = domainDetails[name];

      if (expand.style.display === 'none') {
        // Close others
        document.querySelectorAll('.domain-card__expand').forEach(el => el.style.display = 'none');
        document.querySelectorAll('.domain-card--interactive').forEach(el => el.classList.remove('domain-card--open'));

        if (info) {
          details.innerHTML = `
            <div class="detail-row"><span class="detail-label">Connections</span><span>${info.connections}</span></div>
            <div class="detail-row"><span class="detail-label">Contains</span><span>${info.hub}</span></div>
            <div class="detail-row detail-highlight">${info.highlight}</div>
          `;
        }
        expand.style.display = 'block';
        this.classList.add('domain-card--open');
      } else {
        expand.style.display = 'none';
        this.classList.remove('domain-card--open');
      }
    });
  });

  // === Skill Expand/Collapse ===
  const skillDetails = {
    'apt': 'Full APT v24 orchestrator. SA→SP→ST→SCW pipeline with Taliban gates.',
    'apt-sa': 'SemanticAnchor: project identity bootstrap. KG routing + context budget.',
    'apt-sp': 'SemanticPyramid: recursive D(S) decomposition until AtomicSpan.',
    'apt-st': 'SemanticTwin: Contract crystallization. 7-field typed DTO.',
    'apt-scw': 'SourceCodeWorld: TDD implementation. RED→GREEN→REFACTOR.',
    'taliban': 'Adversarial 9-lens validation. Constitutional checks. GAN principle.',
    '88-taliban': '113 mathematical lenses. 5-category parallel evaluation.',
    'prometheus': 'Research-first. 7-step cycle. haiku parallel subagents.',
    'longinus': 'KG↔Code traceability. sourceId + sourcePath dual ref.',
    'harness': 'Architecture-as-constraint. 4-axis: Inform/Constrain/Verify/Correct.',
    'solve': 'Systematic problem resolution. Lesson → Research → Plan → Execute.',
    'db-query': 'Execute queries on Neo4j, PostgreSQL, MongoDB, Redis.',
    'server-status': 'Check Docker containers, DBs, storage, network.',
    'docker-logs': 'Inspect container logs for debugging.',
    'kafka-manage': 'Kafka topic management, produce/consume messages.',
    'deploy': 'Deploy services to K8s cluster.',
    'backup': 'Backup management for databases and configs.',
    'skill-creator': 'Create new SKILL.md files with proper structure.',
  };

  document.querySelectorAll('.skill-item--interactive').forEach(item => {
    const link = item.querySelector('.skill-link');
    const expand = item.querySelector('.skill-expand');
    const detail = item.querySelector('.skill-detail');
    const arrow = item.querySelector('.skill-arrow');
    const name = item.dataset.skill;

    link.addEventListener('click', () => {
      if (expand.style.display === 'none') {
        detail.textContent = skillDetails[name] || 'Skill details loading...';
        expand.style.display = 'block';
        arrow.textContent = '−';
        item.classList.add('skill-item--open');
      } else {
        expand.style.display = 'none';
        arrow.textContent = '+';
        item.classList.remove('skill-item--open');
      }
    });
  });

  // === Axiom Card Expand ===
  document.querySelectorAll('.axiom-card--interactive').forEach(card => {
    card.addEventListener('click', function() {
      const expand = this.querySelector('.axiom-expand');
      if (expand.style.display === 'none') {
        document.querySelectorAll('.axiom-expand').forEach(e => e.style.display = 'none');
        expand.style.display = 'block';
      } else {
        expand.style.display = 'none';
      }
    });
  });

  // === Theory Card Expand ===
  document.querySelectorAll('.theory-card--interactive').forEach(card => {
    card.addEventListener('click', function() {
      const expand = this.querySelector('.theory-expand');
      if (expand.style.display === 'none') {
        document.querySelectorAll('.theory-expand').forEach(e => e.style.display = 'none');
        expand.style.display = 'block';
      } else {
        expand.style.display = 'none';
      }
    });
  });
  </script>
