---
// KG: CONTRACT_Web_MCP — MCP(Model Context Protocol) 서버 레지스트리 대시보드.
// 에이전트용 머신 리더블 매니페스트: /mcp/manifest.json
import '../../styles/cosmos.css';

const VERIFIED_AT = '2026-07-27';

const statusMeta = {
  verified:    { label: 'verified',    color: '#34d399', desc: `${VERIFIED_AT} 실측으로 live 확인` },
  available:   { label: 'available',   color: '#67e8f9', desc: '설정됨 — 현재 로드되지 않음 (available-not-loaded)' },
  unused:      { label: 'unused',      color: '#4a5578', desc: '정의됨 — 현재 미사용' },
};

const categoryMeta = {
  graph:    { label: 'graph',    color: '#a78bfa' },
  vector:   { label: 'vector',   color: '#f472b6' },
  document: { label: 'document', color: '#fbbf24' },
  storage:  { label: 'storage',  color: '#fb923c' },
  utility:  { label: 'utility',  color: '#67e8f9' },
};

// 공개 페이지: 사설 IP 대신 백엔드 위치를 시스템 수준으로만 표기.
const servers = [
  // ── graph ──
  { name: 'bhgman-neo4j', category: 'graph', status: 'available',
    desc: 'Neo4j 그래프 DB — Cypher read/write, 스키마 인스펙션.',
    backend: 'Proxmox VM200 data-01',
    conn: 'stdio · 로컬 바이너리 neo4j-mcp · bolt://localhost:17687 (터널)' },
  { name: 'airo-neo4j', category: 'graph', status: 'unused',
    desc: '회사 Neo4j — 외부 네트워크 전용, 현재 미사용.',
    backend: '외부 회사 네트워크',
    conn: 'stdio · bolt (회사망) · env NEO4J_USERNAME/PASSWORD' },

  // ── vector ──
  { name: 'redis', category: 'vector', status: 'verified',
    desc: 'Redis 8 — 키/값, 스트림, vector similarity search (HNSW). 실측 키 10,606개.',
    backend: 'Proxmox VM200 data-01',
    conn: 'stdio · uvx redis-mcp-server · redis://…@127.0.0.1:16379/0 (터널)' },

  // ── document ──
  { name: 'mongodb', category: 'document', status: 'verified',
    desc: 'MongoDB — 피드백·로그·앱 데이터 도큐먼트 스토어. 실측 DB 5개.',
    backend: 'Proxmox VM200 data-01',
    conn: 'stdio · npx mongodb-mcp-server · 127.0.0.1:37017 (터널)' },
  { name: 'postgres', category: 'document', status: 'available',
    desc: 'PostgreSQL maindb — 관계형 스토어, SQL read/write.',
    backend: 'Proxmox VM200 data-01',
    conn: 'stdio · uvx postgres-mcp · DATABASE_URI …@127.0.0.1:15432/maindb (터널)' },

  // ── storage ──
  { name: 'bhgman-minio', category: 'storage', status: 'verified',
    desc: 'MinIO / AIStor 오브젝트 스토리지 — 버킷·오브젝트·presigned URL·버저닝. 실측 버킷 16개.',
    backend: 'Proxmox VM200 data-01',
    conn: 'stdio · 로컬 래퍼 스크립트 → docker mcp-server-aistor · 127.0.0.1:19010 (터널)' },
  { name: 'macmini-fs', category: 'storage', status: 'available',
    desc: '맥미니 파일시스템 접근 — /Users/lagyeongjun/CD 루트.',
    backend: 'Mac mini (bhgman)',
    conn: 'stdio · ssh bhgman · npx server-filesystem' },

  // ── utility ──
  { name: 'memory', category: 'utility', status: 'verified',
    desc: 'Knowledge graph 메모리 — 엔티티·관계·관찰을 세션 간 유지.',
    backend: '로컬 (macbook)',
    conn: 'stdio · 로컬 npx @modelcontextprotocol/server-memory' },
  { name: 'fetch', category: 'utility', status: 'verified',
    desc: '웹 fetch — URL 콘텐츠 조회·독해.',
    backend: '로컬 (macbook)',
    conn: 'stdio · uvx mcp-server-fetch' },
  { name: 'sequential-thinking', category: 'utility', status: 'verified',
    desc: '사고 체인 — 동적·반성적 chain-of-thought 문제 해결.',
    backend: '로컬 (macbook)',
    conn: 'stdio · npx server-sequential-thinking' },
  { name: 'lakatotree', category: 'utility', status: 'available',
    desc: 'LakatoTree 서버 — 판단/측정 레지스트리.',
    backend: 'Proxmox LXC CT 301',
    conn: 'stdio · ssh proxmox · pct exec 301 -- … mcp_server.py · Bearer 토큰' },
  { name: 'openobserve', category: 'utility', status: 'available',
    desc: 'OpenObserve — 로그·관측성 쿼리.',
    backend: 'Mac mini (bhgman)',
    conn: 'stdio · ssh bhgman · uv run mcp-server-openobserve · ZO_ACCESS_KEY' },
  { name: 'omd', category: 'utility', status: 'available',
    desc: 'OMD coordination DB 서버.',
    backend: 'Mac mini (bhgman)',
    conn: 'stdio · ssh bhgman · omd_server.server' },
  { name: 'bhgman-tool', category: 'utility', status: 'available',
    desc: 'bhgman_tool engine — 맥미니 커스텀 툴 엔진.',
    backend: 'Mac mini (bhgman)',
    conn: 'stdio · ssh bhgman · bhgman_tool engine' },
  { name: 'oo-trace', category: 'utility', status: 'available',
    desc: 'OpenObserve trace HTTP MCP 엔드포인트.',
    backend: 'OpenObserve (터널 경유)',
    conn: 'http · http://127.0.0.1:18009/mcp (터널)' },
];

const categories = ['graph', 'vector', 'document', 'storage', 'utility'];

const recipes = [
  { name: 'local-npx', color: '#34d399',
    desc: '맥북 로컬에서 npx/uvx로 바로 실행. 외부 의존성 없음.',
    example: '{ "command": "npx", "args": ["-y", "@modelcontextprotocol/server-memory@2026.7.4"] }' },
  { name: 'ssh-stdio', color: '#67e8f9',
    desc: 'ssh alias + 원격 커맨드로 stdio 브릿지. bhgman = 맥미니, proxmox = Proxmox 호스트(ProxyJump bhgman). ssh config에 동일 alias를 정의하면 됨.',
    example: '{ "command": "ssh", "args": ["bhgman", "npx -y @modelcontextprotocol/server-filesystem /Users/lagyeongjun/CD"] }' },
  { name: 'local-tunnel', color: '#a78bfa',
    desc: '127.0.0.1:<port> 로컬 포트포워드 경유. 맥북에서는 autossh launchd(com.macmini.ssh-tunnel*)가 포트를 열어준다. 16379 redis · 37017 mongo · 15432 postgres · 17687 neo4j · 19010 minio · 18009 oo-trace.',
    example: '{ "command": "uvx", "args": ["redis-mcp-server"], "env": { "REDIS_URL": "redis://default:<REDIS_PASSWORD>@127.0.0.1:16379/0" } }' },
  { name: 'http', color: '#fbbf24',
    desc: 'HTTP MCP 엔드포인트에 직접 연결.',
    example: '{ "url": "http://127.0.0.1:18009/mcp" }' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'MCP Registry — MetaHumotonic',
  description: 'MetaHumotonic 인프라의 MCP(Model Context Protocol) 서버 레지스트리 대시보드와 에이전트용 머신 리더블 매니페스트.',
  url: 'https://metahumotonic.com/mcp/',
};
---

<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>MCP Registry — MetaHumotonic</title>
  <meta name="description" content="MetaHumotonic 인프라의 MCP 서버 레지스트리 — 15개 서버의 역할, 백엔드 위치, 연결 방식, 검증 상태. 에이전트용 매니페스트 /mcp/manifest.json." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>

<body>
  <div class="starfield-bg" aria-hidden="true"></div>
  <div class="vignette" aria-hidden="true"></div>

  <div class="page-wrap">
    <nav class="breadcrumb">
      <a href="/">MetaHumotonic</a> <span>›</span> <span>MCP</span>
    </nav>

    <header class="mcp-header fade-in">
      <h1><span style="color:#a78bfa">MCP</span> Registry</h1>
      <p class="mcp-desc">MetaHumotonic 인프라의 Model Context Protocol 서버 레지스트리. {servers.length}개 서버의 역할, 백엔드 위치, 연결 방식, 검증 상태.</p>
      <p class="mcp-manifest-link">
        에이전트용 머신 리더블 매니페스트 → <a href="/mcp/manifest.json"><code>/mcp/manifest.json</code></a>
      </p>
    </header>

    {/* 상태 범례 */}
    <section class="section fade-in">
      <h2>상태 범례</h2>
      <div class="legend-row">
        {Object.values(statusMeta).map(s => (
          <div class="legend-item">
            <span class="badge" style={`color:${s.color}; border-color:${s.color}55; background:${s.color}14;`}>{s.label}</span>
            <span class="legend-desc">{s.desc}</span>
          </div>
        ))}
      </div>
    </section>

    {/* 서버 레지스트리 — 카테고리별 */}
    {categories.map(cat => (
      <section class="section fade-in">
        <h2><span style={`color:${categoryMeta[cat].color}`}>{categoryMeta[cat].label}</span> <span class="cat-count">{servers.filter(s => s.category === cat).length}</span></h2>
        <div class="server-grid">
          {servers.filter(s => s.category === cat).map(srv => (
            <div class="server-card">
              <div class="srv-head">
                <h3>{srv.name}</h3>
                <span class="badge" style={`color:${statusMeta[srv.status].color}; border-color:${statusMeta[srv.status].color}55; background:${statusMeta[srv.status].color}14;`}>
                  {srv.status === 'verified' ? `verified ${VERIFIED_AT}` : statusMeta[srv.status].label}
                </span>
              </div>
              <p class="srv-desc">{srv.desc}</p>
              <div class="srv-meta">
                <div class="srv-row"><span class="srv-key">backend</span><span class="srv-val">{srv.backend}</span></div>
                <div class="srv-row"><span class="srv-key">connect</span><code class="srv-conn">{srv.conn}</code></div>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}

    {/* 연결 recipe */}
    <section class="section fade-in">
      <h2>연결 Recipe</h2>
      <p class="section-desc">매니페스트의 <code>connection.recipe</code> 4종. 에이전트는 이 정보로 자기 <code>.mcp.json</code> 엔트리를 생성할 수 있다.</p>
      <div class="recipe-list">
        {recipes.map(r => (
          <div class="recipe-card">
            <h3 style={`color:${r.color}`}>{r.name}</h3>
            <p>{r.desc}</p>
            <pre><code>{r.example}</code></pre>
          </div>
        ))}
      </div>
    </section>

    {/* 매니페스트 */}
    <section class="section fade-in">
      <h2>에이전트용 매니페스트</h2>
      <p class="section-desc">
        정적 JSON — <a href="/mcp/manifest.json" class="inline-link"><code>https://metahumotonic.com/mcp/manifest.json</code></a>
        · 스키마 <code>metahumotonic/mcp-registry@1</code> · updated {VERIFIED_AT}
      </p>
      <div class="manifest-note">
        <p>비밀번호·토큰 실제 값은 포함하지 않는다. <code>&lt;REDIS_PASSWORD&gt;</code> 같은 플레이스홀더와 env var 이름만 기재 — 각자의 시크릿 스토어에서 주입할 것.</p>
      </div>
    </section>

    <footer class="page-footer">
      <a href="/" class="back-link">← Home</a>
      <a href="/api" class="back-link">API & Services →</a>
    </footer>
  </div>
</body>
</html>

<style is:global>
  *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  body { font-family:'Inter',system-ui,sans-serif; background:#050810; color:#e0e6f0; line-height:1.6; overflow-x:hidden; }
  a { color:inherit; text-decoration:none; }
  .page-wrap { position:relative; z-index:1; max-width:1000px; margin:0 auto; padding:0 clamp(1rem,3vw,3rem); }

  .breadcrumb { padding:1.5rem 0; font-size:0.85rem; color:#4a5578; }
  .breadcrumb a { color:#67e8f9; } .breadcrumb a:hover { text-decoration:underline; }
  .breadcrumb span { margin:0 0.3rem; }

  .mcp-header { text-align:center; padding:2rem 0 3rem; }
  .mcp-header h1 { font-size:clamp(2rem,5vw,3rem); font-weight:800; color:#fff; margin-bottom:1rem; }
  .mcp-desc { font-size:1.1rem; color:#8892b0; max-width:640px; margin:0 auto; }
  .mcp-manifest-link { margin-top:1rem; font-size:0.9rem; color:#4a5578; }
  .mcp-manifest-link a code { color:#a78bfa; font-size:0.9rem; }
  .mcp-manifest-link a:hover code { text-decoration:underline; }

  .section { padding:2rem 0; }
  .section h2 { font-size:1.3rem; font-weight:700; color:#fff; margin-bottom:0.5rem; }
  .cat-count { font-size:0.8rem; color:#4a5578; font-weight:500; vertical-align:middle; }
  .section-desc { font-size:0.9rem; color:#4a5578; margin-bottom:1.5rem; }
  .section-desc code { color:#67e8f9; font-size:0.85rem; }
  .inline-link code { color:#a78bfa; }
  .inline-link:hover code { text-decoration:underline; }

  /* Legend */
  .legend-row { display:flex; flex-wrap:wrap; gap:1rem; margin-top:1rem; }
  .legend-item { display:flex; align-items:center; gap:0.6rem; background:rgba(13,27,42,0.6); border:1px solid rgba(107,76,153,0.15); border-radius:10px; padding:0.6rem 0.9rem; }
  .legend-desc { font-size:0.8rem; color:#8892b0; }

  /* Badge */
  .badge { font-size:0.7rem; font-weight:700; padding:0.15rem 0.55rem; border-radius:999px; border:1px solid; letter-spacing:0.02em; white-space:nowrap; }

  /* Server cards */
  .server-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:1rem; margin-top:1rem; }
  .server-card { background:rgba(13,27,42,0.6); border:1px solid rgba(107,76,153,0.15); border-radius:12px; padding:1.1rem 1.25rem; backdrop-filter:blur(8px); transition:border-color 0.3s; }
  .server-card:hover { border-color:rgba(167,139,250,0.3); }
  .srv-head { display:flex; align-items:center; justify-content:space-between; gap:0.75rem; margin-bottom:0.5rem; }
  .srv-head h3 { font-size:1rem; color:#fff; font-weight:600; font-family:'JetBrains Mono',monospace; }
  .srv-desc { font-size:0.85rem; color:#8892b0; margin-bottom:0.75rem; }
  .srv-meta { display:flex; flex-direction:column; gap:0.35rem; border-top:1px solid rgba(107,76,153,0.12); padding-top:0.6rem; }
  .srv-row { display:flex; gap:0.6rem; align-items:baseline; }
  .srv-key { font-size:0.7rem; font-weight:700; color:#4a5578; text-transform:uppercase; letter-spacing:0.06em; flex-shrink:0; width:3.4rem; }
  .srv-val { font-size:0.8rem; color:#e0e6f0; }
  .srv-conn { font-size:0.75rem; color:#67e8f9; font-family:'JetBrains Mono',monospace; line-height:1.5; }

  /* Recipes */
  .recipe-list { display:flex; flex-direction:column; gap:1rem; }
  .recipe-card { background:rgba(13,27,42,0.6); border:1px solid rgba(107,76,153,0.15); border-radius:12px; padding:1rem 1.25rem; backdrop-filter:blur(8px); }
  .recipe-card h3 { font-size:0.95rem; font-weight:600; margin-bottom:0.4rem; font-family:'JetBrains Mono',monospace; }
  .recipe-card p { font-size:0.85rem; color:#8892b0; margin-bottom:0.6rem; }
  .recipe-card pre { font-size:0.78rem; color:#67e8f9; font-family:'JetBrains Mono',monospace; background:rgba(0,0,0,0.3); padding:0.6rem 0.75rem; border-radius:6px; overflow-x:auto; line-height:1.5; white-space:pre-wrap; }

  /* Manifest note */
  .manifest-note { background:rgba(251,191,36,0.05); border:1px solid rgba(251,191,36,0.25); border-radius:10px; padding:0.9rem 1.1rem; }
  .manifest-note p { font-size:0.85rem; color:#c9b478; }
  .manifest-note code { color:#fbbf24; font-size:0.8rem; }

  .page-footer { display:flex; justify-content:space-between; padding:3rem 0; }
  .back-link { color:#67e8f9; font-size:0.9rem; font-weight:500; }
  .back-link:hover { text-decoration:underline; }

  .fade-in { opacity:0; transform:translateY(20px); transition:opacity 0.6s ease,transform 0.6s ease; }
  .fade-in.visible { opacity:1; transform:none; }

  @media (max-width:480px) {
    .server-grid { grid-template-columns:1fr; }
    .srv-head { flex-direction:column; align-items:flex-start; gap:0.4rem; }
  }
</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
  }, { threshold:0, rootMargin:'0px 0px 50px 0px' });
  document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));
  setTimeout(() => document.querySelectorAll('.fade-in:not(.visible)').forEach(el => el.classList.add('visible')), 1500);
</script>
