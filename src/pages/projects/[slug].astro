---
import WorkbenchLayout from '../../layouts/WorkbenchLayout.astro';
import data from '../../data/workbench.json';
import { publicProjects, relatedProjects, statusLabels, categoryLabels, isSafeLink } from '../../lib/workbench';
export const getStaticPaths = () => publicProjects(data.projects).map(project => ({ params: { slug: project.id }, props: { project } }));
const { project } = Astro.props;
const related = relatedProjects(project, data.projects);
const links = project.links.filter(link => isSafeLink(link.href));
---
<WorkbenchLayout title={`${project.name} — MetaHumotonic`} description={project.summary} path={`/projects/${project.id}/`}>
  <main id="main-content" class="detail-main shell">
    <nav class="breadcrumb" aria-label="현재 위치"><a href="/">홈</a><span aria-hidden="true">/</span><a href="/#projects">작업</a><span aria-hidden="true">/</span><span aria-current="page">{project.name}</span></nav>
    <header class="detail-heading"><p class="eyebrow">{categoryLabels[project.category]}<span class={`project-status status-${project.status}`}><i aria-hidden="true"></i>{statusLabels[project.status]}</span></p><h1>{project.name}</h1><p class="detail-subtitle">{project.subtitle}</p><p class="detail-summary">{project.summary}</p></header>
    <div class="detail-grid">
      <div class="detail-body"><section class="question-callout" aria-labelledby="question-title"><h2 id="question-title" class="eyebrow">THE QUESTION</h2><p>{project.question}</p></section><section aria-labelledby="about-title"><h2 id="about-title">어떤 작업인가요?</h2><p>{project.description}</p></section><section aria-labelledby="boundary-title"><h2 id="boundary-title">현재 설명의 범위</h2><p>{project.boundary}</p></section><section aria-labelledby="related-title"><h2 id="related-title">이어지는 작업</h2><div class="related-list">{related.map(item => <a href={`/projects/${item.id}/`}><span>{item.name} <span class="mini-label">/ {item.subtitle}</span></span><span aria-hidden="true">↗</span></a>)}</div></section></div>
      <aside class="detail-aside" aria-label="프로젝트 출처와 링크"><section><h2>EXPLORE</h2>{links.length > 0 ? links.map(link => <a class="button button-secondary" href={link.href} target={link.href.startsWith('https:') ? '_blank' : undefined} rel={link.href.startsWith('https:') ? 'noopener noreferrer' : undefined}>{link.label} ↗</a>) : <p>현재는 프로젝트 소개를 공개합니다.<br />실행·배포 여부가 확인된 공개 링크만 추가합니다.</p>}<div class="card-tags">{project.tags.map(tag => <span>{tag}</span>)}</div></section><section><h2>PROVENANCE</h2><p>{project.evidenceLabel}</p><p>소개 검토일 <time datetime={project.reviewedAt}>{project.reviewedAt}</time></p><p style="margin-top:12px">EDITORIAL SUMMARY<br />원문 정전과 구분되는 공개용 편집 요약입니다. 검토일은 마지막 커밋일이나 서비스 가동 시각이 아닙니다.</p><a class="text-link" href="/wiki/authority/">공개·출처 원칙 ↗</a></section></aside>
    </div>
  </main>
</WorkbenchLayout>
