  .versus-paradox { text-align: center; }
  .versus-paradox p { color: #8892b0; font-size: 0.85rem; line-height: 1.6; margin-bottom: 0.75rem; }
  .versus-solution { color: #f472b6 !important; font-weight: 600; }

  /* Throne of Numbers */
  .throne-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
