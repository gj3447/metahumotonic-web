---
// KG: CONTRACT_Web_Theories, ATOM_Web_Theories
// MetaHumotonic 이론 체계 — 다이어그램 & 인터랙티브 그래프
import '../styles/cosmos.css';
---

<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Theories — MetaHumotonic</title>
  <meta name="description" content="MetaHumotonic 세계관의 이론 체계. 선의 공리, M∞, 삼각토대, 5대 패러다임 등 시각적 다이어그램." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>

<body>
  <div class="starfield-bg" aria-hidden="true"></div>
  <div class="vignette" aria-hidden="true"></div>
  <canvas id="cosmos-canvas" style="position:fixed;inset:0;z-index:0;pointer-events:none;" aria-hidden="true"></canvas>

  <div class="content-wrap">

  <nav class="top-nav">
    <a href="/" class="nav-brand"><span class="text-glow-pink">Meta</span><span class="text-glow-white">Humotonic</span></a>
    <div class="nav-links">
      <a href="/#axioms">공리</a>
      <a href="/#theories">이론</a>
      <a href="/333/">333</a>
      <a href="/explore">KG</a>
    </div>
  </nav>

  <header class="page-hero fade-in">
    <h1><span class="text-glow-pink">Theory</span> <span class="text-glow-white">Diagrams</span></h1>
    <p class="hero-sub">MetaHumotonic 세계관의 이론들을 다이어그램과 그래프로 시각화</p>
  </header>

  <!-- ============================================ -->
  <!-- 1. 이론 관계 그래프 (Force-Directed Canvas)   -->
  <!-- ============================================ -->
  <section class="diagram-section fade-in" id="theory-graph">
    <h2 class="section-title">이론 관계 그래프</h2>
    <p class="section-desc">13개 이론이 어떻게 연결되는지. 노드를 클릭하면 상세 내용 표시.</p>
    <div class="graph-container">
      <canvas id="theory-canvas" width="900" height="600"></canvas>
      <div id="theory-tooltip" class="tooltip-box" style="display:none;"></div>
    </div>
    <div id="theory-detail-panel" class="detail-panel" style="display:none;"></div>
  </section>

  <hr class="section-divider" />

  <!-- ============================================ -->
  <!-- 2. 선의 공리 흐름도 (SVG Flow)                -->
  <!-- ============================================ -->
  <section class="diagram-section fade-in" id="axiom-flow">
    <h2 class="section-title">선의 공리 — 12단계 흐름도</h2>
    <p class="section-desc">시간에서 시작하여 MetaHumotonic에 도달하는 공리의 논리적 흐름</p>
    <div class="axiom-flow-wrap">
      <svg viewBox="0 0 1000 520" class="axiom-flow-svg" id="axiom-svg">
        <defs>
          <marker id="arrow" markerWidth="8" markerHeight="6" refX="8" refY="3" orient="auto">
            <path d="M0,0 L8,3 L0,6" fill="rgba(167,139,250,0.6)"/>
          </marker>
          <filter id="glow2">
            <feGaussianBlur stdDeviation="4" result="blur"/>
            <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
          </filter>
          <linearGradient id="flow-grad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#a78bfa"/>
            <stop offset="50%" stop-color="#f472b6"/>
            <stop offset="100%" stop-color="#fbbf24"/>
          </linearGradient>
        </defs>

        <!-- 연결 화살표들 (3행 4열 배치) -->
        <!-- Row 1: I→II→III→IV -->
        <line x1="165" y1="90" x2="285" y2="90" stroke="url(#flow-grad)" stroke-width="1.5" marker-end="url(#arrow)" opacity="0.5"/>
        <line x1="415" y1="90" x2="535" y2="90" stroke="url(#flow-grad)" stroke-width="1.5" marker-end="url(#arrow)" opacity="0.5"/>
        <line x1="665" y1="90" x2="785" y2="90" stroke="url(#flow-grad)" stroke-width="1.5" marker-end="url(#arrow)" opacity="0.5"/>
        <!-- Row 1→2: IV drops to V -->
        <path d="M875,130 Q920,200 875,230" stroke="url(#flow-grad)" stroke-width="1.5" fill="none" marker-end="url(#arrow)" opacity="0.4"/>
        <!-- Row 2: V→VI→VII→VIII (right to left) -->
        <line x1="785" y1="270" x2="665" y2="270" stroke="url(#flow-grad)" stroke-width="1.5" marker-end="url(#arrow)" opacity="0.5"/>
        <line x1="535" y1="270" x2="415" y2="270" stroke="url(#flow-grad)" stroke-width="1.5" marker-end="url(#arrow)" opacity="0.5"/>
        <line x1="285" y1="270" x2="165" y2="270" stroke="url(#flow-grad)" stroke-width="1.5" marker-end="url(#arrow)" opacity="0.5"/>
        <!-- Row 2→3: VIII drops to IX -->
        <path d="M100,310 Q50,380 100,410" stroke="url(#flow-grad)" stroke-width="1.5" fill="none" marker-end="url(#arrow)" opacity="0.4"/>
        <!-- Row 3: IX→X→XI→XII -->
        <line x1="165" y1="450" x2="285" y2="450" stroke="url(#flow-grad)" stroke-width="1.5" marker-end="url(#arrow)" opacity="0.5"/>
        <line x1="415" y1="450" x2="535" y2="450" stroke="url(#flow-grad)" stroke-width="1.5" marker-end="url(#arrow)" opacity="0.5"/>
        <line x1="665" y1="450" x2="785" y2="450" stroke="url(#flow-grad)" stroke-width="1.5" marker-end="url(#arrow)" opacity="0.5"/>

        <!-- 12 노드 (3행 4열 S자 배치) -->
        <!-- Row 1: Left→Right -->
        <g class="axiom-node" data-ax="1">
          <rect x="30" y="55" width="130" height="70" rx="12" fill="rgba(13,27,42,0.7)" stroke="#a78bfa" stroke-width="1.5"/>
          <text x="95" y="80" text-anchor="middle" fill="#a78bfa" font-size="11" font-weight="800">I</text>
          <text x="95" y="102" text-anchor="middle" fill="#e0e6f0" font-size="13" font-weight="600">시간</text>
        </g>
        <g class="axiom-node" data-ax="2">
          <rect x="290" y="55" width="130" height="70" rx="12" fill="rgba(13,27,42,0.7)" stroke="#67e8f9" stroke-width="1.5"/>
          <text x="355" y="80" text-anchor="middle" fill="#67e8f9" font-size="11" font-weight="800">II</text>
          <text x="355" y="102" text-anchor="middle" fill="#e0e6f0" font-size="13" font-weight="600">존재</text>
        </g>
        <g class="axiom-node" data-ax="3">
          <rect x="540" y="55" width="130" height="70" rx="12" fill="rgba(13,27,42,0.7)" stroke="#34d399" stroke-width="1.5"/>
          <text x="605" y="80" text-anchor="middle" fill="#34d399" font-size="11" font-weight="800">III</text>
          <text x="605" y="102" text-anchor="middle" fill="#e0e6f0" font-size="13" font-weight="600">선 (善)</text>
        </g>
        <g class="axiom-node" data-ax="4">
          <rect x="790" y="55" width="130" height="70" rx="12" fill="rgba(13,27,42,0.7)" stroke="#fbbf24" stroke-width="1.5"/>
          <text x="855" y="80" text-anchor="middle" fill="#fbbf24" font-size="11" font-weight="800">IV</text>
          <text x="855" y="102" text-anchor="middle" fill="#e0e6f0" font-size="13" font-weight="600">존재생성</text>
        </g>

        <!-- Row 2: Right→Left (S자) -->
        <g class="axiom-node" data-ax="5">
          <rect x="790" y="235" width="130" height="70" rx="12" fill="rgba(13,27,42,0.7)" stroke="#f472b6" stroke-width="1.5"/>
          <text x="855" y="260" text-anchor="middle" fill="#f472b6" font-size="11" font-weight="800">V</text>
          <text x="855" y="282" text-anchor="middle" fill="#e0e6f0" font-size="13" font-weight="600">존재분해</text>
        </g>
        <g class="axiom-node" data-ax="6">
          <rect x="540" y="235" width="130" height="70" rx="12" fill="rgba(13,27,42,0.7)" stroke="#a78bfa" stroke-width="1.5"/>
          <text x="605" y="260" text-anchor="middle" fill="#a78bfa" font-size="11" font-weight="800">VI</text>
          <text x="605" y="282" text-anchor="middle" fill="#e0e6f0" font-size="13" font-weight="600">이긴존재</text>
        </g>
        <g class="axiom-node" data-ax="7">
          <rect x="290" y="235" width="130" height="70" rx="12" fill="rgba(13,27,42,0.7)" stroke="#ef4444" stroke-width="1.5"/>
          <text x="355" y="260" text-anchor="middle" fill="#ef4444" font-size="11" font-weight="800">VII</text>
          <text x="355" y="282" text-anchor="middle" fill="#e0e6f0" font-size="13" font-weight="600">악</text>
        </g>
        <g class="axiom-node" data-ax="8">
          <rect x="30" y="235" width="130" height="70" rx="12" fill="rgba(13,27,42,0.7)" stroke="#67e8f9" stroke-width="1.5"/>
          <text x="95" y="260" text-anchor="middle" fill="#67e8f9" font-size="11" font-weight="800">VIII</text>
          <text x="95" y="282" text-anchor="middle" fill="#e0e6f0" font-size="13" font-weight="600">특이점</text>
        </g>

        <!-- Row 3: Left→Right -->
        <g class="axiom-node" data-ax="9">
          <rect x="30" y="415" width="130" height="70" rx="12" fill="rgba(13,27,42,0.7)" stroke="#fbbf24" stroke-width="1.5"/>
          <text x="95" y="440" text-anchor="middle" fill="#fbbf24" font-size="11" font-weight="800">IX</text>
          <text x="95" y="462" text-anchor="middle" fill="#e0e6f0" font-size="13" font-weight="600">상호작용</text>
        </g>
        <g class="axiom-node" data-ax="10">
          <rect x="290" y="415" width="130" height="70" rx="12" fill="rgba(13,27,42,0.7)" stroke="#34d399" stroke-width="1.5"/>
          <text x="355" y="440" text-anchor="middle" fill="#34d399" font-size="11" font-weight="800">X</text>
          <text x="355" y="462" text-anchor="middle" fill="#e0e6f0" font-size="13" font-weight="600">자연</text>
        </g>
        <g class="axiom-node" data-ax="11">
          <rect x="540" y="415" width="130" height="70" rx="12" fill="rgba(13,27,42,0.7)" stroke="#a78bfa" stroke-width="1.5"/>
          <text x="605" y="440" text-anchor="middle" fill="#a78bfa" font-size="11" font-weight="800">XI</text>
          <text x="605" y="462" text-anchor="middle" fill="#e0e6f0" font-size="13" font-weight="600">자존자</text>
        </g>
        <g class="axiom-node" data-ax="12">
          <rect x="790" y="415" width="130" height="70" rx="12" fill="rgba(13,27,42,0.7)" stroke="#f472b6" stroke-width="2" filter="url(#glow2)"/>
          <text x="855" y="435" text-anchor="middle" fill="#f472b6" font-size="11" font-weight="800">XII</text>
          <text x="855" y="455" text-anchor="middle" fill="#f472b6" font-size="14" font-weight="700">Meta</text>
          <text x="855" y="472" text-anchor="middle" fill="#e0e6f0" font-size="14" font-weight="700">Humotonic</text>
        </g>

        <!-- 핵심 의존 관계 (점선) -->
        <!-- 선(III)→악(VII): 선의 차이가 악 -->
        <line x1="605" y1="130" x2="355" y2="235" stroke="#ef4444" stroke-width="1" stroke-dasharray="4 3" opacity="0.3"/>
        <!-- 존재분해(V)→이긴존재(VI): 분해의 결과 -->
        <line x1="790" y1="270" x2="670" y2="270" stroke="#a78bfa" stroke-width="1" stroke-dasharray="4 3" opacity="0.3"/>
        <!-- 특이점(VIII)+자존자(XI)→XII -->
        <line x1="95" y1="305" x2="855" y2="415" stroke="#f472b6" stroke-width="1" stroke-dasharray="5 3" opacity="0.25"/>
        <line x1="605" y1="485" x2="790" y2="465" stroke="#f472b6" stroke-width="1" stroke-dasharray="5 3" opacity="0.25"/>
      </svg>
    </div>
    <div id="axiom-detail" class="axiom-detail-box" style="display:none;"></div>
  </section>

  <hr class="section-divider" />

  <!-- ============================================ -->
  <!-- 3. M∞ 재귀 다이어그램                         -->
  <!-- ============================================ -->
  <section class="diagram-section fade-in" id="m-infinity">
    <h2 class="section-title">그래서요 337 — M∞ 재귀 구조</h2>
    <p class="section-desc">판단 가능성 연산자 P의 재귀 적용이 필연적 참에 도달하는 과정</p>

    <div class="m-inf-layout">
      <!-- 재귀 체인 시각화 -->
      <div class="m-inf-chain">
        <svg viewBox="0 0 700 400" class="m-inf-svg" id="m-inf-svg">
          <defs>
            <marker id="arr2" markerWidth="7" markerHeight="5" refX="7" refY="2.5" orient="auto">
              <path d="M0,0 L7,2.5 L0,5" fill="#a78bfa"/>
            </marker>
          </defs>

          <!-- M₀ -->
          <rect x="20" y="50" width="120" height="55" rx="10" fill="rgba(13,27,42,0.8)" stroke="#8892b0" stroke-width="1.5"/>
          <text x="80" y="72" text-anchor="middle" fill="#8892b0" font-size="10">M₀</text>
          <text x="80" y="90" text-anchor="middle" fill="#e0e6f0" font-size="11">"신이 있다"</text>
          <!-- Arrow -->
          <line x1="140" y1="78" x2="175" y2="78" stroke="#a78bfa" stroke-width="1.5" marker-end="url(#arr2)"/>
          <text x="157" y="70" text-anchor="middle" fill="#a78bfa" font-size="9">P</text>

          <!-- M₁ -->
          <rect x="180" y="50" width="145" height="55" rx="10" fill="rgba(13,27,42,0.8)" stroke="#67e8f9" stroke-width="1.5"/>
          <text x="252" y="72" text-anchor="middle" fill="#67e8f9" font-size="10">M₁ = P(M₀)</text>
          <text x="252" y="90" text-anchor="middle" fill="#e0e6f0" font-size="9">"확률 결정 가능?"</text>
          <!-- Arrow -->
          <line x1="325" y1="78" x2="360" y2="78" stroke="#a78bfa" stroke-width="1.5" marker-end="url(#arr2)"/>
          <text x="342" y="70" text-anchor="middle" fill="#a78bfa" font-size="9">P</text>

          <!-- M₂ -->
          <rect x="365" y="50" width="145" height="55" rx="10" fill="rgba(13,27,42,0.8)" stroke="#34d399" stroke-width="1.5"/>
          <text x="437" y="72" text-anchor="middle" fill="#34d399" font-size="10">M₂ = P(M₁)</text>
          <text x="437" y="90" text-anchor="middle" fill="#e0e6f0" font-size="9">"그걸 정할 수 있나?"</text>
          <!-- Arrow -->
          <line x1="510" y1="78" x2="545" y2="78" stroke="#a78bfa" stroke-width="1.5" marker-end="url(#arr2)"/>
          <text x="527" y="70" text-anchor="middle" fill="#a78bfa" font-size="9">P</text>

          <!-- ... -->
          <text x="570" y="82" fill="#4a5578" font-size="24" font-weight="300">···</text>

          <!-- 의미의 증류 화살표 (아래로) -->
          <text x="350" y="145" text-anchor="middle" fill="#fbbf24" font-size="11" font-weight="600">↓ 의미의 증류 (Semantic Distillation) ↓</text>
          <text x="350" y="165" text-anchor="middle" fill="#8892b0" font-size="10">내용이 증발하고 순수 형식만 남는다</text>

          <!-- M∞ 고정점 -->
          <g id="m-inf-fixpoint">
            <circle cx="350" cy="260" r="70" fill="none" stroke="#f472b6" stroke-width="2" filter="url(#glow2)"/>
            <circle cx="350" cy="260" r="60" fill="rgba(244,114,182,0.08)"/>
            <text x="350" y="248" text-anchor="middle" fill="#f472b6" font-size="20" font-weight="800">M∞</text>
            <text x="350" y="272" text-anchor="middle" fill="#e0e6f0" font-size="11">= P(M∞)</text>
            <text x="350" y="290" text-anchor="middle" fill="#fbbf24" font-size="10" font-weight="600">필연적 참</text>
          </g>

          <!-- 자기참조 루프 -->
          <path d="M420,260 Q480,200 420,200 Q380,190 350,200" stroke="#f472b6" stroke-width="1.5" fill="none" stroke-dasharray="4 3" marker-end="url(#arr2)" opacity="0.6"/>
          <text x="465" y="220" fill="#f472b6" font-size="9" opacity="0.8">자기지시</text>

          <!-- 귀류법 박스 -->
          <rect x="50" y="200" width="200" height="120" rx="10" fill="rgba(239,68,68,0.08)" stroke="#ef4444" stroke-width="1" stroke-dasharray="5 3"/>
          <text x="150" y="225" text-anchor="middle" fill="#ef4444" font-size="11" font-weight="700">귀류법 (Reductio)</text>
          <text x="150" y="248" text-anchor="middle" fill="#e0e6f0" font-size="9">가정: M∞ = False</text>
          <text x="150" y="265" text-anchor="middle" fill="#e0e6f0" font-size="9">→ "결정 불가능"</text>
          <text x="150" y="282" text-anchor="middle" fill="#e0e6f0" font-size="9">→ 거짓이라 결정 (확률=0)</text>
          <text x="150" y="299" text-anchor="middle" fill="#ef4444" font-size="9" font-weight="600">→ 결정 가능! → 모순 ⚡</text>

          <!-- 코기토 비교 -->
          <rect x="500" y="200" width="180" height="120" rx="10" fill="rgba(167,139,250,0.08)" stroke="#a78bfa" stroke-width="1" stroke-dasharray="5 3"/>
          <text x="590" y="225" text-anchor="middle" fill="#a78bfa" font-size="11" font-weight="700">코기토 비교</text>
          <text x="590" y="250" text-anchor="middle" fill="#8892b0" font-size="9">코기토: 주체가 필요</text>
          <text x="590" y="268" text-anchor="middle" fill="#8892b0" font-size="9">"나는 생각한다 ∴ 존재"</text>
          <text x="590" y="292" text-anchor="middle" fill="#f472b6" font-size="9" font-weight="600">M∞: 주체도 내용도 불필요</text>
          <text x="590" y="308" text-anchor="middle" fill="#fbbf24" font-size="9">순수 형식의 필연성</text>

          <!-- Lean 4 코드 박스 -->
          <rect x="130" y="345" width="440" height="45" rx="8" fill="rgba(5,8,16,0.9)" stroke="rgba(107,76,153,0.3)" stroke-width="1"/>
          <text x="350" y="365" text-anchor="middle" fill="#67e8f9" font-size="10" font-family="monospace">instance decidable_of_decidable (Q : Prop) [Decidable Q]</text>
          <text x="350" y="380" text-anchor="middle" fill="#34d399" font-size="10" font-family="monospace">  : Decidable (Decidable Q) := .isTrue inst</text>
        </svg>
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- ============================================ -->
  <!-- 4. 삼각토대 (Triangle Diagram)               -->
  <!-- ============================================ -->
  <section class="diagram-section fade-in" id="triple-foundation">
    <h2 class="section-title">삼각토대 — Triple Foundation</h2>
    <p class="section-desc">MetaHumotonic 세계관의 세 기둥: 인식론 + 존재론 + 우주론</p>
    <div class="triangle-wrap">
      <svg viewBox="0 0 600 500" class="triangle-svg" id="triangle-svg">
        <defs>
          <filter id="glow3">
            <feGaussianBlur stdDeviation="6" result="blur"/>
            <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
          </filter>
        </defs>

        <!-- 삼각형 외곽 -->
        <polygon points="300,60 80,420 520,420" fill="none" stroke="rgba(167,139,250,0.3)" stroke-width="1.5" stroke-dasharray="8 4"/>

        <!-- 내부 글로우 -->
        <polygon points="300,60 80,420 520,420" fill="rgba(167,139,250,0.03)"/>

        <!-- 연결선 (중앙↔꼭짓점) -->
        <line x1="300" y1="230" x2="300" y2="120" stroke="#fbbf24" stroke-width="1" opacity="0.3"/>
        <line x1="300" y1="230" x2="130" y2="380" stroke="#f472b6" stroke-width="1" opacity="0.3"/>
        <line x1="300" y1="230" x2="470" y2="380" stroke="#67e8f9" stroke-width="1" opacity="0.3"/>

        <!-- 중앙 MetaHumotonic -->
        <circle cx="300" cy="230" r="40" fill="rgba(244,114,182,0.1)" stroke="#f472b6" stroke-width="1.5" filter="url(#glow3)"/>
        <text x="300" y="225" text-anchor="middle" fill="#f472b6" font-size="9" font-weight="700">Meta</text>
        <text x="300" y="240" text-anchor="middle" fill="#e0e6f0" font-size="9" font-weight="700">Humotonic</text>

        <!-- 꼭짓점 1: M∞ (인식론) — 상단 -->
        <g class="tri-node" data-tri="m-inf">
          <circle cx="300" cy="80" r="50" fill="rgba(251,191,36,0.08)" stroke="#fbbf24" stroke-width="2"/>
          <text x="300" y="68" text-anchor="middle" fill="#fbbf24" font-size="18" font-weight="800">M∞</text>
          <text x="300" y="88" text-anchor="middle" fill="#e0e6f0" font-size="10">인식론적 토대</text>
          <text x="300" y="103" text-anchor="middle" fill="#8892b0" font-size="8">판단 가능성은</text>
          <text x="300" y="115" text-anchor="middle" fill="#8892b0" font-size="8">필연적 참</text>
        </g>

