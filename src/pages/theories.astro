          vx[j] += dx/dist*rep; vy[j] += dy/dist*rep;
        }
      }
      for (const e of edges) {
        const a = theories.findIndex(t=>t.id===e.from);
        const b = theories.findIndex(t=>t.id===e.to);
        if (a<0||b<0) continue;
        let dx = theories[b].x - theories[a].x, dy = theories[b].y - theories[a].y;
        let dist = Math.sqrt(dx*dx+dy*dy)||1;
        let att = (dist-130)*0.003;
        vx[a] += dx/dist*att; vy[a] += dy/dist*att;
        vx[b] -= dx/dist*att; vy[b] -= dy/dist*att;
      }
      for (let i=0; i<theories.length; i++) {
        vx[i]*=0.85; vy[i]*=0.85;
        theories[i].x = Math.max(60,Math.min(W-60, theories[i].x+vx[i]));
        theories[i].y = Math.max(60,Math.min(H-60, theories[i].y+vy[i]));
      }
    }

    function draw() {
      ctx.clearRect(0,0,W,H);
      // Edges
      for (const e of edges) {
        const a = theories.find(t=>t.id===e.from);
        const b = theories.find(t=>t.id===e.to);
        if (!a||!b) continue;
        const hl = hovered && (hovered.id===e.from||hovered.id===e.to);
        const sl = selected && (selected.id===e.from||selected.id===e.to);
        ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y);
        ctx.strokeStyle = (hl||sl) ? 'rgba(167,139,250,0.6)' : 'rgba(107,76,153,0.15)';
        ctx.lineWidth = (hl||sl) ? 2.5 : Math.max(0.5, e.w*0.4);
        ctx.stroke();
        if (hl||sl) {
          const mx=(a.x+b.x)/2, my=(a.y+b.y)/2;
          ctx.fillStyle='rgba(251,191,36,0.7)'; ctx.font='9px system-ui'; ctx.textAlign='center';
          ctx.fillText(e.label, mx, my-5);
        }
      }
      // Nodes
      for (const n of theories) {
        const isH = hovered===n, isS = selected===n;
        if (isH||isS) {
          ctx.beginPath(); ctx.arc(n.x,n.y,n.r+10,0,Math.PI*2);
          ctx.fillStyle = n.color+'18'; ctx.fill();
        }
        ctx.beginPath(); ctx.arc(n.x,n.y,n.r,0,Math.PI*2);
        ctx.fillStyle = isH ? n.color+'44' : n.color+'15';
        ctx.fill();
        ctx.strokeStyle = n.color;
        ctx.lineWidth = isH?2.5:isS?2:1;
        ctx.stroke();
        ctx.fillStyle = isH?'#fff':'#c0c8e0';
        ctx.font = `${isH?'bold ':''}${Math.max(9,n.r*0.55)}px system-ui`;
        ctx.textAlign='center'; ctx.textBaseline='middle';
        ctx.fillText(n.label, n.x, n.y);
      }
      simulate();
      requestAnimationFrame(draw);
    }

    canvas.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      const mx = (e.clientX-rect.left)*(W/rect.width);
      const my = (e.clientY-rect.top)*(H/rect.height);
      hovered = null;
      for (const n of theories) {
        if ((mx-n.x)**2+(my-n.y)**2 < (n.r+8)**2) { hovered=n; break; }
      }
      canvas.style.cursor = hovered?'pointer':'grab';
      const tip = document.getElementById('theory-tooltip');
      if (hovered) {
        tip.style.display='block';
        tip.style.left = (e.clientX-rect.left+15)+'px';
        tip.style.top = (e.clientY-rect.top-10)+'px';
        tip.innerHTML = `<strong style="color:${hovered.color}">${hovered.label}</strong><br><span style="font-size:0.75rem">${hovered.desc}</span>`;
      } else tip.style.display='none';
    });

    canvas.addEventListener('click', () => {
      if (hovered) {
        selected = selected===hovered?null:hovered;
        const panel = document.getElementById('theory-detail-panel');
        if (selected) {
          const connected = edges.filter(e=>e.from===selected.id||e.to===selected.id)
            .map(e => {
              const other = e.from===selected.id ? e.to : e.from;
              const t = theories.find(x=>x.id===other);
              return `<span class="pill" style="border-color:${t?t.color:'#aaa'}">${t?t.label:other}</span> <span style="color:#8892b0;font-size:0.75rem">${e.label}</span>`;
            }).join(' &middot; ');
          panel.innerHTML = `<h3 style="color:${selected.color}">${selected.label}</h3><p>${selected.desc}</p><div style="margin-top:0.5rem">${connected}</div>`;
          panel.style.display='block';
          panel.style.borderColor=selected.color;
        } else panel.style.display='none';
      }
    });

    draw();
  })();

  // ===========================
  // Axiom Flow Interactivity
  // ===========================
  (function() {
    const axiomData = {
      1: { name:'시간', full:'어떤 연속적인 흐름. 모든 것의 시작. 존재보다 먼저 시간이 있다.', sub:'"나는 항상 존나 진심이었음." — 실제 공리1은 시간이 아니라 진심이다.' },
      2: { name:'존재', full:'어떤 시간에 있는 것. 시간 속에 무언가가 있다. 존재는 시간의 함수.', sub:'' },
      3: { name:'선', full:'어떤 존재가 시간에 계속 있을 것을 나타낸 수치. 도덕이 아니라 지속성의 측도.', sub:'' },
      4: { name:'존재생성', full:'존재들의 집합으로 다른 존재를 만드는 것. 결합과 창조.', sub:'' },
      5: { name:'존재분해', full:'존재를 구성하는 존재들의 집합을 멱집합하여 다른 존재를 만드는 것.', sub:'' },
      6: { name:'이긴존재', full:'존재분해한 존재들 중 가장 선한 존재. 지속의 우열.', sub:'' },
      7: { name:'악', full:'존재의 선과 그 이긴존재의 선의 차이. 악은 실체가 아니라 차이.', sub:'신학적 악의 문제를 수학적으로 해소.' },
      8: { name:'특이점', full:'악이 최소일 때. 이긴존재가 자기 자신일 때. 완전한 자기동일성.', sub:'' },
      9: { name:'상호작용', full:'존재 사이의 선의 이동. 선은 보존된다. 관계는 선의 교환.', sub:'' },
      10: { name:'자연', full:'어떤 존재가 상호작용하는 모든 존재의 집합. 개인마다 자연이 다르다.', sub:'' },
      11: { name:'자존자', full:'자연이 자기 자신일 때. 상호작용하는 모든 것이 곧 나.', sub:'' },
      12: { name:'MetaHumotonic', full:'자존자이면서 특이점일 때. 완전한 자기동일성 + 완전한 자기세계.', sub:'선의 공리의 귀결: MetaHumotonic = 자존자 ∩ 특이점' },
    };

    document.querySelectorAll('.axiom-node').forEach(g => {
      g.style.cursor = 'pointer';
      g.addEventListener('click', function() {
        const ax = parseInt(this.dataset.ax);
        const data = axiomData[ax];
        const panel = document.getElementById('axiom-detail');
        if (!data) return;
        const colors = ['#a78bfa','#67e8f9','#34d399','#fbbf24','#f472b6','#a78bfa','#ef4444','#67e8f9','#fbbf24','#34d399','#a78bfa','#f472b6'];
        const c = colors[ax-1];
        panel.innerHTML = `<div class="axiom-detail-header" style="color:${c}"><span class="axiom-detail-num">${['I','II','III','IV','V','VI','VII','VIII','IX','X','XI','XII'][ax-1]}</span> ${data.name}</div><p>${data.full}</p>${data.sub?`<p class="axiom-detail-sub">${data.sub}</p>`:''}`;
        panel.style.display = 'block';
        panel.style.borderColor = c;
      });
      g.addEventListener('mouseenter', function() {
        const rect = this.querySelector('rect');
        if (rect) rect.setAttribute('fill', 'rgba(167,139,250,0.15)');
      });
      g.addEventListener('mouseleave', function() {
        const rect = this.querySelector('rect');
        if (rect) rect.setAttribute('fill', 'rgba(13,27,42,0.7)');
      });
    });
  })();

  // ===========================
  // Fade-in on scroll
  // ===========================
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => { if(e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-in').forEach(el => obs.observe(el));
  </script>
</body>
</html>

<style is:global>
  *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
