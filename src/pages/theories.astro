  .paradigm-beyond p { color: #8892b0; font-size: 0.9rem; font-style: italic; }

  /* Stages */
  .stages-wrap { max-width: 600px; margin: 0 auto; }
  .stages-svg { width: 100%; }
  .stage-node { cursor: pointer; }
  .stage-node:hover circle { filter: url(#glow4); }

  /* Life vs God */
  .versus-layout {
    display: flex; gap: 1rem; max-width: 900px; margin: 0 auto;
    flex-wrap: wrap; justify-content: center;
  }
  .versus-side {
    flex: 1; min-width: 250px; max-width: 320px;
