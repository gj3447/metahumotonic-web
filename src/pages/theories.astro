  .vs-check { color: #34d399; font-weight: 700; }
  .vs-x { color: #ef4444; font-weight: 700; }
  .versus-axiom {
    margin-top: 1rem; text-align: center; font-size: 0.85rem;
    color: #8892b0; font-style: italic; padding-top: 0.75rem;
