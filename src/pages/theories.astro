  .throne-mystery {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
    font-size: 6rem; font-weight: 900; color: rgba(244,114,182,0.06);
    pointer-events: none;
  }

  /* Pill */
  .pill {
    display: inline-block; padding: 0.15rem 0.6rem; border-radius: 20px;
