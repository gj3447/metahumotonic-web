    let hovered = null, selected = null;
    const vx = theories.map(()=>0), vy = theories.map(()=>0);

    function simulate() {
      for (let i=0; i<theories.length; i++) {
        for (let j=i+1; j<theories.length; j++) {
          let dx = theories[j].x - theories[i].x, dy = theories[j].y - theories[i].y;
