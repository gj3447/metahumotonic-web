    color: #e0e6f0; max-width: 280px; z-index: 10; backdrop-filter: blur(8px);
  }
  .detail-panel {
    max-width: 600px; margin: 1.5rem auto 0;
    background: rgba(13,27,42,0.6); border: 1px solid rgba(167,139,250,0.3);
    border-radius: 12px; padding: 1.25rem; animation: slideDown 0.3s ease;
  }
  .detail-panel h3 { font-size: 1.2rem; margin-bottom: 0.3rem; }
  .detail-panel p { color: #a0aec0; font-size: 0.9rem; }

  /* Axiom Flow */
  .axiom-flow-wrap {
    max-width: 1000px; margin: 0 auto; overflow-x: auto;
  }
  .axiom-flow-svg { width: 100%; min-width: 700px; }
  .axiom-node { cursor: pointer; }
  .axiom-node:hover rect { filter: url(#glow2); }
  .axiom-detail-box {
    max-width: 600px; margin: 1.5rem auto 0;
    background: rgba(13,27,42,0.6); border: 1px solid rgba(167,139,250,0.3);
    border-radius: 12px; padding: 1.25rem; animation: slideDown 0.3s ease;
  }
  .axiom-detail-header { font-size: 1.2rem; font-weight: 700; margin-bottom: 0.5rem; }
  .axiom-detail-num { font-size: 1.4rem; margin-right: 0.5rem; font-family: serif; }
  .axiom-detail-box p { color: #a0aec0; font-size: 0.9rem; margin-bottom: 0.4rem; }
  .axiom-detail-sub { color: #fbbf24 !important; font-size: 0.8rem !important; font-style: italic; }

  /* M∞ */
  .m-inf-layout { max-width: 800px; margin: 0 auto; }
  .m-inf-chain { overflow-x: auto; }
  .m-inf-svg { width: 100%; min-width: 600px; }

  /* Triangle */
  .triangle-wrap { max-width: 600px; margin: 0 auto; }
  .triangle-svg { width: 100%; }
  .tri-node { cursor: pointer; }
  .tri-node:hover circle { filter: url(#glow3); }

  /* 5 Paradigms */
  .paradigm-wrap { max-width: 700px; margin: 0 auto; }
  .paradigm-track { position: relative; padding-left: 3rem; }
