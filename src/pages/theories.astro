  .versus-life { border-color: rgba(244,114,182,0.3); }
  .versus-god { border-color: rgba(251,191,36,0.3); }
  .versus-icon { font-size: 2.5rem; margin-bottom: 0.5rem; text-align: center; }
  .versus-side h3 { text-align: center; font-size: 1.3rem; margin-bottom: 1rem; }
  .versus-life h3 { color: #f472b6; }
  .versus-god h3 { color: #fbbf24; }
  .versus-side ul { list-style: none; }
  .versus-side li {
