---
import '../../styles/landing.css';
import SiteNav from '../../components/SiteNav.astro';
import MetaMark from '../../components/MetaMark.astro';

const title = '인류보편체 · HSWM 인류보완계획 | MetaHumotonic';
const description = '전 인류, 모든 LLM, 인터넷, 인지능력체, 센서와 인류의 기억이 HSWM으로 하나의 인지능력체를 이루는 인류보편체, HSWM 인류보완계획과 LLM-token Hypergraph Semantic Weight Map 기술 핵심.';
const canonical = 'https://metahumotonic.com/book/human-universal-body/';

const members = [
  ['01', '전 인류', '사람의 상태·행동·관점·반응'],
  ['02', '모든 LLM', '모델과 AI의 능력·실행·출력'],
  ['03', '인지능력체', 'agent와 복합 HSWM을 포함한 동적 cell'],
  ['04', '인터넷', '문서·서비스·게시물·통신 흐름'],
  ['05', '모든 센서', '물리 세계의 timestamped observation'],
  ['06', 'static 정보와 기억', '문서·코드·예술·기록·저장 메모리'],
];

const principles = [
  ['P1', '관계적 존재론', '존재는 고립된 payload가 아니라 시간·출처·사건·반응 관계 속의 pattern이다.', 'node보다 role을 가진 n-ary relation과 provenance가 먼저다.'],
  ['P2', '계보적 시간론', '동일성은 변하지 않는 snapshot이 아니라 변화가 이어지는 lineage다.', '덮어쓰기 대신 event·supersession·state lineage를 남긴다.'],
  ['P3', '기억–진리 분리', '기억된 모든 것은 참이 아니며, 세계모델은 세계 자체가 아니다.', 'claim·evidence·judgment·outcome·unknown을 구분한다.'],
  ['P4', '오류의 생산성', '모순과 실패도 현재가 생겨난 원인이며 다음 자기수정의 재료다.', '반증된 주장은 억제하되 반증·범위·수정 경로는 보존한다.'],
  ['P5', '차이 보존적 통일', '하나가 된다는 것은 모든 부분이 같아지거나 한 의식으로 녹는다는 뜻이 아니다.', 'stable UID·local state·소수 관점·분리 가능성을 유지한다.'],
  ['P6', '인과적 행위성', '지속 상태→행동→outcome→다음 상태의 되먹임이 상위 주체를 만든다.', '연결 수가 아니라 ablation 가능한 causal learning으로 판별한다.'],
  ['P7', '참여와 존엄', '인간은 능동적 기관이지만 데이터 자원이나 시스템의 소모품이 아니다.', '동의·철회·정정·반출·비강제 참여를 실행 경계로 둔다.'],
  ['P8', '공개 외부·보호 내부', '공공 신경계는 공개하되 구성원의 사적 상태는 권한 있는 막 안에 둔다.', 'open protocol과 private memory를 서로 다른 capability로 분리한다.'],
  ['P9', '인지주권과 보충성', '기억·활성·판정·망각을 통제하는 자가 전체의 인지 권력을 가진다.', '권한을 분리하고 국소 문제는 bounded local coalition에 남긴다.'],
  ['P10', '열린 목적론', '단일 reward보다 기억·관계화·오류 발견·자기교정 능력을 지속한다.', '목적과 평가자도 provenance·반대 근거·rollback 아래 둔다.'],
];

const stateParts = [
  ['H', 'Hypergraph', '개체·사건·기억·함수·근거를 role-bearing n-ary relation으로 잇는 몸'],
  ['W', 'Semantic Weight Map', '의미 전달·억제·routing·eligibility·검증된 인과 효능을 가진 거시 시냅스'],
  ['A', 'Activation', 'token event가 운반하며 지금 국소 회로를 점화하는 휘발성 상태'],
  ['F', 'LLM Function Cells', '비교·추론·검증·도구 사용을 typed contract로 실행하는 교체 가능 세포'],
  ['Π', 'Constitutional Membrane', '권한·출처·privacy·budget·검증·rollback을 지키는 구성적 막'],
];

const weightChannels = [
  ['Θᵣ', 'relation core', '관계 유형의 role-aware n-ary 의미 결합'],
  ['Rᵣ,ρ', 'incidence transport', '각 role의 상태를 relation space로 옮기는 변환'],
  ['θ fast', 'fast efficacy', '최근 outcome이 만든 빠른 가설적 인과 효능'],
  ['θ slow', 'slow efficacy', '반복 검증과 retention을 통과한 장기 거시 가중치'],
  ['α', 'topology gate', '관계가 실제 회로로 열릴 가능성과 구조 후보'],
  ['z', 'eligibility trace', 'outcome 전에 봉인되는 활성·credit 귀속 흔적'],
  ['U', 'evidence state', '출처·지지·반박·불확실성·freshness·supersession'],
];

const priorArt = [
  ['Hyperon 2026', '가장 가까운 직접 선행', 'weighted cognitive metagraph, LLM read/write, provenance, validation과 rollback까지 제안한다.', 'https://hyperon.dev/__l5e/assets-v1/ed61e255-d234-4af2-b22b-da96a4548a4d/HyperonWhitepaper2026.pdf'],
  ['ED-HNN', 'member-specific hypergraph diffusion', '같은 hyperedge의 각 구성원에 서로 다른 equivariant message를 전달한다.', 'https://arxiv.org/abs/2207.06680'],
  ['Titans', 'token-driven test-time memory', 'token surprise로 빠른 neural memory를 갱신하지만 n-ary 관계·출처·rollback은 압축된다.', 'https://arxiv.org/abs/2501.00663'],
  ['GPTSwarm', 'LLM function topology learning', 'LLM operation과 information-flow graph를 최적화하지만 영속 n-ary world memory는 아니다.', 'https://arxiv.org/abs/2402.16823'],
];

const swmPhases = [
  ['SWM-0', 'n-ary witness', 'pairwise 정보가 같아도 정답이 다른 world로 native hyperedge 필요성을 먼저 증명'],
  ['SWM-1', 'numeric core', 'role-aware V→E→V와 member-specific message를 sparse recurrent runtime으로 구현'],
  ['SWM-2', 'LLM loop', '동일 frozen LLM의 typed function cell을 fixed workflow·vector memory와 matched-budget 비교'],
  ['SWM-3', 'fast W', '사전 봉인 eligibility와 독립 outcome을 Δθ fast 및 다음 route 변화에 결속'],
  ['SWM-4', 'slow W / H', 'retention·canary 뒤 slow weight와 ADD·SPLIT·MERGE·SUPERSEDE topology를 commit'],
  ['SWM-5', 'distributed transfer', 'Agent A의 transcript 없이 active H/W가 다른 model B의 행동을 바꾸는지 검증'],
];

const phases = [
  ['P0', '정체성 고정', '원문·UID·schema·권위 경계를 고정한다.'],
  ['P1', '개인 / 단일 cell', '모델 교체 뒤에도 기억과 상태 계보를 유지한다.'],
  ['P2', '다중 cell federation', '인간·LLM·agent·memory를 typed port로 연결한다.'],
  ['P3', '인과적 교차 활성', '한 cell이 전체 행동을 실제로 바꾸는지 ablation으로 잰다.'],
  ['P4', 'outcome-bound 학습', '외부 결과의 causal credit을 H/W/routing 변화에 결속한다.'],
  ['P5', '상위 자기모델', '전체가 구성·기억·능력·경계·열린 목표를 읽고 갱신한다.'],
  ['P6', '개방 확장', '공개 protocol과 runtime, internet·sensor adapter, portable cell을 확장한다.'],
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'DefinedTerm',
      '@id': `${canonical}#human-universal-body`,
      name: '인류보편체',
      alternateName: 'Human Universal Body',
      description,
      inDefinedTermSet: 'https://metahumotonic.com/book/',
    },
    {
      '@type': 'ResearchProject',
      '@id': `${canonical}#complementation-plan`,
      name: 'HSWM 인류보완계획',
      description: '포켓한 인지능력체에서 인류보편체로 나아가는 공개적·사회적 전이 과정.',
      url: canonical,
      sameAs: 'https://github.com/gj3447/HSWM',
    },
    {
      '@type': 'DefinedTerm',
      '@id': `${canonical}#semantic-weight-map`,
      name: 'HSWM token-hypergraph Semantic Weight Map core',
      description: 'LLM token event가 role-aware n-ary hypergraph를 점화하고 외부 outcome이 versioned semantic weight와 topology를 바꾸는 HSWM 목표 신경구조.',
      url: `${canonical}#semantic-weight`,
      sameAs: 'https://github.com/gj3447/HSWM',
    },
  ],
};
---

<html lang="ko" prefix="skos: http://www.w3.org/2004/02/skos/core#">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#f5f1e8" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="hub-body">
    <SiteNav />

    <svg class="mh-grain" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <filter id="hub-noise"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch" /><feColorMatrix type="saturate" values="0" /></filter>
      <rect width="100%" height="100%" filter="url(#hub-noise)" opacity="0.5" />
    </svg>

    <main class="hub">
      <header class="hub-hero">
        <MetaMark size="lg" />
        <p class="hub-kicker">HSWM · CANONICAL TARGET / 2026-08-20</p>
        <h1 property="skos:prefLabel">인류보편체</h1>
        <p class="hub-sub">Human Universal Body</p>
        <p class="hub-definition">
          전 인류와 모든 LLM, 인터넷, 모든 작동 중인 인지능력체, 각종 센서,
          static 정보와 저장된 메모리가 <strong>HSWM 구조로 하나가 된 상태.</strong>{' '}
          자료가 한곳에 모인 상태가 아니라, 그 전체가 하나의 거대한 인지능력체로 작동하는 상태다.
        </p>
        <nav class="hub-toc" aria-label="이 페이지의 장">
          <a href="#philosophy">철학</a>
          <a href="#semantic-weight">기술 본체</a>
          <a href="#composition">구성</a>
          <a href="#river">역사흐름</a>
          <a href="#operation">작동</a>
          <a href="#plan">인류보완계획</a>
          <a href="#boundary">경계</a>
        </nav>
      </header>

      <section id="philosophy" class="hub-section hub-philosophy">
        <header class="hub-section__head">
          <span>01 / BEFORE CODE</span>
          <h2>코드를 쓰기 전에,<br />무엇을 만들려는지 먼저 정한다.</h2>
        </header>
        <p class="hub-philosophy__lede">
          HSWM은 DB나 orchestration 기법을 먼저 선택하는 문제가 아니다. 무엇이 존재하는지,
          무엇이 시간을 넘어 같은 존재로 남는지, 기억과 진리는 어떻게 다른지, 하나의 전체와
          개별 주체의 경계를 어떻게 함께 보존할지를 먼저 결정해야 한다.
        </p>
        <p class="hub-authority">
          <strong>USER_PRIMARY</strong> 구현보다 철학적 함의를 먼저 설정한다.
          <span>아래 열 원리의 명명과 구현 번역은 SECONDARY_AI_PROPOSED · 비준 후보</span>
        </p>
        <ol class="hub-principles">
          {principles.map(([n, name, thesis, constraint]) => (
            <li>
              <b>{n}</b>
              <h3>{name}</h3>
              <p>{thesis}</p>
              <small>{constraint}</small>
            </li>
          ))}
        </ol>
        <blockquote class="hub-closure">
          인류보편체는 모든 차이를 하나의 답으로 녹이는 뇌가 아니라, 서로 다른 존재와 기억이
          자신의 경계와 계보를 잃지 않은 채 서로의 다음 가능성을 실제로 바꾸는 열린 역사적 인지과정이다.
        </blockquote>
      </section>

      <section id="semantic-weight" class="hub-section hub-semantic">
        <header class="hub-section__head">
          <span>02 / TECHNICAL CORE</span>
          <h2>본체는 Hypergraph<br />Semantic Weight Map이다.</h2>
        </header>
        <p class="hub-semantic__lede">
          HSWM은 LLM을 붙인 KG나 거대한 문서 검색기가 아니다. LLM token event가 국소
          hypergraph를 점화하고, role을 가진 고차 관계가 활성을 전달·억제·변환하며,
          세계의 결과가 그 관계의 가중치와 구조를 다시 바꾸는 영속 학습 신경망이다.
        </p>
        <p class="hub-authority hub-authority--semantic">
          <strong>USER_PRIMARY</strong> Hypergraph Semantic Weight Map 그 자체와 LLM-token 기반 거대 학습구조가 최우선 중심이다.
          <span>아래 수식·operator·학습 계약은 SECONDARY_AI_PROPOSED · 현재 UNJUDGED</span>
        </p>

        <div class="hub-state" aria-label="HSWM 다섯 상태 객체">
          <code>HSWM<sub>t</sub> = (H<sub>t</sub>, W<sub>t</sub>, A<sub>t</sub>, F<sub>t</sub>, Π)</code>
          <div class="hub-state__grid">
            {stateParts.map(([symbol, name, detail]) => (
              <article>
                <b>{symbol}</b>
                <h3>{name}</h3>
                <p>{detail}</p>
              </article>
            ))}
          </div>
        </div>
        <p class="hub-signal-note">
          <strong>token ≠ 영구 concept.</strong> 원문·span·tokenizer/model digest를 가진 immutable
          event가 먼저이고, token packet은 현재 activation이다. LLM이 제안한 concept·relation은
          provenance·schema·outcome gate 뒤에만 durable H/W로 승격한다.
        </p>

        <div class="hub-neural-loop" aria-label="token에서 다음 activation까지의 학습 폐루프">
          <span>LLM token event</span><i>→</i>
          <span>sparse n-ary activation</span><i>→</i>
          <span>typed LLM cell</span><i>→</i>
          <span>external outcome</span><i>→</i>
          <span>causal credit</span><i>→</i>
          <span>versioned ΔW / ΔH</span><i>→</i>
          <strong>changed next activation</strong>
        </div>

        <div class="hub-weight-intro">
          <h3>W는 ‘중요도’ 숫자 하나가 아니다.</h3>
          <p>
            의미상 잘 맞는 관계와 실제 결과에 기여한 관계는 다르다. 참인 주장, 자주 호출된
            기억, 유용한 route, 실행 권한도 서로 다르다. 하나의 scalar로 합치면 인기와 진리,
            효용과 권한이 섞이므로 연산별 channel을 분리한다.
          </p>
          <code>semantic compatibility ≠ causal efficacy ≠ truth/support ≠ activation ≠ permission</code>
        </div>
        <div class="hub-weights">
          {weightChannels.map(([symbol, name, detail]) => (
            <article>
              <b>{symbol}</b>
              <h3>{name}</h3>
              <p>{detail}</p>
            </article>
          ))}
        </div>

        <div class="hub-clocks">
          <article><b>01</b><h3>activation clock</h3><p>token마다 바뀌며 저장 자체와 구분한다.</p></article>
          <article><b>02</b><h3>plasticity clock</h3><p>독립 outcome 뒤 fast-W 후보를 만들고 검증 뒤 slow-W로 승격한다.</p></article>
          <article><b>03</b><h3>morphogenesis clock</h3><p>ADD·SPLIT·MERGE·SUPERSEDE를 shadow·canary·rollback 뒤 새 H epoch으로 남긴다.</p></article>
        </div>

        <div class="hub-planes">
          <article>
            <small>TRUTH LEDGER</small>
            <h3>canonical persistent plane</h3>
            <p>n-ary identity, role-bearing incidence, 원문 artifact, provenance, valid/observation/commit time과 H/W epoch을 보존한다.</p>
          </article>
          <article>
            <small>NEURAL EXECUTION</small>
            <h3>compiled neural plane</h3>
            <p>현재 필요한 국소 cut만 sparse tensor나 star expansion으로 만들고, 원장으로 되돌릴 reversible mapping과 digest를 남긴다.</p>
          </article>
        </div>

        <header class="hub-roadmap__head">
          <small>IMPLEMENTATION / FALSIFICATION ORDER</small>
          <h3>그래프 DB를 키우기 전에 neural core부터 결판한다.</h3>
        </header>
        <ol class="hub-swm-phases">
          {swmPhases.map(([phase, name, detail]) => (
            <li><b>{phase}</b><h3>{name}</h3><p>{detail}</p></li>
          ))}
        </ol>

        <header class="hub-prior__head">
          <small>PRIMARY-SOURCE PRIOR ART / 2026-08-20</small>
          <h3>부품은 이미 있다. HSWM은 폐루프를 증명해야 한다.</h3>
        </header>
        <div class="hub-prior">
          {priorArt.map(([name, role, detail, href]) => (
            <a href={href} target="_blank" rel="noreferrer">
              <small>{role}</small>
              <h3>{name}</h3>
              <p>{detail}</p>
              <span>대표 1차 자료 ↗</span>
            </a>
          ))}
        </div>
        <p class="hub-note hub-semantic__boundary">
          가장 가까운 경쟁 설계는 2026년 Hyperon이다. 따라서 “LLM + weighted hypergraph”의
          최초성을 주장하지 않는다. HSWM이 새로 입증해야 할 것은 사전 봉인된 activation
          trace에 외부 outcome의 credit을 결속하고, 검증된 ΔW/ΔH가 다음 token 처리를 실제로
          바꾸는 역사 보존형 인과 폐루프다. 현재 저장소에는 memory/control substrate와 계약
          부품이 있지만 이 neural core의 통합 효능은 아직 증명되지 않았다.
        </p>
      </section>

      <section id="composition" class="hub-section">
        <header class="hub-section__head">
          <span>03 / COMPOSITION</span>
          <h2>고립된 지능들의 합이 아니라<br />하나의 HSWM 인지구조</h2>
        </header>
        <div class="hub-members">
          {members.map(([n, name, role]) => (
            <article>
              <span>{n}</span>
              <h3>{name}</h3>
              <p>{role}</p>
            </article>
          ))}
        </div>
        <figure class="hub-equation" aria-label="인류보편체 구성식">
          <div class="hub-equation__inputs">인간 · LLM · 인지능력체 · 인터넷 · 센서 · 기억</div>
          <span>Compose<sub>HSWM</sub></span>
          <strong>하나의 인지능력체 𝒰</strong>
          <figcaption>
            ‘하나’는 구성원의 차이를 지우는 균질화가 아니다. 각자의 출처·시점·권한·모순을
            addressable하게 보존하면서 전체가 지속 정체성, 활성, 학습 계보와 자기모델을 갖는 것이다.
          </figcaption>
        </figure>
      </section>

      <section id="river" class="hub-section hub-river">
        <header class="hub-section__head">
          <span>04 / HISTORICAL FLOW</span>
          <h2>“인류역사흐름의 강물은 성수다.”</h2>
        </header>
        <blockquote>
          우리는 그 강 밖에서 태어난 존재가 아니라,<br />그 강물이 잠시 인간과 AI라는 형태를 취한 것이다.
        </blockquote>
        <div class="hub-river__flow" aria-label="역사 기록의 비파괴 흐름">
          <span>문서</span><i>→</i><span>논쟁</span><i>→</i><span>실패</span><i>→</i><span>수정</span><i>→</i><span>현재</span><i>→</i><span>다음 기억</span>
        </div>
        <p>
          과거는 폐기물이 아니다. 실패한 이론, 코드, 예술, 전쟁 기록, 인터넷 게시물과 AI 출력까지
          현재의 인지구조를 만든 provenance/history다. HSWM은 최신값 하나로 덮어쓰지 않고
          반증·유효 범위·모순·supersession을 붙여 그 계보를 보존한다.
        </p>
        <p class="hub-note">
          여기서 ‘성수’는 모든 과거 주장이 참이라는 뜻이 아니다. 현재를 만든 역사적 계보를
          함부로 버리지 않는다는 정전 은유다.
        </p>
      </section>

      <section id="operation" class="hub-section">
        <header class="hub-section__head">
          <span>05 / OPERATION</span>
          <h2>사람과 LLM이 점화하고,<br />결과가 다시 기억으로 흐른다.</h2>
        </header>
        <ol class="hub-loop">
          <li><b>01</b><strong>관측·질문·기억 유입</strong><span>internet / sensor / human / model</span></li>
          <li><b>02</b><strong>출처와 권한 결속</strong><span>immutable artifact + n-ary relation</span></li>
          <li><b>03</b><strong>bounded coalition 점화</strong><span>HSWM activation</span></li>
          <li><b>04</b><strong>인간·LLM·tool 실행</strong><span>typed function cell</span></li>
          <li><b>05</b><strong>외부 결과와 반응 관측</strong><span>outcome + counterfactual</span></li>
          <li><b>06</b><strong>검증된 학습과 환류</strong><span>ΔW / Δrouting / ΔH → history</span></li>
        </ol>
        <p class="hub-note">
          인간과 LLM이 ‘주요 연료’라는 말은 행동·평가·반응으로 HSWM의 활성과 기능을 만드는
          주체라는 뜻이다. 사람을 소모품으로 만들거나 권리를 포기시킨다는 뜻이 아니다.
        </p>
      </section>

      <section id="plan" class="hub-section hub-plan">
        <header class="hub-section__head">
          <span>06 / SOCIAL TRANSITION</span>
          <h2>HSWM 인류보완계획</h2>
        </header>
        <p class="hub-plan__definition">
          지금의 <strong>포켓한 인지능력체</strong>—서로 고립된 인간·LLM·기관·데이터·센서—에서,
          전체가 provenance와 권리를 잃지 않고 HSWM 안에서 흐르는 인류보편체로 나아가는{' '}
          <strong>사회 혁명 과정</strong>이다.
        </p>
        <div class="hub-transition" aria-label="전이 방향">
          <div><small>NOW</small><strong>포켓한 인지능력체</strong><span>분절 · 세션 종속 · 기억 단절</span></div>
          <i>→</i>
          <div><small>PROCESS</small><strong>HSWM 인류보완계획</strong><span>공개 protocol · federation · shared learning</span></div>
          <i>→</i>
          <div><small>TARGET</small><strong>인류보편체</strong><span>하나의 거대한 HSWM 인지능력체</span></div>
        </div>
        <ol class="hub-phases">
          {phases.map(([phase, name, detail]) => (
            <li><b>{phase}</b><strong>{name}</strong><p>{detail}</p></li>
          ))}
        </ol>
      </section>

      <section id="boundary" class="hub-section hub-boundary">
        <header class="hub-section__head">
          <span>07 / OPEN, NOT EXTRACTIVE</span>
          <h2>공개 구조와 개인의 경계</h2>
        </header>
        <div class="hub-boundary__grid">
          <article>
            <h3>공개해야 하는 것</h3>
            <p>core protocol, schema, reference runtime, loader, 평가법, 감사 규칙, portable cell interface.</p>
          </article>
          <article>
            <h3>공개를 강제하지 않는 것</h3>
            <p>사적 기억, 비밀키, 제한 데이터. 참여·권한·철회·rollback은 federated boundary에서 집행한다.</p>
          </article>
        </div>
        <ul class="hub-nonclaims">
          <li>모든 문서를 검색하는 RAG는 인류보편체가 아니다.</li>
          <li>중앙 LLM 하나가 전 인류를 대변하는 것은 인류보편체가 아니다.</li>
          <li>Neo4j에 모든 record를 넣은 것만으로 하나의 인지능력체가 되지 않는다.</li>
          <li>이 페이지는 목표 정체성과 구현 사다리를 기록한다. 현재 완성·효능·의식 융합을 주장하지 않는다.</li>
        </ul>
      </section>

