      document.addEventListener('DOMContentLoaded', () => {
        const dossier = document.querySelector('#research-dossier');
        if (!(dossier instanceof HTMLDetailsElement)) return;

        const openForHash = () => {
          const target = window.location.hash && document.querySelector(window.location.hash);
          if (target && dossier.contains(target)) dossier.open = true;
        };

        document.querySelectorAll('[data-open-research]').forEach((link) => {
          link.addEventListener('click', () => { dossier.open = true; });
        });
        window.addEventListener('hashchange', openForHash);
        openForHash();
