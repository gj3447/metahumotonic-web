---
import '../styles/product.css';
import foundation from '../data/foundation.json';

const publicHeadline = 'Ultra Safety AI';
const mission = foundation.identity.mission_statement_ko;
const foundationRepository = 'https://github.com/gj3447/metahumotonic-foundation';

const rings = [
  { id: 'cyan', label: 'CYAN' },
  { id: 'magenta', label: 'MAGENTA' },
  { id: 'yellow', label: 'YELLOW' },
  { id: 'white', label: 'WHITE' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'ResearchOrganization'],
  '@id': 'https://metahumotonic.com/#organization',
  name: 'MetaHumotonic',
  url: 'https://metahumotonic.com/',
  slogan: publicHeadline,
  description: mission,
  email: 'hi@metahumotonic.com',
  founder: { '@type': 'Person', name: 'Gyeongjun Ra' },
  publishingPrinciples: 'https://metahumotonic.com/foundation/',
  sameAs: [
    foundationRepository,
    'https://github.com/gj3447/333',
    'https://github.com/gj3447/HSWM',
    'https://github.com/gj3447/lakatotree',
  ],
};
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MetaHumotonic — {publicHeadline}</title>
    <meta name="description" content={mission} />
    <link rel="canonical" href="https://metahumotonic.com/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={publicHeadline} />
    <meta property="og:description" content={mission} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://metahumotonic.com/" />
    <meta name="theme-color" content="#07110f" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class="landing-page landing-page--bare">
    <div class="grid-field" aria-hidden="true"></div>

    <header class="product-nav product-nav--bare">
      <a class="wordmark" href="/" aria-label="MetaHumotonic home">
        <span class="wordmark__sigil">M</span><span>METAHUMOTONIC</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/system/">System</a>
      </nav>
    </header>

    <main class="bare-main">
      <h1 class="bare-title">{publicHeadline}</h1>

      <div class="ring-grid" aria-hidden="true">
        {rings.map((ring) => (
          <div class={`ring ring--${ring.id}`}>
            <svg viewBox="0 0 100 100" role="presentation" focusable="false">
              <circle cx="50" cy="50" r="41" />
            </svg>
          </div>
        ))}
      </div>

      <p class="bare-mission">{mission}</p>
    </main>

    <footer class="bare-footer">
      <span>© 2026 MetaHumotonic</span>
      <nav>
        <a href="/system/">System</a>
        <a href="/book/">Book</a>
      </nav>
    </footer>
  </body>
</html>
