---
// KG: ATOM_Landing_AxiomVisual, ATOM_Landing_ApostleVisual, ATOM_Landing_ConceptProgram,
//     ATOM_Landing_SemanticMarkup, ATOM_Landing_CosmosRefactor, ATOM_Landing_CosmicAccent
//     SA: MetaHumotonic_Landing_v2 | SCW Phase | 12공리+12사도 구조 유지
import '../styles/landing.css';  // KG: ATOM_Landing_CosmosRefactor — 크림 테마 정본
import '../styles/cosmos.css';   // KG: ATOM_Landing_CosmicAccent — 다크 액센트
import '../styles/ritual.css';   // KG: ATOM_Landing_RitualTheme — 신화/제의 override (APT SCW, VR_Gate2 CONDITIONAL_PASS)
import SemanticHead from '../components/SemanticHead.astro';    // KG: ATOM_Landing_SemanticMarkup
import AxiomSection from '../components/AxiomSection.astro';    // KG: ATOM_Landing_AxiomVisual
import ApostleSection from '../components/ApostleSection.astro'; // KG: ATOM_Landing_ApostleVisual
import ConceptProgram from '../components/ConceptProgram.astro'; // KG: ATOM_Landing_ConceptProgram
import apostlesData from '../data/apostles.json';                 // KG: ATOM_Landing_ApostlePortal — 사도 중심 hero

// KG: SHARED_KGStats — 빌드 타임에 KG snapshot 또는 라이브
import { getKGStats } from '../lib/kg';
const stats = await getKGStats();
const apostles = apostlesData.apostles;
---

<html lang="ko" prefix="foaf: http://xmlns.com/foaf/0.1/ void: http://rdfs.org/ns/void# skos: http://www.w3.org/2004/02/skos/core#">
<head>
  <SemanticHead stats={stats} />
</head>

<body vocab="https://schema.org/" typeof="WebSite">

  <header class="mh-topbar">
    <a href="/" class="mh-mark">metahumotonic</a>
    <nav class="mh-nav" aria-label="Doctrine">
      <a href="#axiom">공리</a>
      <a href="/apostles/">사도</a>
      <a href="#concepts">개념</a>
      <a href="#programs">본체</a>
      <a href="/explore/">KG</a>
    </nav>
  </header>

  <svg class="mh-grain" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
    <filter id="mh-noise"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch"/><feColorMatrix type="saturate" values="0"/></filter>
    <rect width="100%" height="100%" filter="url(#mh-noise)" opacity="0.5"/>
  </svg>

  {/* === I. 입구 — 12 사도 그리드 === */}
  <section class="mh-portal" aria-label="MetaHumotonic — 12 사도">
    <header class="mh-portal__head">
      <h1 class="mh-portal__title" property="name">메타휴모토닉</h1>
      <p class="mh-portal__tag" property="description">
        자존자가 특이점에 이를 때 — <em>when the self-grounded becomes its singularity.</em>
      </p>
      <p class="mh-portal__lede">12 사도. 4년의 모험으로 완성된 세계관의 기둥. 한 명씩 들어가 보세요.</p>
    </header>

    <ol class="mh-portal__grid" aria-label="12 사도 입구">
      {apostles.map(a => (
        <li class="mh-portal__cell">
          <a href={`/apostles/${a.slug}`} class="mh-portal__tile" data-apostle-id={a.id}>
            <span class="mh-portal__num">{a.num}.</span>
            <span class="mh-portal__icon" aria-hidden="true">{a.icon}</span>
            <span class="mh-portal__name">{a.name}</span>
            <span class="mh-portal__epithet">{a.epithet}</span>
            {/* Wave 7: hover essence preview tooltip — KG: CONTRACT_PortalTileHover_v1 */}
            {a.essence && (
              <span class="mh-portal__essence-preview" aria-hidden="true">{a.essence.slice(0, 90)}{a.essence.length > 90 ? '…' : ''}</span>
            )}
            {a.status?.startsWith('OPEN') && <span class="mh-portal__open">verdict 대기</span>}
          </a>
        </li>
      ))}
    </ol>

    <p class="mh-portal__hint">
      <span>아래로 스크롤 — 공리 · 사도 전문 · 개념 · 본체</span>
      <span class="mh-portal__chevron" aria-hidden="true">↓</span>
    </p>
  </section>

  {/* === II. 서문 === */}
  <section class="mh-section mh-prelude">
    <p class="mh-eyebrow"><span class="mh-num">II.</span> 서문 / Preface</p>
    <div class="mh-prose">
      <p>이 페이지는 제품 소개가 아니다. 이것은 한 사람의 우주관이다.</p>
      <p>라경준이 2021년부터 4년에 걸쳐 발견한 12 개의 정의, 12 명의 사도, 그리고 그것을 지탱하기 위해 만들어진 서버 한 대의 기록.</p>
    </div>
    <nav class="mh-guide" aria-label="이 페이지의 구성">
      <ol>
        <li><a href="#axiom"><span>PART ONE</span> <em>공리</em><span class="mh-guide__hint">12 정의</span></a></li>
        <li><a href="/apostles/"><span>PART TWO</span> <em>사도</em><span class="mh-guide__hint">12 인의 상세</span></a></li>
        <li><a href="#concepts"><span>PART THREE</span> <em>개념</em><span class="mh-guide__hint">7 갈래</span></a></li>
        <li><a href="#programs"><span>PART FOUR</span> <em>본체</em><span class="mh-guide__hint">KG · APT · 스킬</span></a></li>
      </ol>
    </nav>
  </section>

  {/* === PART ONE: 공리 === */}
  <section class="mh-part-divider">
    <p class="mh-part-eyebrow">PART ONE</p>
    <h2 class="mh-part-title">공리</h2>
    <p class="mh-part-gloss"><em>The Axioms.</em></p>
  </section>

  <AxiomSection />

  {/* === PART TWO + THREE + FOUR: 사도 → 개념 → 프로그램 === */}
  <ApostleSection />
  <ConceptProgram stats={stats} />

  {/* === 초대 === */}
  <section class="mh-section mh-closing">
    <p class="mh-eyebrow"><span class="mh-num">§</span> 초대 / Invitation</p>
    <p class="mh-closing__line">이 우주관에 들어오려면, 먼저 정의 I을 읽으라.</p>
    <footer class="mh-footer">
      <span>&copy; 라경준 &middot; Gyeongjun Ra</span>
      <span><a href="/apostles/">사도</a></span>
      <span><a href="/explore/">도메인</a></span>
      <span><a href="/skills/">Skills</a></span>
      <span><a href="/ontology.ttl">Ontology</a></span>
      <span><a href="/llms.txt">llms.txt</a></span>
      <span><a href="https://github.com/gj3447">GitHub</a></span>
    </footer>
  </section>

</body>
</html>
<style>
  /* ====== mh-portal — 사도 중심 hero (12 그리드) ====== */
  .mh-portal {
    min-height: 100vh;
    padding: clamp(48px, 8vw, 96px) clamp(20px, 5vw, 64px) clamp(48px, 8vw, 96px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(40px, 6vw, 72px);
    position: relative;
  }
  .mh-portal__head {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }
  .mh-portal__title {
    font-family: var(--mh-serif, 'Cormorant Garamond', 'Times New Roman', serif);
    font-weight: 500;
    font-size: clamp(38px, 5vw, 60px);
    letter-spacing: -0.01em;
    line-height: 1.1;
    margin: 0 0 14px;
    color: var(--mh-ink, #0e0e0c);
  }
  .mh-portal__tag {
    font-size: clamp(15px, 1.4vw, 18px);
    color: rgba(14,14,12,0.62);
    line-height: 1.6;
    margin: 0 0 18px;
  }
  .mh-portal__tag em { color: rgba(14,14,12,0.45); }
  .mh-portal__lede {
    font-size: clamp(14px, 1.1vw, 15px);
    color: rgba(14,14,12,0.55);
    margin: 0;
    font-style: italic;
  }

  .mh-portal__grid {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 1100px;
    width: 100%;
    margin-left: auto;
    margin-right: auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: rgba(14,14,12,0.1);
    border: 1px solid rgba(14,14,12,0.1);
  }
  @media (max-width: 920px) {
    .mh-portal__grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 640px) {
    .mh-portal__grid { grid-template-columns: repeat(2, 1fr); }
  }
  .mh-portal__cell { background: var(--mh-paper, #f5f1e8); }
  .mh-portal__tile {
    display: flex;
    flex-direction: column;
    padding: clamp(20px, 2.5vw, 32px) clamp(16px, 2vw, 24px);
    min-height: 180px;
    color: inherit;
    text-decoration: none;
    transition: background 0.22s ease, transform 0.22s ease, border-color 0.22s ease;
    position: relative;
    overflow: hidden;
    border-left: 3px solid transparent;
  }
  /* Wave 7: portal_tile_hover EXTEND — KG: CONTRACT_PortalTileHover_v1, span-atomic-portal-tile-hover-2026-05-22 */
  /* family-color hint via data-apostle-id (12 사도 매핑) */
  .mh-portal__tile[data-apostle-id="1"]  { border-left-color: #6366f1; }  /* dimension-walker · OTel */
  .mh-portal__tile[data-apostle-id="2"]  { border-left-color: #ef4444; }  /* ICE ORCA DRAGON · TOE */
  .mh-portal__tile[data-apostle-id="3"]  { border-left-color: #94a3b8; }  /* superhollow-knight · OPEN */
  .mh-portal__tile[data-apostle-id="4"]  { border-left-color: #f59e0b; }  /* bhgman · Harness */
  .mh-portal__tile[data-apostle-id="5"]  { border-left-color: #10b981; }  /* spacegirl · Longinus */
  .mh-portal__tile[data-apostle-id="6"]  { border-left-color: #06b6d4; }  /* great-river · flow */
  .mh-portal__tile[data-apostle-id="7"]  { border-left-color: #8b5cf6; }  /* liquest-tree · Type */
  .mh-portal__tile[data-apostle-id="8"]  { border-left-color: #f97316; }  /* orbital-cloud · k8s */
  .mh-portal__tile[data-apostle-id="9"]  { border-left-color: #fbbf24; }  /* jesus · 신학 */
  .mh-portal__tile[data-apostle-id="10"] { border-left-color: #475569; }  /* gipbajon · GC */
  .mh-portal__tile[data-apostle-id="11"] { border-left-color: #ec4899; }  /* hoh · Heaven */
  .mh-portal__tile[data-apostle-id="12"] { border-left-color: #64748b; }  /* monsoon · Disenchantment */

  .mh-portal__tile:hover {
    background: rgba(14,14,12,0.035);
    transform: translateY(-2px);
  }
  .mh-portal__tile:hover .mh-portal__name {
    text-decoration: underline;
    text-decoration-color: rgba(14,14,12,0.3);
    text-underline-offset: 4px;
  }
  /* essence preview tooltip — hover 시 노출, prefers-reduced-motion 시 정적 */
  .mh-portal__essence-preview {
    display: block;
    margin-top: 8px;
    font-size: 11px;
    line-height: 1.45;
    color: rgba(14,14,12,0.42);
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height 0.32s ease, opacity 0.28s ease, margin-top 0.32s ease;
  }
  .mh-portal__tile:hover .mh-portal__essence-preview,
  .mh-portal__tile:focus-visible .mh-portal__essence-preview {
    max-height: 90px;
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .mh-portal__tile { transition: none; }
    .mh-portal__essence-preview { transition: none; }
    .mh-portal__tile:hover { transform: none; }
  }
  .mh-portal__num {
    font-family: var(--mh-serif, 'Cormorant Garamond', serif);
    font-style: italic;
    font-size: 19px;
    color: var(--mh-red, #7a1f1f);
    line-height: 1;
    margin-bottom: 14px;
    letter-spacing: 0.02em;
  }
  .mh-portal__icon {
    display: block;
    font-size: clamp(24px, 2.4vw, 30px);
    line-height: 1;
    opacity: 0.42;
    margin-bottom: 18px;
    color: rgba(14,14,12,0.7);
  }
  .mh-portal__name {
    font-family: var(--mh-serif, 'Cormorant Garamond', serif);
    font-weight: 500;
    font-size: clamp(18px, 1.6vw, 22px);
    line-height: 1.2;
    letter-spacing: -0.005em;
    margin-bottom: 6px;
  }
  .mh-portal__epithet {
    font-size: 13px;
    color: rgba(14,14,12,0.55);
    line-height: 1.5;
    font-style: italic;
    margin-top: auto;
  }
  .mh-portal__open {
    position: absolute;
    top: 14px;
    right: 14px;
    font-size: 9px;
    letter-spacing: 0.1em;
    color: #8a4d00;
    background: #fce7c4;
    padding: 2px 6px;
    border-radius: 2px;
    text-transform: uppercase;
  }

  .mh-portal__hint {
    text-align: center;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(14,14,12,0.4);
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }
  .mh-portal__chevron {
    font-size: 16px;
    animation: mh-bounce 2.4s ease-in-out infinite;
  }
  @keyframes mh-bounce {
    0%, 100% { transform: translateY(0); opacity: 0.35; }
    50% { transform: translateY(4px); opacity: 0.7; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mh-portal__chevron { animation: none; }
  }

  /* mh-guide — 페이지 사이트맵 (서문 직후) */
  .mh-guide {
    max-width: 720px;
    margin: 56px auto 0;
    border-top: 1px solid rgba(14,14,12,0.1);
    border-bottom: 1px solid rgba(14,14,12,0.1);
  }
  .mh-guide ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }
  .mh-guide li {
    border-right: 1px solid rgba(14,14,12,0.08);
    border-bottom: 1px solid rgba(14,14,12,0.08);
  }
  .mh-guide li:nth-child(2n) { border-right: 0; }
  .mh-guide li:nth-child(n+3) { border-bottom: 0; }
  .mh-guide a {
    display: block;
    padding: 22px 24px;
    text-decoration: none;
    color: inherit;
    transition: background 0.2s;
  }
  .mh-guide a:hover { background: rgba(14,14,12,0.03); }
  .mh-guide a > span:first-child {
    display: block;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(14,14,12,0.45);
    margin-bottom: 8px;
  }
  .mh-guide em {
    font-family: var(--mh-serif, Georgia, serif);
    font-style: italic;
    font-size: 26px;
    color: rgba(14,14,12,0.92);
    line-height: 1.2;
  }
  .mh-guide__hint {
    display: block;
    margin-top: 6px;
    font-size: 12px;
    color: rgba(14,14,12,0.5);
  }
  @media (max-width: 560px) {
    .mh-guide ol { grid-template-columns: 1fr; }
    .mh-guide li { border-right: 0 !important; border-bottom: 1px solid rgba(14,14,12,0.08); }
    .mh-guide li:last-child { border-bottom: 0; }
  }
</style>
<!-- KG: ATOM_Landing_CosmosRefactor — inline style extracted to landing.css -->

<script>
  // KG: ATOM_Landing_AxiomVisual, ATOM_Landing_ApostleVisual, ATOM_Landing_ConceptProgram
  // IntersectionObserver for scroll-reveal animations
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (e.isIntersecting) {
        e.target.classList.add('is-visible');
        io.unobserve(e.target);
      }
    }
  }, { threshold: 0.15 });
  document.querySelectorAll('.mh-verse, .mh-apostle, .mh-concept, .mh-program').forEach(el => io.observe(el));
</script>
