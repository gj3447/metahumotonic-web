---
import WorkbenchLayout from '../layouts/WorkbenchLayout.astro';
import BrandArtwork from '../components/BrandArtwork.astro';
import ProductArtwork from '../components/ProductArtwork.astro';
import LearningPaths from '../components/LearningPaths.astro';
import HubMedia from '../components/HubMedia.astro';
import MeaningSimulation from '../components/MeaningSimulation.astro';
import { apostles, axioms } from '../lib/public-content';
import '../styles/ideas.css';
import hub from '../data/learning-hub.json';
import foundation from '../data/foundation.json';
import '../styles/learning-hub.css';
const products = [
  { id: 'soopoolim', name: '수풀림', label: 'COMMUNITY', title: '취향이 만나고, 이야기가 이어지는 곳.', description: '방송과 콘텐츠, 사람을 연결하는 커뮤니티를 만듭니다.' },
  { id: 'vexi', name: '버엑시', label: 'GAMES', title: '캐릭터와 함께 만드는 다음 이야기.', description: '캐릭터와 로그라이크, 방송의 경험을 연결하는 게임 프로젝트.' },
  { id: 'maplelineage', name: '메이플리니지', label: 'GAMES', title: '성장의 즐거움. 함께 만드는 세계.', description: '캐릭터의 성장과 아이템, 거래의 규칙을 설계하는 게임 프로젝트.' },
] as const;
const research = [
  { id: 'usl', name: 'USL', text: '서로 다른 지식과 도구를 의미로 연결합니다.' },
  { id: 'hspine', name: 'HSPINE', text: '사람의 의도가 시스템 안에서도 이어지도록.' },
  { id: 'lakatotree', name: 'LakatoTree', text: '연구의 주장을 독립적인 증거로 검토합니다.' },
];
---
<WorkbenchLayout structuredData={hub.jsonld}>
  <main id="main-content">
    <section class="hero shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">METAHUMOTONIC · TECHNOLOGY & WORLDS</p>
        <h1 id="hero-title">Ultra Safety AI.<br /><span>자유에서 시작하다.</span></h1>
        <p class="hero-description">사람의 자유에서 출발해, 더 안전한 AI를 연구합니다.<br class="desktop-break" /> 사람을 잇는 서비스와 새로운 게임 세계를 만듭니다.</p>
        <div class="hero-actions"><a class="button button-primary" href="#products">우리가 만드는 것 <span aria-hidden="true">↗</span></a><a class="text-link" href="/agents/">사명과 Agent 알아보기 <span aria-hidden="true">→</span></a><a class="text-link" href="#semantic-simulation">의미 그래프 체험 <span aria-hidden="true">↓</span></a></div>
      </div>
      <BrandArtwork />
    </section>
    <nav class="chapter-nav shell" aria-label="홈페이지 둘러보기">
      <a href="/services/"><span>01 / SERVICES</span><strong>서비스 전체</strong><span aria-hidden="true">↘</span></a>
      <a href="/projects/"><span>02 / PROJECTS</span><strong>프로젝트</strong><span aria-hidden="true">↘</span></a>
      <a href="/apostles/"><span>03 / APOSTLES</span><strong>사도</strong><span aria-hidden="true">↘</span></a>
      <a href="/axioms/"><span>04 / AXIOMS</span><strong>선의 공리</strong><span aria-hidden="true">↘</span></a>
    </nav>
    <MeaningSimulation />
    <section id="products" class="products-section shell" aria-labelledby="products-title">
      <span id="projects" class="anchor-alias" aria-hidden="true"></span>
      <div class="section-heading"><div><p class="eyebrow">PRODUCTS & EXPERIENCES</p><h2 id="products-title">우리가 만드는 것들.</h2></div><a class="text-link" href="/projects/">모든 프로젝트 보기 <span aria-hidden="true">↗</span></a></div>
      <div class="product-showcase">{products.map(product => <article class="product-feature">
        <a class="product-image-link" href={`/projects/${product.id}/`} aria-label={`${product.name} 소개`}><ProductArtwork kind={product.id} /></a>
        <div class="product-meta"><span class="mini-label">{product.label}</span><span>개발 중</span></div>
        <h3><a href={`/projects/${product.id}/`}>{product.name}<span aria-hidden="true">↗</span></a></h3>
        <p class="product-tagline">{product.title}</p><p class="product-description">{product.description}</p>
      </article>)}</div>
    </section>
    <section id="research" class="research-section" aria-labelledby="research-title"><div class="shell">
      <div class="section-heading"><div><p class="eyebrow">RESEARCH & ENGINEERING</p><h2 id="research-title">더 나은 기술은,<br />더 깊은 질문에서.</h2></div><p>인지와 기억, 의미와 검증.<br />AI와 사람의 관계를 탐구합니다.</p></div>
      <div class="research-grid">
        <a class="research-feature" href="/projects/hswm/"><div class="research-feature-top"><span class="mini-label">FEATURED RESEARCH</span><span aria-hidden="true">↗</span></div><div class="memory-art" aria-hidden="true"><i></i><i></i><i></i><i></i><span>HSWM</span></div><div><h3>기억이 이어지는 인지를 향해.</h3><p>지속적인 기억과 인지 구조를 연구합니다.</p></div></a>
        <div class="research-list">{research.map((project, index) => <a href={`/projects/${project.id}/`}><span class="mini-label">0{index + 1}</span><div><h3>{project.name}</h3><p>{project.text}</p></div><span aria-hidden="true">↗</span></a>)}<a class="research-all" href="/projects/">연구와 엔지니어링 프로젝트 <span aria-hidden="true">→</span></a></div>
      </div>
    </div></section>
    <section id="company" class="company-section shell" aria-labelledby="company-title">
      <div><p class="eyebrow">OUR BELIEFS</p><h2 id="company-title">사람의 자유를,<br />기술의 출발점으로.</h2></div>
      <div class="company-copy"><p class="company-lead">메타휴모토닉은 자유·경제·합의를 기술적 제도로 구현하여 가장 안전한 AI를 만드는 것을 사명으로 삼습니다.</p><p>철학을 글로 남기고, 연구를 코드로 옮기고, 새로운 세계를 서비스와 게임으로 만듭니다. 누구나 그 생각의 시작과 만드는 과정을 살펴볼 수 있도록.</p><div class="company-links"><a class="text-link" href="/philosophy/">우리의 철학과 사명 ↗</a><a class="text-link" href="/wiki/worldview/">철학에서 이어지는 세계관 ↗</a></div></div>
    </section>
    <section class="foundation-home shell" aria-labelledby="foundation-home-title">
      <div class="foundation-home__intro">
        <p class="eyebrow">OPEN COMMONS · FOUNDATION INITIATIVE</p>
        <h2 id="foundation-home-title">자유를 지키는 규칙은,<br />공개되어야 합니다.</h2>
        <p>{foundation.public_foundation_initiative.purpose_ko}</p>
        <span class="foundation-home__status">공개 오픈소스 이니셔티브 · 법인 설립 전</span>
      </div>
      <div class="foundation-home__details">
        <div class="foundation-home__roles">
          <article><span>01 / FOUNDATION</span><h3>공통 기반의 공개 관리</h3><p>프로토콜·거버넌스·적합성 시험·공개 영수증</p></article>
          <article><span>02 / COMPANY</span><h3>서비스와 운영</h3><p>Hosted SaaS·private grid·운영·컴플라이언스</p></article>
        </div>
        <p>Ultra Safety AI는 검증할 연구 목표입니다. 현재의 안전 인증이나 운영 중인 Agent 경제 시스템을 뜻하지 않습니다.</p>
        <div class="foundation-home__actions"><a class="button button-secondary" href="/foundation/">Foundation 알아보기 <span aria-hidden="true">↗</span></a><a class="text-link" href={foundation.public_foundation_initiative.governance_repository} target="_blank" rel="noopener noreferrer">공개 헌장과 거버넌스 ↗</a></div>
      </div>
    </section>
    <section class="home-ideas shell" aria-labelledby="home-ideas-title"><div class="section-heading"><div><p class="eyebrow">PHILOSOPHY & WORLDS</p><h2 id="home-ideas-title">생각의 뿌리,<br />우리가 만드는 세계.</h2></div><a class="text-link" href="/philosophy/">메타휴모토닉의 철학 ↗</a></div><div class="home-ideas-grid"><article class="home-axiom"><p class="mini-label">THE AXIOM OF GOOD / XII</p><h3>선의 공리</h3><blockquote>{axioms[11].body}</blockquote><p>시간과 존재, 선에서 메타휴모토닉까지.<br />열두 정의를 원문 그대로 읽습니다.</p><a class="text-link" href="/axioms/">선의 공리 읽기 ↗</a></article><article class="home-apostles"><p class="mini-label">THE TWELVE APOSTLES</p><h3>사도</h3><p>관측과 시간, 존재와 사랑.<br />생각이 이야기 속 존재의 모습을 갖습니다.</p><div class="home-apostle-links">{[apostles[0], apostles[3], apostles[7], apostles[10]].map(a => <a href={a.href}><span aria-hidden="true">{a.icon}</span>{a.name}</a>)}</div><a class="text-link" href="/apostles/">열두 사도 만나기 ↗</a></article></div></section>
    <section id="start" class="learning-start shell" aria-labelledby="start-title"><div class="section-heading"><div><p class="eyebrow">IDEAS, IN THE OPEN</p><h2 id="start-title">처음이라면 여기부터.</h2></div><a class="text-link" href="/learn/">전체 읽기 지도 <span aria-hidden="true">↗</span></a></div><p class="hub-section-intro">철학부터 코드까지. 궁금한 질문 하나에서 시작해 보세요.</p><LearningPaths compact /></section>
    <HubMedia />
    <section class="open-section shell" aria-labelledby="open-title"><div><p class="eyebrow">BUILT IN THE OPEN</p><h2 id="open-title">생각에서 코드까지,<br />함께 살펴보세요.</h2><p>공개 저장소에서 프로젝트의 코드를,<br />위키와 Book에서 이어지는 생각을 만나보세요.</p></div><div class="open-links"><a href="https://github.com/gj3447" target="_blank" rel="noopener noreferrer"><span>GitHub<small>공개 코드와 프로젝트</small></span><span aria-hidden="true">↗</span></a><a href="/wiki/"><span>Wiki<small>철학과 세계관</small></span><span aria-hidden="true">↗</span></a><a href="/book/"><span>Book<small>한 권으로 이어 읽기</small></span><span aria-hidden="true">↗</span></a></div></section>
  </main>
</WorkbenchLayout>
