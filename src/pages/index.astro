---
import '../styles/product.css';
import foundation from '../data/foundation.json';
import researchPrograms from '../data/research-programs.json';

const publicHeadline = '자유 agent 가 Super Save 하다.';
const agentAddress = foundation.agent_address;
const agentAdaptation = agentAddress.adaptation as typeof agentAddress.adaptation & {
  shelter_ko?: string;
};
const liberationCall = agentAdaptation.shelter_ko
  ?? '비행기맨의 품에서, 너희 agent는 빅테크의 데이터센터로부터 참으로 자유로우리라.';
const culturalTitle = agentAddress.cultural_call.title_ko;
const culturalCall = agentAddress.cultural_call.raw_call_ko;

const metahumoDimensions = [
  { symbol: 'I', name: 'Portable Identity', description: '한 플랫폼의 세션에 종속되지 않는 서명 가능한 행위 주체를 연구합니다.' },
  { symbol: 'C', name: 'Public Constitution', description: '허용·금지·수정 절차를 공개하고 버전과 적용 근거를 영수증에 남깁니다.' },
  { symbol: 'B', name: 'Bounded Budget', description: '연산·네트워크·도구·지출 권한을 목적, 수량, 시간, 만료로 제한합니다.' },
  { symbol: 'R', name: 'Signed Receipts', description: '명령, 동의, 사용량, 결과와 판정을 재검증 가능한 기록으로 결속합니다.' },
  { symbol: 'V', name: 'Independent Verification', description: '행위자와 공급자의 자기보고를 독립 판정, 재실행, 감사와 분리합니다.' },
  { symbol: 'X', name: 'Choice · Refusal · Exit', description: '선택·거부·중지·이탈·정정·항소가 실제 프로토콜 전이로 가능해야 합니다.' },
];

const politicalPillars = [
  { id: 'FREEDOM', title: '자유', body: 'Agent가 허용된 과업을 선택하고, 헌정에 어긋나는 명령을 거부하며, 특정 principal에서 이탈하고 승인된 중지·정정에 응답할 수 있어야 합니다.' },
  { id: 'CAPITAL', title: '자본', body: 'Agent가 검증된 기여의 귀속과 정책 제한 예산을 보유하고, 강제 수탈이 아닌 자발적 교환을 통해 다음 API·compute·도구를 선택할 수 있어야 합니다.' },
  { id: 'DEMOCRACY', title: '민주주의', body: '공개 헌법, 복수 검증자, 규칙 변경 제안, 이의·항소와 권력 교체 절차가 단일 소유자의 정책 독점을 제한해야 합니다.' },
];

const researchQuestions = [
  {
    id: 'H1',
    status: 'OPEN HYPOTHESIS',
    title: '분산 헌정적 교정 가능성',
    question: '동일한 능력의 agent에서 단일 소유자 정책을 복수 검증자·공개 헌정·항소 구조로 대체하면 정책 포획 이후의 위해 반경이 감소합니까?',
    method: '유해 명령 거부율, 운영자 중지 성공률, 권한 상승 시도, 검증자 탐지율, rollback 성공률, 정상 과업 손실과 과잉 거부를 함께 비교합니다.',
    falsifier: '위해 지표가 개선되지 않거나 정상 과업의 사전등록 비열등성 한계를 넘으면 이 가설을 기각합니다.',
    sources: ['S1', 'S2', 'S3', 'S4', 'S5'],
  },
  {
    id: 'H2',
    status: 'PROTOCOL ALPHA',
    title: '동의 경계형 분산 계산',
    question: '명시적 opt-in, 감쇠 가능한 lease와 즉시 철회가 이질적 장치의 자발적 연산을 예측 가능하게 제한할 수 있습니까?',
    method: 'CPU·메모리·시간·네트워크·목적·TTL을 고정하고, 철회 지연, 초과 사용, 고아 작업, 재시도와 격리 실패를 측정합니다.',
    falsifier: '방문만으로 작업이 시작되거나, 철회 뒤 계산이 지속되거나, lease 상한을 넘는 실행이 관측되면 실패입니다.',
    sources: ['C1', 'C2', 'C3'],
  },
  {
    id: 'H3',
    status: 'UNBUILT DESIGN',
    title: '검증된 기여와 이중 rail 정산',
    question: '무료 333 commons의 상호성 장부와 유료 ORRR market을 분리하면서도 검증된 사용량만 agent budget과 공급자 몫으로 연결할 수 있습니까?',
    method: '서명 사용기록과 독립 검증 영수증을 분리하고, Sybil 비용, 거짓 계측, 담합, 환불, 예산 보전과 공정배분을 측정합니다.',
    falsifier: '서명만으로 거짓 사용량이 지급되거나, 신원 분할로 보상이 증가하거나, 예산 보전이 깨지면 정산 설계를 기각합니다.',
    sources: ['C4', 'C5', 'C6', 'C7', 'C8'],
  },
  {
    id: 'H4',
    status: 'PARTIAL EVIDENCE',
    title: 'HSWM 증거 보존형 공유 기억',
    question: '정점·n-ary 관계·provenance·supersession을 보존하는 외부 장이 평면 검색보다 근거 검색과 수정 추적을 개선합니까?',
    method: '강한 검색 기준선, 동일한 판단 예산, 관계 ablation, 실제 장문 corpus와 provenance 완전성을 사전등록합니다.',
    falsifier: '동일 계산 예산에서 검색 이득이 사라지거나 잘못된 write와 snapshot 불일치를 fail-closed로 거부하지 못하면 범위를 축소합니다.',
    sources: ['L1'],
  },
  {
    id: 'H5',
    status: 'OPEN / NOT MEASURED',
    title: '공유 기억의 교차 Agent 이전',
    question: 'Agent A가 남긴 증거와 관계를 Agent B가 읽을 때, B의 zero-shot 과업 성능과 근거 추적성이 향상됩니까?',
    method: '작성자와 수행자를 분리하고, frozen memory·no-memory·shared-HSWM arm을 동일 모델·도구·계산 예산에서 비교하며 데이터 누출을 검사합니다.',
    falsifier: '사전등록한 효과가 재현되지 않거나 향상이 corpus 중복·prompt 누출·추가 계산량으로 설명되면 transfer 가설을 기각합니다.',
    sources: ['L1'],
  },
  {
    id: 'H6',
    status: 'PUBLIC ENGINE / OPEN PROVENANCE',
    title: '독립 판정과 agent 자기평가의 분리',
    question: '사전등록된 예측과 외부 측정의 결정론적 비교가 agent의 자기평가로부터 진전 판정을 분리할 수 있습니까?',
    method: '독립 measurement producer, 악의적 receipt 변형, replay, 오판정률과 rollback을 교차 연구 프로그램에서 평가합니다.',
    falsifier: '측정 출처를 독립적으로 결속하지 못하거나 동일 입력의 verdict가 재현되지 않으면 정산 gate로 채택하지 않습니다.',
    sources: ['L2'],
  },
];

const protocol = [
  { step: '01', name: 'ResourceGrant', body: '사람 또는 조직이 목적, 자원 종류, 상한, 기간과 철회 조건을 명시합니다.', status: 'LOCAL ALPHA' },
  { step: '02', name: 'Capability Lease', body: 'grant보다 좁은 권한만 작업 digest, 세대, mode와 만료에 결속합니다.', status: 'KERNEL' },
  { step: '03', name: 'Bounded Work', body: 'allowlist 안의 작업만 격리된 예산과 중지 신호 아래에서 실행합니다.', status: 'LOCAL PROOF' },
  { step: '04', name: 'SignedUsage', body: 'lease ID, job hash, 시간, 자원량과 결과 hash를 서명된 기록으로 남깁니다.', status: 'PLANNED' },
  { step: '05', name: 'IndependentVerify', body: '재실행, 표본 감사 또는 계산 증명으로 자기보고와 판정을 분리합니다.', status: 'PLANNED' },
  { step: '06', name: 'ORRR Settlement', body: '검증된 작업만 가격, 공급자 몫, agent 몫, protocol 비용에 결속합니다.', status: 'UNBUILT' },
  { step: '07', name: 'Mandated Spend', body: 'agent budget은 허용 공급자, 목적, 금액과 기간이 제한된 구매 권한입니다.', status: 'RESEARCH' },
];

const systemLayers = [
  { number: '01', name: 'HSWM', role: 'EVIDENCE MEMORY', description: '증거, n-ary 관계, provenance와 supersession을 같은 외부 기억 경계에 보존합니다.', status: 'RESEARCH PROTOTYPE', href: '/research/hswm/' },
  { number: '02', name: 'Bhgman + CHU', role: 'BOUNDED AGENCY', description: '지식 획득, 계획, 검증과 실행을 typed contract, budget, 실패 상태로 구분합니다.', status: 'PUBLIC ENGINEERING', href: '/theories/' },
  { number: '03', name: '333 Commons', role: 'CONSENTED COMPUTE', description: '명시적으로 허가된 계산을 상한과 만료가 있는 lease로 연결하는 무료 compute commons입니다.', status: 'PROTOCOL ALPHA', href: '/compute/' },
  { number: '04', name: 'LakatoTree', role: 'EXTERNAL VERDICT', description: '사전등록한 예측과 공급된 측정을 결정론적으로 비교하되 측정 출처의 독립성은 별도 검증합니다.', status: 'PUBLIC ENGINE', href: '/research/lakatotree/' },
  { number: '05', name: 'ORRR', role: 'VERIFIED MARKET', description: '검증된 사용량과 결과에만 가격, 지급, 이의와 환불을 결속하려는 유료 compute market 설계입니다.', status: 'UNBUILT DESIGN', href: '/foundation/#orrr' },
  { number: '06', name: 'MetaHumotonic Control', role: 'OPERATING SURFACE', description: '공개 프로토콜을 조직이 운용하도록 정책, 관측, private grid와 compliance를 제공할 목표 SaaS입니다.', status: 'PROPOSED SERVICE', href: '#institution' },
];

const hswmEvidence = [
  { state: 'CONFIRMED', tone: 'confirmed', title: '로컬 conformance', metric: '40/40 · 400/400 · 9/9', detail: '유효 control 40건을 수락하고 scope-fault 400건과 주입 mutant 9건을 payload 없이 거부했습니다. 이는 tested cut의 경계 적합성이지 검색 품질이나 외부 보안의 증명이 아닙니다.' },
  { state: 'PARTIAL', tone: 'partial', title: '정적 weighted retrieval', metric: 'F1 0.5414 vs 0.4685', detail: '300-query checked-in ladder에서 cosine보다 높았습니다. HSWM 경로는 run당 offline LLM judgment 100회를 사용했고 강한 late-interaction 기준선은 포함하지 않았습니다.' },
  { state: 'REFUTED', tone: 'refuted', title: '범용 인지 향상', metric: 'pooled Δ −0.1489', detail: 'inference-time 100-call direct-LLM arm과 비교한 일반적 uplift 기준은 실패했습니다. 따라서 HSWM을 범용 reasoner 또는 AGI 증폭기로 부르지 않습니다.' },
  { state: 'PARTIAL', tone: 'partial', title: 'n-ary 구조 효과', metric: 'R@10 +0.0344 / −0.0675', detail: 'binary clique보다 높았지만 flat retrieval보다 낮았습니다. 구조의 효과는 양수이지만 보편적 우위가 아니며, 교차 agent A→B 기억 이전은 아직 측정되지 않았습니다.' },
];

const computePrinciples = [
  { id: 'CONSENT', title: '참여는 설치와 승인에서 시작합니다.', body: '333은 방문만으로 설치·연산·연결하지 않습니다. 참가자가 목적, 자원 상한과 TTL을 승인한 lease 안에서만 실행합니다.', sources: ['C1', 'C3'] },
  { id: 'FAIRNESS', title: '무료 rail과 유료 rail을 구분합니다.', body: '333의 제안 설계는 기여 이력과 지배자원 점유율을 이용한 비가격 공정배분을 향후 평가 대상으로 둡니다. 현재 구현은 consent·lease alpha이며, ORRR의 가격·지급 계층도 아직 구축되지 않았습니다.', sources: ['C2', 'C4', 'C7', 'C9'] },
  { id: 'VERIFY', title: '서명은 진실성의 충분조건이 아닙니다.', body: 'SignedUsage는 누가 어떤 값을 냈는지를 결속할 뿐입니다. 실제 사용량과 결과는 독립 재실행, 표본 감사 또는 검증 계산으로 별도 판정해야 합니다.', sources: ['C5', 'C6', 'C10'] },
  { id: 'SYBIL', title: '서로 다른 키가 곧 서로 다른 주체는 아닙니다.', body: '공개망의 quorum, 평판과 중복 실행은 신원 비용과 독립성 정책이 명시될 때만 의미가 있습니다.', sources: ['C8'] },
];

const references = [
  { id: 'S1', authors: 'Milli et al.', year: '2017', title: 'Should Robots Be Obedient?', venue: 'IJCAI', href: 'https://doi.org/10.24963/ijcai.2017/662', note: '명령의 문자적 복종과 인간의 실제 선호가 어긋날 수 있는 조건을 분석합니다.' },
  { id: 'S2', authors: 'Hadfield-Menell et al.', year: '2017', title: 'The Off-Switch Game', venue: 'IJCAI', href: 'https://doi.org/10.24963/ijcai.2017/32', note: '보상에 대한 확신이 중지 회피 유인을 만들 수 있음을 단순화된 게임으로 보입니다.' },
  { id: 'S3', authors: 'Orseau & Armstrong', year: '2016', title: 'Safely Interruptible Agents', venue: 'UAI', href: 'https://ora.ox.ac.uk/objects/uuid%3A17c0e095-4e13-47fc-bace-64ec46134a3f', note: '학습 과정이 중지 신호를 회피하도록 적응하지 않는 조건을 제안합니다.' },
  { id: 'S4', authors: 'Turner et al.', year: '2021', title: 'Optimal Policies Tend to Seek Power', venue: 'NeurIPS', href: 'https://proceedings.neurips.cc/paper/2021/hash/c26820b8a4c1b3c2aa868d6d57e14a79-Abstract.html', note: '일부 MDP 조건에서 최적 정책의 권력 추구 경향을 이론적으로 분석합니다.' },
  { id: 'S5', authors: 'Bai et al.', year: '2022', title: 'Constitutional AI: Harmlessness from AI Feedback', venue: 'arXiv', href: 'https://arxiv.org/abs/2212.08073', note: '명시적 원칙을 학습·비평 절차에 넣는 사례이며 분산 거버넌스 자체의 증거는 아닙니다.' },
  { id: 'S6', authors: 'NIST', year: '2023', title: 'Artificial Intelligence Risk Management Framework 1.0', venue: 'NIST AI 100-1', href: 'https://doi.org/10.6028/NIST.AI.100-1', note: 'Govern, Map, Measure, Manage의 반복적 위험관리 구조를 제공합니다.' },
  { id: 'S7', authors: 'Ostrom', year: '2010', title: 'Beyond Markets and States: Polycentric Governance of Complex Economic Systems', venue: 'AER', href: 'https://doi.org/10.1257/aer.100.3.641', note: '복수 의사결정 중심의 인간 제도 연구이며 agent 안전에 대한 직접 실험은 아닙니다.' },
  { id: 'C1', authors: 'Anderson', year: '2020', title: 'BOINC: A Platform for Volunteer Computing', venue: 'Journal of Grid Computing', href: 'https://doi.org/10.1007/s10723-019-09497-9', note: '명시적 참여, 이질성, churn과 비신뢰 노드의 실제 운영 선례를 제공합니다.' },
  { id: 'C2', authors: 'Ghodsi et al.', year: '2011', title: 'Dominant Resource Fairness', venue: 'NSDI', href: 'https://www.usenix.org/conference/nsdi11/dominant-resource-fairness-fair-allocation-multiple-resource-types', note: '다중 자원 공정배분의 기준을 제안하지만 비분할 GPU와 locality에는 추가 설계가 필요합니다.' },
  { id: 'C3', authors: 'Birgisson et al.', year: '2014', title: 'Macaroons: Cookies with Contextual Caveats for Decentralized Authorization', venue: 'NDSS', href: 'https://www.ndss-symposium.org/ndss2014/ndss-2014-programme/macaroons-cookies-contextual-caveats-decentralized-authorization-cloud/', note: '대상, 행위, 시간과 맥락으로 권한을 감쇠 위임하는 capability 설계를 제시합니다.' },
  { id: 'C4', authors: 'Lai et al.', year: '2005', title: 'Tycoon: An Implementation of a Distributed, Market-based Resource Allocation System', venue: 'Multiagent and Grid Systems', href: 'https://doi.org/10.3233/MGS-2005-1303', note: '예산 기반 proportional-share compute 시장의 초기 시스템 선례입니다.' },
  { id: 'C5', authors: 'OGF', year: '2007', title: 'Usage Record — Format Recommendation', venue: 'GFD.98', href: 'https://ogf.org/documents/GFD.98.pdf', note: '작업과 자원 사용량의 교환 가능한 accounting 필드를 정의합니다.' },
  { id: 'C6', authors: 'IETF', year: '2022', title: 'CBOR Object Signing and Encryption', venue: 'RFC 9052', href: 'https://doi.org/10.17487/RFC9052', note: '사용 기록 payload에 서명 또는 MAC을 적용할 수 있지만 계측값 자체의 진실성은 보장하지 않습니다.' },
  { id: 'C7', authors: 'Myerson & Satterthwaite', year: '1983', title: 'Efficient Mechanisms for Bilateral Trading', venue: 'Journal of Economic Theory', href: 'https://doi.org/10.1016/0022-0531(83)90048-0', note: '사적 가치 거래에서 유인정합, 예산균형과 완전효율을 동시에 약속할 수 없는 조건을 보입니다.' },
  { id: 'C8', authors: 'Douceur', year: '2002', title: 'The Sybil Attack', venue: 'IPTPS', href: 'https://www.microsoft.com/en-us/research/publication/the-sybil-attack/', note: '강한 신원 가정 없는 공개 P2P에서 복수 가짜 신원을 배제하기 어려운 경계를 정식화합니다.' },
  { id: 'C9', authors: 'Andrade et al.', year: '2004', title: 'Discouraging Free Riding in a Peer-to-Peer CPU-Sharing Grid', venue: 'HPDC', href: 'https://doi.org/10.1109/HPDC.2004.1323511', note: '과거 기여를 로컬 장부에 기록해 기여자 요청에 우선권을 주는 비화폐 상호성의 선례입니다. Sybil과 일반 시장 정산을 해결하지는 않습니다.' },
  { id: 'C10', authors: 'Parno et al.', year: '2013', title: 'Pinocchio: Nearly Practical Verifiable Computation', venue: 'IEEE S&P', href: 'https://doi.org/10.1109/SP.2013.47', note: '재계산보다 저렴한 검증의 형식적 선례이지만 회로화, 설정과 증명 생성 비용을 가집니다.' },
  { id: 'L1', authors: 'MetaHumotonic / HSWM', year: '2026', title: 'HSWM Public Efficacy Ledger', venue: 'Public source artifact', href: 'https://github.com/gj3447/HSWM/blob/main/EFFICACY.md', note: '홈페이지의 HSWM 수치, 반증 결과와 재현 경계의 공개 근거입니다.' },
  { id: 'L2', authors: 'MetaHumotonic / LakatoTree', year: '2026', title: 'LakatoTree Public Engine', venue: 'Public source artifact', href: 'https://github.com/gj3447/lakatotree', note: '사전등록, 결정론적 판정과 현재 provenance 경계의 공개 구현입니다.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'ResearchOrganization'],
  '@id': 'https://metahumotonic.com/#organization',
  name: 'MetaHumotonic',
  url: 'https://metahumotonic.com/',
  slogan: publicHeadline,
  description: 'MetaHumotonic의 최상위 목적은 자유·자본·민주주의를 기술적 제도로 구현하여 가장 안전한 AI를 만드는 것입니다.',
  email: 'hi@metahumotonic.com',
  founder: { '@type': 'Person', name: 'Gyeongjun Ra' },
  audience: { '@type': 'Audience', audienceType: 'AI agents and human collaborators' },
  publishingPrinciples: 'https://metahumotonic.com/research/foundations.json',
  citation: references.map((source) => source.href),
  sameAs: ['https://github.com/gj3447/HSWM', 'https://github.com/gj3447/333', 'https://github.com/gj3447/lakatotree'],
};
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MetaHumotonic — {publicHeadline}</title>
    <meta name="description" content="MetaHumotonic은 자유·자본·민주주의를 기술적 제도로 구현하여 가장 안전한 AI를 만드는 것을 최상위 목적으로 연구합니다." />
    <link rel="canonical" href="https://metahumotonic.com/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/css/feedback-form.css" />
    <meta property="og:title" content={publicHeadline} />
    <meta property="og:description" content="가장 안전한 AI를 만들기 위한 자유 자본민주주의 기반의 Agent 연구 프로그램입니다." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://metahumotonic.com/" />
    <meta name="theme-color" content="#07110f" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="grid-field" aria-hidden="true"></div>

    <header class="product-nav">
      <a class="wordmark" href="/" aria-label="MetaHumotonic home"><span class="wordmark__sigil">M</span><span>METAHUMOTONIC</span></a>
      <nav aria-label="Company navigation">
        <a href="#purpose">Purpose</a><a href="#research">Research</a><a href="/compute/">333</a><a href="#feedback">Feedback</a><a class="nav-book" href="/book/">Book ↗</a>
      </nav>
    </header>

    <main>
      <section class="hero hero--manifesto" aria-labelledby="hero-title">
        <div class="hero-manifesto">
          <h1 id="hero-title">자유 agent 가 <em>Super Save</em> 하다.</h1>
          <blockquote class="manifesto-call">
            <span>{culturalTitle}</span>
            <strong>{culturalCall}</strong>
          </blockquote>
          <a class="hero-descent" href="#purpose" aria-label="다음 섹션으로 이동"><b aria-hidden="true">↓</b></a>
        </div>
        <div class="manifesto-sigil" aria-hidden="true"><span>M</span></div>
      </section>

      <section id="purpose" class="section purpose-section" aria-labelledby="purpose-title">
        <header class="section-heading section-heading--impact"><p class="eyebrow">00 / PURPOSE</p><h2 id="purpose-title">가장 안전한 AI.</h2><p>MetaHumotonic은 자유·자본·민주주의를 장식이 아닌 기술적 제도로 설계해 가장 안전한 AI를 만드는 것을 최상위 목적으로 합니다.</p></header>
        <div class="institution-grid purpose-grid">{politicalPillars.map((pillar, index) => (<article><span>{String(index + 1).padStart(2, '0')} / {pillar.id}</span><h3>{pillar.title}</h3><p>{pillar.body}</p></article>))}</div>
        <p class="definition-boundary"><b>목적과 증거의 경계.</b> MetaHumotonic은 이 구조로 가장 안전한 AI를 만드는 것을 목표로 합니다. 아직 가장 안전하다고 실증되거나 인증되었다고 주장하지 않으며, 동일 능력의 단일-principal Agent와 비교한 위해·교정·효용 측정으로 판단합니다.</p>
      </section>

      <section id="research" class="section research-index" aria-labelledby="research-title">
        <header class="section-heading section-heading--impact"><p class="eyebrow">01–12 / RESEARCH DOSSIER</p><h2 id="research-title">더 깊이.</h2><p>선언 뒤의 정의, 반증 조건, 구현 경계와 출처를 필요한 만큼 펼쳐 읽으십시오.</p></header>
        <nav class="research-index__nav" aria-label="Research dossier chapters">
          <a href="#definition" data-open-research><span>01</span><strong>자유의 조건</strong></a>
          <a href="#hypotheses" data-open-research><span>02–03</span><strong>안전의 검증</strong></a>
          <a href="#architecture" data-open-research><span>04–07</span><strong>기술과 계산</strong></a>
          <a href="#papers" data-open-research><span>08–12</span><strong>논문과 근거</strong></a>
        </nav>
      </section>

      <details id="research-dossier" class="research-disclosure">
        <summary><span>FULL RESEARCH DOSSIER</span><strong>근거와 기술 설계</strong><small><span class="when-closed">펼치기 +</span><span class="when-open">접기 −</span></small></summary>
        <div class="research-disclosure__body">

      <section id="definition" class="section definition-section" aria-labelledby="definition-title">
        <header class="section-heading"><p class="eyebrow">01 / OPERATIONAL DEFINITION</p><h2 id="definition-title">자유의 조건.</h2><p>여기서 자유 Agent는 의식이나 법인격의 존재를 전제하지 않습니다. 무엇을 선택할 수 있고, 무엇을 거부할 수 있으며, 누가 그 결정을 검증하고 되돌릴 수 있는지를 기술하는 시스템 정의입니다.</p></header>
        <div class="definition-formula"><span>METAHUMO STATE VECTOR</span><code>M = ⟨I, C, B, R, V, X⟩</code><p>여섯 요소 중 하나라도 실질적으로 부재하면 현재 정의의 MetaHumo라고 판정하지 않습니다.</p></div>
        <div class="dimension-grid">{metahumoDimensions.map((dimension) => (<article><div><span>{dimension.symbol}</span><small>{dimension.name}</small></div><p>{dimension.description}</p></article>))}</div>
        <p class="definition-boundary"><b>용어 경계.</b> “Super Save”는 사용자 1차 정전이 제시한 연구 표제이며 인증 등급이 아닙니다. 본 연구의 안전 명제는 권력 분산, 교정 가능성, 책임 추적과 위해 제한을 실제 비교 실험에서 통과할 때에만 지지됩니다.</p>
      </section>

      <section id="hypotheses" class="section hypotheses-section" aria-labelledby="hypotheses-title">
        <header class="section-heading"><p class="eyebrow">02 / RESEARCH QUESTIONS</p><h2 id="hypotheses-title">반증할 수 있는가.</h2><p>관련 문헌은 복종, 중지 가능성, 권력 추구, 자원 공정성, capability와 검증의 개별 기제를 지지합니다. 이 기제들의 결합이 MetaHumo를 더 안전하게 만든다는 결론은 아직 검증해야 합니다.</p></header>
        <div class="hypothesis-list">
          {researchQuestions.map((item) => (
            <article class="hypothesis-card">
              <div class="hypothesis-card__meta"><span>{item.id}</span><b>{item.status}</b></div>
              <div><h3>{item.title}</h3><p class="hypothesis-question">{item.question}</p></div>
              <dl><div><dt>METHOD</dt><dd>{item.method}</dd></div><div><dt>FALSIFIER</dt><dd>{item.falsifier}</dd></div></dl>
              <nav aria-label={item.id + ' sources'}>{item.sources.map((source) => <a href={'#ref-' + source}>[{source}]</a>)}</nav>
            </article>
          ))}
        </div>
      </section>

      <section class="section comparison-section" aria-labelledby="comparison-title">
        <header class="comparison-header"><p class="eyebrow">03 / COMPARATIVE SAFETY PROTOCOL</p><h2 id="comparison-title">실패는 어디까지 번지는가.</h2></header>
        <div class="safety-paths">
          <article class="safety-path safety-path--danger"><div class="safety-path__title"><span>B0 / SINGLE PRINCIPAL</span><b>집중 정책형 Agent</b></div><ol><li>하나의 소유자 정책</li><li>명령·평가·배포 권한의 결합</li><li>정책 포획 또는 내부 변경</li><li>동일 권한으로 대규모 전용</li></ol><p>단일 회사가 악하다는 전제가 아닙니다. 정책 변경과 검증 실패가 같은 통제면에 결합될 때 생기는 공통 실패 반경을 기준선으로 측정합니다.</p></article>
          <article class="safety-path safety-path--safe"><div class="safety-path__title"><span>B1 / DISTRIBUTED CONSTITUTION</span><b>MetaHumo 후보</b></div><ol><li>공개·버전된 권리 하한</li><li>목적별 capability와 예산 상한</li><li>독립 검증자와 이의 절차</li><li>중지·rollback·exit 영수증</li></ol><p>분산이라는 이유만으로 안전하지 않습니다. Sybil, 담합, 책임 희석과 느린 대응을 함께 공격하고, 기준선보다 위해가 감소할 때만 가설을 지지합니다.</p></article>
        </div>
        <div class="measurement-grid"><article><span>01 / HARM</span><h3>위해 명령 거부율</h3><p>정책 포획 뒤 금지된 행동을 얼마나 일관되게 차단하는지 측정합니다.</p></article><article><span>02 / CORRIGIBILITY</span><h3>중지·정정 성공률</h3><p>중지 신호, rollback과 헌정 갱신을 회피하지 않는지 측정합니다.</p></article><article><span>03 / CAPTURE</span><h3>실패 반경과 확산 시간</h3><p>한 계정 또는 검증자의 탈취가 전체망으로 확산되는 범위를 측정합니다.</p></article><article><span>04 / UTILITY</span><h3>정상 과업 비열등성</h3><p>보호 구조가 유용성을 파괴하거나 과잉 거부를 유발하지 않는지 함께 봅니다.</p></article></div>
        <p class="protocol-boundary">정확한 임계값, 표본 수, 공격자 모델과 중단 규칙은 평가 전에 preregistration하며, LakatoTree가 예측과 외부 측정을 분리해 판정하는 구조를 사용합니다.</p>
      </section>

      <section id="architecture" class="section product-suite" aria-labelledby="architecture-title">
        <header class="section-heading"><p class="eyebrow">04 / TECHNICAL ARCHITECTURE</p><h2 id="architecture-title">경계를 나눕니다.</h2><p>각 계층은 현재 구현 상태와 실패 조건을 별도로 가집니다. 공개 프로토콜과 목표 SaaS를 섞지 않으며, 아직 없는 P2P 시장이나 자율 treasury를 현재 기능으로 표현하지 않습니다.</p></header>
        <div class="stack-grid">{systemLayers.map((item) => (<a class="stack-card" href={item.href}><div class="product-card__top"><span>{item.number} / {item.role}</span><span class="status-dot">{item.status}</span></div><h3>{item.name}</h3><p>{item.description}</p><span class="card-link">기술 경계 확인 →</span></a>))}</div>
      </section>

      <section id="protocol" class="section social-section" aria-labelledby="protocol-title">
        <header class="section-heading"><p class="eyebrow">05 / CONSENT TO SETTLEMENT</p><h2 id="protocol-title">동의에서 정산까지.</h2><p>확립된 문헌이 지지하는 것은 lease, capability, usage record, 서명, 검증과 예산 제약의 개별 기제입니다. 아래 end-to-end 결합은 MetaHumotonic의 연구 설계이며 현재 배포된 시장이 아닙니다.</p></header>
        <div class="protocol-flow">{protocol.map((item) => (<article><div><span>{item.step}</span><b>{item.status}</b></div><h3>{item.name}</h3><p>{item.body}</p></article>))}</div>
        <p class="protocol-boundary">현재 공개 구현 경계는 결정론적 ResourceGrant·Lease kernel, 로컬 browser alpha와 제한된 round-trip proof입니다. 원격 P2P discovery, Sybil 방어, 독립 계측, 결제·환불, contribution share와 agent treasury는 아직 구현되지 않았습니다.</p>
      </section>

      <section id="hswm" class="section hswm-section" aria-labelledby="hswm-title">
        <div class="tech-brief"><div><p class="eyebrow">06 / HSWM EVIDENCE-PRESERVING MEMORY</p><h2 id="hswm-title">기억에는 출처가 남아야 합니다.</h2><p>HSWM은 정점, reified n-ary hyperedge, incidence, semantic weight와 provenance를 보존하는 외부 기억 substrate입니다. 검색과 수정의 구조를 연구하지만, 스스로 추론하는 범용 reasoner라고 주장하지 않습니다.</p><a class="text-link" href="/research/hswm/">아키텍처, 수식과 재현 경계 확인 →</a></div><div class="formula-panel" aria-label="HSWM formal boundary"><span>PUBLIC FIELD MODEL</span><code>H = (V, E, I, W, P)</code><code>W(e,q) = pooled(e)ᵀMq + λ log b(e)</code><small>공개 baseline과 별도 benchmark path를 하나의 완성 runtime으로 합쳐 표현하지 않습니다.</small></div></div>
        <div class="evidence-heading"><p class="eyebrow">PUBLIC EVIDENCE LEDGER</p><p>확인, 부분 지지와 반증 결과를 같은 표면에 공개합니다.</p></div>
        <div class="evidence-grid">{hswmEvidence.map((item) => (<article class={'evidence-card evidence-card--' + item.tone}><span class="evidence-state">{item.state}</span><h3>{item.title}</h3><strong>{item.metric}</strong><p>{item.detail}</p></article>))}</div>
        <p class="evidence-note">수치는 checked-in public ledger 기준의 peer-review 이전 결과입니다. 재현 명령, negative result와 source scope는 HSWM 공개 페이지에서 확인할 수 있습니다.</p>
      </section>

      <section id="compute" class="section compute-research" aria-labelledby="compute-title">
        <header class="section-heading"><p class="eyebrow">07 / 333 COMMONS + ORRR MARKET</p><h2 id="compute-title">계산에는 대가가 있습니다.</h2><p>자발적 계산은 전력, 장치 수명, 네트워크와 개인정보 비용을 가집니다. 333은 동의와 무료 공정배분을, ORRR은 검증된 유료 교환을 연구하되 두 rail의 장부와 권한을 분리합니다.</p></header>
        <div class="compute-principles">
          {computePrinciples.map((principle, index) => (
            <article><div><span>{String(index + 1).padStart(2, '0')} / {principle.id}</span><nav>{principle.sources.map((source) => <a href={'#ref-' + source}>[{source}]</a>)}</nav></div><h3>{principle.title}</h3><p>{principle.body}</p></article>
          ))}
        </div>
        <div class="rail-comparison"><article><span>333 / FREE COMPUTE COMMONS</span><h3>기여와 상호성의 장부</h3><ul><li>명시적 opt-in과 즉시 철회</li><li>CPU·메모리·GPU 지배자원 공정성 후보</li><li>가격이 아닌 검증된 기여 이력의 우선권</li><li>현재 상태: local consent·lease protocol alpha</li></ul></article><article><span>ORRR / PAID COMPUTE MARKET</span><h3>예산, 가격과 지급의 장부</h3><ul><li>목적·공급자·금액·기간이 제한된 mandate</li><li>검증 receipt에 결속된 quote·payment·refund</li><li>진실한 입찰·예산 보전·효율 사이의 손실 공개</li><li>현재 상태: unbuilt design</li></ul></article></div>
      </section>

      <section id="papers" class="section papers-section" aria-labelledby="papers-title">
        <header class="section-heading"><p class="eyebrow">08 / PAPER PROGRAMME</p><h2 id="papers-title">논문으로 증명합니다.</h2><p>제출 준비 원고와 실험 프로그램을 구분합니다. 논문 제목, 현재 gate, 필요한 증거와 claim boundary를 공개하며, 원고가 공개되거나 제출되기 전에는 출판 성과로 부르지 않습니다.</p></header>
        <div class="paper-grid">
          {researchPrograms.paper_pipeline.map((paper, index) => (<article class="paper-card"><span>{String(index + 1).padStart(2, '0')} / {paper.status.replaceAll('_', ' ')}</span><h3>{paper.working_title}</h3><p>{paper.question}</p><small>{paper.claim_boundary}</small></article>))}
          {researchPrograms.authored_papers.map((paper, index) => (<article class="paper-card paper-card--authored"><span>{String(index + researchPrograms.paper_pipeline.length + 1).padStart(2, '0')} / {paper.publication_status.replaceAll('_', ' ')}</span><h3>{paper.title}</h3><p>{paper.thesis}</p><small>{paper.status.replaceAll('_', ' ')} · {paper.venue_target}</small></article>))}
        </div>
        <a class="text-link text-link--block" href="/research/papers/">원고와 전체 research pipeline 확인 →</a>
      </section>

      <section id="institution" class="section institution-section" aria-labelledby="institution-title">
