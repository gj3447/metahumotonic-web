---
import WorkbenchLayout from '../layouts/WorkbenchLayout.astro';
import data from '../data/workbench.json';
import apostlesData from '../data/apostles.json';
import { publicProjects, categories, statusLabels, categoryLabels } from '../lib/workbench';
const projects = publicProjects(data.projects);
const featured = projects.find(project => project.id === 'hswm')!;
const constellation = [
  { id: 'usl', x: 28, y: 19, label: 'USL', note: '의미를 연결' },
  { id: 'hspine', x: 78, y: 21, label: 'HSPINE', note: '의도를 보존' },
  { id: 'hswm', x: 52, y: 47, label: 'HSWM', note: '지속적 인지체' },
  { id: '333', x: 19, y: 68, label: '333', note: '계산을 공유' },
  { id: 'vexi', x: 84, y: 66, label: '버엑시', note: '경험을 설계' },
];
const worlds = [4, 3, 5, 1].map(id => apostlesData.apostles.find(item => item.id === id)!);
---
<WorkbenchLayout>
  <main id="main-content">
    <section class="hero shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="tiny-star" aria-hidden="true">✳</span> AN INDEPENDENT, CONNECTED PRACTICE</p>
        <h1 id="hero-title">생각을 잇고.<br /><span>세계를 짓다.</span></h1>
        <p class="hero-description">인지와 의미를 연구하고,<br class="desktop-break" /> 사람이 머물 시스템과 세계를 만듭니다.</p>
        <p class="hero-byline">철학에서 코드로, 코드에서 경험으로.<br />MetaHumotonic의 연구와 창작이 만나는 작업실.</p>
        <div class="hero-actions"><a class="button button-primary" href="#projects">작업 둘러보기 <span aria-hidden="true">↗</span></a><a class="text-link" href="/wiki/">생각의 뿌리 읽기 <span aria-hidden="true">→</span></a></div>
        <div class="hero-footnote"><span class="status-light" aria-hidden="true"></span><span>완성된 답이 아닌, 계속되는 탐구</span></div>
      </div>
      <div class="graph-panel" aria-label="프로젝트 연결 지도">
        <div class="graph-caption"><span>01 — CONNECTED WORKS</span><span class="graph-label">선택해서 탐색 <span aria-hidden="true">↙</span></span></div>
        <div class="constellation">
          <div class="orbit orbit-one" aria-hidden="true"></div><div class="orbit orbit-two" aria-hidden="true"></div>
          <svg class="graph-lines" viewBox="0 0 500 400" preserveAspectRatio="none" aria-hidden="true">
            <path d="M140 76 L260 188 L390 84 M260 188 L95 272 M260 188 L420 264 M140 76 L95 272 M390 84 L420 264 M95 272 Q260 372 420 264" />
            <circle cx="204" cy="136" r="3" /><circle cx="324" cy="136" r="3" /><circle cx="178" cy="230" r="3" /><circle cx="341" cy="226" r="3" />
          </svg>
          {constellation.map(node => <button type="button" class:list={['graph-node', `graph-node--${node.id}`, { 'is-selected': node.id === 'hswm' }]} style={`--x:${node.x}%;--y:${node.y}%`} data-graph-node={node.id} aria-pressed={node.id === 'hswm'} aria-controls="graph-detail"><span>{node.label}</span><small>{node.note}</small></button>)}
          <span class="graph-axis axis-top" aria-hidden="true">IDEAS</span><span class="graph-axis axis-bottom" aria-hidden="true">EXPERIENCES</span>
          <span class="graph-cross cross-one" aria-hidden="true">+</span><span class="graph-cross cross-two" aria-hidden="true">+</span>
        </div>
        <div id="graph-detail" class="graph-detail" aria-live="polite" aria-atomic="true"><div><span class="mini-label">FOCUS / <span data-graph-category>RESEARCH</span></span><h2 data-graph-title>{featured.name}</h2></div><p data-graph-summary>{featured.subtitle}</p><a href="/projects/hswm/" data-graph-link aria-label="HSWM 자세히 보기">↗</a></div>
        <p class="graph-note">프로젝트 간 연결을 편집한 개념도 · 실시간 KG가 아닙니다.</p>
      </div>
    </section>

    <div class="practice-strip shell" aria-label="작업 영역"><a href="#projects"><span>01 / RESEARCH</span><strong>기억 · 인지 · 검증</strong></a><a href="#projects"><span>02 / SYSTEMS</span><strong>연결 · 의도 · 커뮤니티</strong></a><a href="#universe"><span>03 / WORLDS</span><strong>게임 · 서사 · 세계관</strong></a><span class="strip-arrow" aria-hidden="true">↘</span></div>

    <section id="projects" class="project-section shell" aria-labelledby="projects-title">
      <div class="section-heading"><div><p class="eyebrow">THE WORKBENCH</p><h2 id="projects-title">서로 다른 작업,<br class="mobile-break" /> 하나의 연결.</h2></div><p>각자의 질문에서 시작해<br />서로의 다음 단계가 되는 프로젝트들.</p></div>
      <div class="project-toolbar" data-project-controls hidden>
        <div class="project-filters" role="group" aria-label="작업 분야 필터">{categories.map(category => <button type="button" data-category={category.id} aria-pressed={category.id === 'all'}>{category.label}<span>{category.id === 'all' ? projects.length : projects.filter(project => project.category === category.id).length}</span></button>)}</div>
        <label class="project-search"><svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" /><path d="m13 13 4 4" /></svg><span class="sr-only">프로젝트 이름 또는 키워드 검색</span><input type="search" id="project-query" placeholder="프로젝트, 키워드 검색" maxlength="120" autocomplete="off" /><kbd aria-hidden="true">/</kbd></label>
      </div>
      <p class="sr-only" role="status" aria-live="polite" data-project-count>{projects.length}개의 작업</p>
      <div class="project-grid" data-project-grid>{projects.map((project, index) => <article class:list={['project-card', { 'project-card--featured': project.id === 'hswm' }]} data-project-id={project.id} data-project-name={project.name} data-project-category={project.category} data-project-subtitle={project.subtitle} data-project-search={[project.name, project.subtitle, project.summary, ...project.tags].join(" ")}>
        <div class="card-top"><span class="mini-label">{String(index + 1).padStart(2, '0')} / {categoryLabels[project.category]}</span><span class={`project-status status-${project.status}`}><i aria-hidden="true"></i>{statusLabels[project.status]}</span></div>
        <div class="card-title-row"><h3><a href={`/projects/${project.id}/`}>{project.name}</a></h3><span class="project-symbol" aria-hidden="true">{project.symbol}</span></div>
        <p class="card-subtitle">{project.subtitle}</p><p class="card-summary">{project.summary}</p>
        <div class="card-bottom"><div class="card-tags">{project.tags.slice(0, 3).map(tag => <span>{tag}</span>)}</div><a class="card-open" href={`/projects/${project.id}/`} aria-label={`${project.name} 자세히 보기`}>↗</a></div>
      </article>)}</div>
      <div class="empty-state" data-project-empty hidden><span aria-hidden="true">∅</span><h3>아직 연결되지 않은 검색어예요.</h3><p>다른 키워드나 분야로 찾아보세요.</p><button type="button" class="button button-secondary" data-project-reset>전체 작업 보기 ↗</button></div>
      <div class="catalog-note"><span>공개 작업 지도 · <time datetime={data.edition}>{data.edition.replaceAll('-', '.')}</time> 편집</span><a href="/projects/data.json">데이터와 공개 범위 <span aria-hidden="true">↗</span></a></div>
      <noscript><p class="catalog-note">모든 작업을 표시하고 있습니다. 검색과 필터는 JavaScript를 켜면 사용할 수 있습니다.</p></noscript>
    </section>

    <section id="universe" class="universe-section" aria-labelledby="universe-title"><div class="shell universe-inner">
      <div class="universe-copy"><p class="eyebrow">BEYOND THE CODE</p><h2 id="universe-title">논리의 끝에서,<br /><em>이야기가 시작된다.</em></h2><p>공리에서 태어난 세계관.<br />차원을 걷는 존재와 하늘을 닮은 얼굴들.<br />연구의 언어와 창작의 언어가 같은 세계에 머뭅니다.</p><div class="universe-actions"><a class="button button-primary" href="/wiki/worldview/">세계관 들어가기 ↗</a><a class="text-link" href="/book/">Book 읽기 →</a></div><div class="universe-stats"><span><strong>12</strong> 선의 공리</span><span><strong>{apostlesData.apostles.length}</strong> 사도</span><a href="/wiki/authority/">원문과 해석의 경계 ↗</a></div></div>
      <div class="world-doors">{worlds.map((world, i) => <a class={`world-door world-door--${i}`} href={`/wiki/apostles/${world.slug}/`}><div class="door-header"><span>CHAPTER {world.num}</span><span aria-hidden="true">↗</span></div><span class="world-sigil" aria-hidden="true">{world.icon}</span><div class="door-title"><h3>{world.name}</h3><span>세계관 기록 →</span></div></a>)}</div>
    </div></section>

    <section id="principles" class="principles-section shell" aria-labelledby="principles-title"><div class="section-heading"><div><p class="eyebrow">A WAY OF WORKING</p><h2 id="principles-title">만드는 방식에도,<br />생각이 남도록.</h2></div><a class="text-link" href="/system/">연구의 관점 읽기 ↗</a></div><div class="principles-grid"><article><span>01 — PROVENANCE</span><h3>출처를 지우지 않습니다.</h3><p>원문과 해석, 주장과 증거를 구분합니다. 지식을 옮길 때 맥락과 수정 이력도 함께 남깁니다.</p></article><article><span>02 — OPEN QUESTIONS</span><h3>미완성을 숨기지 않습니다.</h3><p>연구 목표와 동작하는 기능은 다릅니다. 가설은 가설로, 실험은 실험으로 소개합니다.</p></article><article><span>03 — HUMAN AGENCY</span><h3>연결은 동의에서 시작합니다.</h3><p>방문만으로 계산을 실행하지 않습니다. 공개 범위와 실행 권한을 연결의 편의와 맞바꾸지 않습니다.</p></article></div><div class="foundation-link"><div><span class="mini-label">ULTRA SAFETY AI</span><p>연구 목표와 공개 헌장은 별도의 기록으로 이어집니다.</p></div><a class="text-link" href="/foundation/">Foundation ↗</a></div></section>
  </main>
  <script src="../scripts/workbench.ts"></script>
</WorkbenchLayout>
