---
import '../styles/workbench.css';
import MetaMark from '../components/MetaMark.astro';
import foundation from '../data/foundation.json';
interface Props { title?: string; description?: string; path?: string; structuredData?: unknown; }
const { title = 'MetaHumotonic — 기술과 세계의 새로운 가능성', description = '사람의 자유에서 출발하는 AI 연구, 커뮤니티와 게임. 메타휴모토닉의 제품과 연구, 철학과 공개 코드를 만나보세요.', path = '/', structuredData } = Astro.props;
const canonical = new URL(path, 'https://metahumotonic.com').href;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Organization', name: 'MetaHumotonic',
  '@id': 'https://metahumotonic.com/#organization', url: 'https://metahumotonic.com/',
  slogan: 'Ultra Safety AI', description: foundation.identity.mission_statement_ko,
  publishingPrinciples: 'https://metahumotonic.com/foundation/',
  disambiguatingDescription: 'Ultra Safety AI는 연구 목표입니다. 안전 인증이 아니고, 측정된 결과도 아닙니다. 아무도 끌 수 없는 AI를 뜻하지 않습니다.',
};
---
<!doctype html>
<html lang="ko" class:list={{ 'is-learning-hub': path === '/learn/' }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/ld+json" href="https://metahumotonic.com/learn/graph.jsonld" title="MetaHumotonic 공개 학습 그래프" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#080a0d" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
    <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org", "@type":"WebSite", "@id":"https://metahumotonic.com/#website",url:"https://metahumotonic.com/",name:"MetaHumotonic", inLanguage:"ko",publisher:{"@id":"https://metahumotonic.com/#organization"}})} />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}
  </head>
  <body class="workbench">
    <a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
    <header class="site-header shell">
      <a href="/" class="brand" aria-label="MetaHumotonic 홈"><MetaMark size="sm" /><span>metahumotonic</span></a>
      <nav class="site-nav" aria-label="주요 메뉴"><a href="/services/" aria-current={path === '/services/' ? 'page' : undefined}>서비스</a><a href="/projects/" aria-current={path === '/projects/' ? 'page' : undefined}>프로젝트</a><a href="/philosophy/" aria-current={path === '/philosophy/' ? 'page' : undefined}>철학과 사명</a><a href="/apostles/">사도</a><a href="/axioms/">선의 공리</a><a href="/foundation/" aria-current={path === '/foundation/' ? 'page' : undefined}>Foundation</a><a href="/agents/">Ultra Safety AI</a><a href="/learn/" aria-current={path === '/learn/' ? 'page' : undefined}>자료</a></nav>
      <a class="header-link" href="https://github.com/gj3447" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      <details class="mobile-nav"><summary>메뉴 <span aria-hidden="true">＋</span></summary><nav aria-label="모바일 메뉴"><a href="/services/">서비스</a><a href="/projects/">프로젝트</a><a href="/philosophy/" aria-current={path === '/philosophy/' ? 'page' : undefined}>철학과 사명</a><a href="/apostles/">사도</a><a href="/axioms/">선의 공리</a><a href="/foundation/" aria-current={path === '/foundation/' ? 'page' : undefined}>Foundation · 공개 이니셔티브</a><a href="/agents/">Ultra Safety AI</a><a href="/learn/">자료 · 처음이라면</a><a href="https://github.com/gj3447" target="_blank" rel="noopener noreferrer">GitHub ↗</a></nav></details>
    </header>
    <slot />
    <footer class="site-footer"><div class="shell">
      <div class="footer-top"><div><a href="/" class="footer-wordmark">metahumotonic</a><p>자유에서 시작해, 가능성으로.</p></div><nav class="footer-columns" aria-label="하단 메뉴"><div><span>EXPLORE</span><a href="/services/">서비스 전체</a><a href="/projects/">프로젝트</a><a href="/apostles/">사도</a><a href="/axioms/">선의 공리</a><a href="/agents/">Ultra Safety AI · Agent</a></div><div><span>IDEAS</span><a href="/philosophy/">철학과 사명</a><a href="/foundation/">Foundation · 공개 헌장</a><a href="/learn/">읽기 지도</a><a href="/learn/#watch">영상 읽기 지도</a><a href="/wiki/">Wiki</a><a href="/book/">Book</a></div><div><span>CONNECT</span><a href="https://github.com/gj3447" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="https://www.youtube.com/channel/UCLVZA8cxVCEqrREfZ7NgcJA" target="_blank" rel="noopener noreferrer">YouTube 채널 ↗</a><a href="/services/graph.jsonld">서비스 그래프 ↗</a></div></nav></div>
      <div class="footer-bottom"><span>© {new Date().getUTCFullYear()} MetaHumotonic</span><span>기술 · 연구 · 새로운 세계</span></div>
      <p class="footer-boundary">Ultra Safety AI는 연구 목표이며 안전 인증이 아닙니다.</p>
    </div></footer>
    <script>
      for (const menu of document.querySelectorAll<HTMLDetailsElement>('.mobile-nav')) {
        menu.addEventListener('keydown', event => {
          if (event.key === 'Escape' && menu.open) { menu.open = false; menu.querySelector('summary')?.focus(); }
        });
        menu.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false; }));
      }
    </script>
  </body>
</html>
