---
/**
 * Site harness — primary surfaces.
 * Priority: 선의 공리 > book > game > apostles/research.
 */
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'Company', match: '/' },
  { href: '/book/#axiom', label: '공리', match: null },
  { href: '/book/read/', label: 'Book', match: '/book/read' },
  { href: '/apostles/', label: '사도', match: '/apostles' },
  { href: '/research/', label: '연구', match: '/research' },
  { href: '/explore/', label: 'KG', match: '/explore' },
];
---
<header class="mh-topbar">
  <a href="/book/" class="mh-mark-text">metahumotonic · book</a>
  <nav class="mh-nav" aria-label="Primary">
    {links.map((l) => (
      <a
        href={l.href}
        class={l.match && (l.match === '/' ? path === '/' : path.startsWith(l.match)) ? 'is-active' : undefined}
        data-priority={l.label === '공리' ? 'core' : undefined}
      >{l.label}</a>
    ))}
  </nav>
</header>
