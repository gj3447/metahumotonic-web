---
/* Keep the documentation surface dark until a reader explicitly selects light.
   Starlight's default otherwise follows the operating-system preference. */
---
<script is:inline>
  window.StarlightThemeProvider = (() => {
    let theme = 'dark';
    try {
      const storedTheme = localStorage.getItem('starlight-theme');
      theme = storedTheme === 'light' ? 'light' : 'dark';
      if (!storedTheme) localStorage.setItem('starlight-theme', 'dark');
    } catch { /* Storage is optional; the deterministic dark default remains. */ }
    document.documentElement.dataset.theme = theme;
    return {
      updatePickers(selectedTheme = theme) {
        document.querySelectorAll('starlight-theme-select').forEach((picker) => {
          const select = picker.querySelector('select');
          if (select) select.value = selectedTheme;
          const template = document.querySelector('#theme-icons');
          const icon = template?.content.querySelector('.' + selectedTheme);
          const current = picker.querySelector('svg.label-icon');
          if (icon && current) current.replaceChildren(...icon.cloneNode(true).childNodes);
        });
      },
    };
  })();
</script>

<template id="theme-icons">
  <svg class="light" aria-hidden="true" viewBox="0 0 24 24"><path fill="currentColor" d="M12 18a6 6 0 1 0 0-12 6 6 0 0 0 0 12Zm0-16v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
  <svg class="dark" aria-hidden="true" viewBox="0 0 24 24"><path fill="currentColor" d="M20.1 15.4A8 8 0 0 1 8.6 3.9 8.5 8.5 0 1 0 20.1 15.4Z"/></svg>
  <svg class="auto" aria-hidden="true" viewBox="0 0 24 24"><path fill="currentColor" d="M4 5h16v11H4V5Zm2 2v7h12V7H6Zm3 12h6v2H9v-2Z"/></svg>
</template>
