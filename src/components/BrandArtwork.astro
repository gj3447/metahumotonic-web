---
// The existing C/M/Y/W, 2×2 hollow-ring mark, drawn as a scalable brand illustration.
const rings = [{ x: 217, y: 201, color: '#00e5ff' }, { x: 403, y: 201, color: '#ff2bd6' },
  { x: 217, y: 387, color: '#ffe600' }, { x: 403, y: 387, color: '#f4f7ff' }];
---
<div class="brand-artwork" aria-hidden="true">
  <svg viewBox="0 0 620 588" fill="none">
    <defs>
      <radialGradient id="brand-atmosphere"><stop stop-color="#344b43" /><stop offset="1" stop-color="#111b18" /></radialGradient>
      <filter id="brand-glow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="11" /></filter>
      <linearGradient id="ring-light" x1="0" y1="0" x2="1" y2="1"><stop stop-color="white" stop-opacity=".8" /><stop offset=".45" stop-color="white" stop-opacity="0" /><stop offset="1" stop-color="white" stop-opacity=".3" /></linearGradient>
    </defs>
    <rect width="620" height="588" fill="url(#brand-atmosphere)" />
    <g stroke="#8caa98" opacity=".1">
      <circle cx="310" cy="294" r="264" /><circle cx="310" cy="294" r="280" />
      <path d="M310 0V588M0 294H620" />
    </g>
    {rings.map(ring => <g>
      <circle cx={ring.x} cy={ring.y} r="113" stroke={ring.color} stroke-width="14" opacity=".18" filter="url(#brand-glow)" />
      <circle cx={ring.x} cy={ring.y} r="113" stroke={ring.color} stroke-width="2.8" />
      <circle cx={ring.x} cy={ring.y} r="106" stroke={ring.color} stroke-width=".65" opacity=".55" />
      <circle cx={ring.x} cy={ring.y} r="120" stroke={ring.color} stroke-width=".65" opacity=".25" />
      <circle cx={ring.x} cy={ring.y} r="113" stroke="url(#ring-light)" stroke-width="1" />
    </g>)}
  </svg>
  <span class="brand-artwork-label">FOUR COLORS. OPEN POSSIBILITIES.</span>
  <span class="brand-artwork-signature">MetaHumotonic</span>
</div>
