---
// KG: ATOM_Landing_AxiomVisual — 선의 공리 SSOT = src/data/axioms.json
import axiomsData from '../data/axioms.json';

const axioms = axiomsData.axioms;
const fourfold = axiomsData.fourfold;
const unit = axiomsData.unit;
---

<section id="axiom" class="mh-section mh-axiom" typeof="DefinedTermSet" resource="https://metahumotonic.com/book/#axioms">
  <p class="mh-eyebrow"><span class="mh-num">I.</span> 선의 공리 / The Axiom of Good</p>
  <p class="mh-axiom__priority">가장 중요한 것. 세계관의 핵 · the spine of MetaHumotonic.</p>

  <ol class="mh-index" aria-label="12 정의 인덱스" property="name" content="선의 공리">
    {axioms.map((a) => (
      <li><span>{a.num}.</span> {a.hanja} · {a.kor}</li>
    ))}
  </ol>

  {axioms.map((a) => (
    <article class="mh-verse" id={`axiom-${a.n}`} typeof="DefinedTerm" property="hasDefinedTerm">
      <span class="mh-verse__symbol" aria-hidden="true">{a.symbol}</span>
      <span class="mh-verse__num">{a.num}.</span>
      <h3 class="mh-verse__hanja" property="name">{a.hanja}</h3>
      <p class="mh-verse__kor">{a.kor}</p>
      <p class="mh-verse__body" property="description">{a.body}</p>
      <p class="mh-verse__en"><em>{a.en}</em></p>
    </article>
  ))}
</section>

<section class="mh-section mh-meaning" id="axiom-xii">
  <p class="mh-eyebrow"><span class="mh-num">§</span> 정의 XII · 4중등치</p>
  <div class="mh-prose">
    <p><strong>메타휴모</strong> = {unit.metahumo}</p>
    <p><strong>메타휴모토닉</strong> = {unit.metahumotonic}</p>
    <p class="mh-fourfold"><code>{fourfold}</code></p>
    <p>
      우주를 연산×최적화로 규정하는 framework의 종점.
      정보 모델이 완결되는 순간과 열역학 포텐셜이 소진되는 순간은 같다 — Landauer 다리.
    </p>
  </div>
  <p class="mh-axiom__more">
    <a href="/book/read/">Book — 선의 공리 전문 읽기 →</a>
  </p>
</section>

<style>
  .mh-axiom__priority {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 12px;
    color: rgba(14, 14, 12, 0.55);
    margin: -8px 0 20px;
    letter-spacing: 0.02em;
  }
  .mh-verse__symbol {
    display: block;
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1;
    margin-bottom: 24px;
    opacity: 0.35;
    user-select: none;
  }
  .mh-fourfold {
    margin: 1rem 0;
    padding: 0.75rem 1rem;
    border-left: 3px solid #00e5ff;
    background: rgba(0, 0, 0, 0.03);
  }
  .mh-fourfold code {
    font-size: 13px;
    line-height: 1.5;
    white-space: pre-wrap;
  }
  .mh-axiom__more {
    margin-top: 1.5rem;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 13px;
  }
  .mh-axiom__more a {
    color: inherit;
    border-bottom: 1px solid rgba(14, 14, 12, 0.35);
  }
</style>
