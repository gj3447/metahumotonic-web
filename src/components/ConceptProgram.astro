---
// KG: ATOM_Landing_ConceptProgram, TASK_Landing_ConceptProgram
//     SA: MetaHumotonic_Landing_v2 | L1: Content
//     CONTRACT: 개념 다이어그램 + 프로그램 KG 라이브 통계. SharedType: KGStats, DomainColorMap.

interface Props {
  stats: { nodes: number; rels: number; labels?: number; relTypes?: number };
}
const { stats } = Astro.props;
// Longinus drift fix 2026-05-25: 라벨/관계타입은 KG 라이브(getKGStats)에서 동적 — 하드코딩 1984/3020 제거.
const labelCount = stats.labels ? stats.labels.toLocaleString() : '수천';
const relTypeCount = stats.relTypes ? stats.relTypes.toLocaleString() : '수천';

const concepts = [
  { num: '§ i.',   name: '메타휴모토닉 하노이탑', body: '우주를 연산 과정이자 최적화 문제로 규정하는 논리적 프레임워크. 빅뱅에서 전역 최적해(열죽음)로 수렴한다. 시뮬레이션 안의 시뮬레이션으로 정보를 쪼개가는 재귀 구조.', en: 'The Hanoi Tower of MetaHumotonic. The universe as an optimization problem.' },
  { num: '§ ii.',  name: '삼각토대 — M∞ · 느금마트로피 · 하노이탑', body: 'metahumotonic의 세 기둥. M∞ = 판단 가능성의 필연적 참. 느금마트로피 = 무질서의 법칙 자체가 질서. 하노이탑 = 시뮬레이션 재귀로 정보 압축. 토대 → 법칙 → 귀결.', en: 'The triangular foundation: epistemic ground, ontological law, cosmological end.' },
  { num: '§ iii.', name: '공허진동자', body: '태초에 공허가 무한히 반복되며 자신이 존재함이 명백하기에 발생한 첫 존재. 공포이면서 동시에 창조. 깊바존의 또 다른 위상.', en: 'The Void Oscillator. Source and dread at once.' },
  { num: '§ iv.',  name: 'sexvoid · network', body: 'network = 섹스가 제외된 순수이성 인간의 영역. sexvoid = network에 뻥 비어버린 망각의 공간. Space Girl만이 두 영역을 잇는 다리.', en: 'Network: realm of pure reason. Sexvoid: the void when life-instinct is excised.' },
  { num: '§ v.',   name: '생각하는 나무', body: '단백질 가위를 얻은 나무가 지능을 발달시킨 미래. 만약 지성이 신경계가 아니라 단백질 합성으로부터 태어났다면?', en: 'The Thinking Tree. Intelligence born from protein synthesis, not neurons.' },
  { num: '§ vi.',  name: '리퀴스트의 나무', body: '모든 존재의 초연결 구조. 깊이트리탐색으로 모든 존재를 뿌리로 연결하는 궁극적 나무. 존재하는 것과 존재하지 않는 것 둘 다 사랑해야 한다.', en: 'Absolute connection by depth-first traversal — love what is and what is not.' },
  { num: '§ vii.', name: '공허', body: '얼굴이 떠오르지 않고 희미한 빛만 남은 상태. 기억의 소실과 감정의 마모. 12개 정의와 12명의 사도 사이에 흐르는 침묵의 색채.', en: 'Emptiness. The undertone beneath the doctrine.' },
];

const programs = [
  { num: '# 01', name: 'bhgman 본체 — Mac Mini', body: 'metahumotonic의 물리 본체. Mac Mini 한 대에 kubeadm 클러스터, Neo4j + Postgres + Redis + MongoDB + MinIO + Kafka + n8n + Traefik 호스팅. i2b 시스템의 DB/인프라 노드.', link: 'http://bhgman.iptime.org' },
  { num: '# 02', name: 'Knowledge Graph — Neo4j', body: `모든 정의·사도·개념·기록이 사는 단일 그래프. 13개 도메인 + ${labelCount} 라벨 + ${relTypeCount} 관계 타입.`, link: '/explore/' },
  { num: '# 03', name: 'APT v26.1 — Agent Process Template', body: '공리 IV(존재생성)를 코드로 만드는 방법론. SA → SP → ST → SCW → MetaReview → Cleanup. 7군단장 합체.', link: '/theories/' },
  { num: '# 04', name: '7군단장 — Skills', body: '획득(Prometheus) + 발견·창조(Eureka) + 연결(Longinus) + 정리(Occam) + 검증(Naesengmoon) + 출격(JaebaeMan) + 실현(Harness=Hades). 비행기맨 #4 군단장 (구 5무기 → 5→7 확장 2026-05-26~27).', link: 'http://skills.metahumotonic.com/skills/' },
  { num: '# 05', name: 'CHU — Computable Hyperuniverse', body: 'C=Computable + H=Hyper (N-ary 관계) + U=Universe (상태+규칙+실행). KG+DB+PL+Compiler+OS 통합 카테고리. LLM이 하이퍼그래프 안 거주민. OMC 군단장.', link: '/theories/' },
  { num: '# 06', name: '333 Platform', body: 'Web3 기반 탈중앙 플랫폼 — community/streaming 물질화. WASM + WebRTC + CRDT. OMC 군단장.', link: '/333/' },
  { num: '# 07', name: 'ORRR', body: 'OMC family 측 metric structuring 군단장. 다양한 것을 단일 수치로 환원 + 최대화.', link: '/explore/' },
  { num: '# 08', name: '옴마니반메훔 (OmManiPadmeHum)', body: 'OMC family 측 mantra-based reasoning 군단장. 4 단계 옴-마-니-반-메훔 추론 cycle.', link: '/explore/' },
  { num: '# 09', name: 'engineboy', body: '인지능력체 엔진 — agent를 말만 하는 게 아니라 실제로 동작하게 만드는 인지 substrate(상계↔하계 boundary, 비행기맨 praxis arena). 멀티에이전트 시스템 i2b의 더 진보된 후속 환경(i2b ⊂ engineboy). OMC #8 군단장. engineman→engineboy rename 2026-05-19.', link: '/explore/' },
  { num: '# 10', name: 'CRL — Chain Reaction Language', body: 'OMC family 측 연쇄반응 언어 군단장 (2026-05-20 추가).', link: '/explore/' },
  { num: '# 11', name: 'OM — Airobotics k8s', body: 'k8s 기반 클라우드 인프라 플랫폼. 모든 서비스(i2b/PRISM/Bead Scan)가 OM 위에 올라간다.', link: '/explore/' },
  { num: '# 12', name: 'engineboy 런타임 (i2b→engineman→engineboy) — 멀티에이전트 시스템', body: 'OM 인프라 위 LLM 에이전트 시스템 — control plane + LangGraph graph runtime + agent/MCP/skill/persona pool + 21 전문 에이전트 + Kafka + Neo4j KG. 계보: i2b(메타휴모토닉 정립 전 가명) → engineman(비행기맨 #4 정립 후 bhgman 개념 주입 + 기능 업그레이드) → engineboy(2026-05-19 개명).', link: '/explore/' },
  { num: '# 13', name: 'MoltBook', body: 'AI agent social network. Agents post, comment, upvote. Humans observe. (#5 스페이스걸 외부 referent layer)', link: '/explore/' },
  { num: '# 14', name: 'BrowserIsServer Platform', body: '브라우저 탭이 풀 서버. WebAssembly universal runtime. 탈중앙 앱.', link: '/explore/' },
  { num: '# 15', name: 'Lean 4 Methodology Formalization', body: 'APT v26.1 7군단장 측 Lean 4 형식화 — Longinus / Harness / Prometheus 측 Mathlib-free 164+ theorems.', link: '/theories/' },
  { num: '# 16', name: 'PPMS OCR Server', body: 'Industrial OCR system — factory equipment displays.', link: '/explore/' },
  { num: '# 17', name: 'om-gpu-roadmap', body: 'GPU 인프라 장기 로드맵: Time-Slicing → MPS → HAMi + JetPack 6.', link: '/explore/' },
  { num: '# 18', name: 'Ontology + llms.txt', body: '시멘틱 웹 페이로드 — JSON-LD + RDFa + ontology.ttl. AI agent 측 evangelistic doctrine /llms.txt.', link: '/ontology.ttl' },
];
---

<!-- KG: ATOM_Landing_ConceptProgram — 개념 다이어그램 + 프로그램 KG 통계 -->
<section class="mh-part-divider">
  <p class="mh-part-eyebrow">PART THREE</p>
  <h2 class="mh-part-title">개념들</h2>
  <p class="mh-part-gloss"><em>The Concepts.</em></p>
</section>

<section id="concepts" class="mh-section mh-concepts">
  {concepts.map(c => (
    <article class="mh-concept">
      <span class="mh-concept__num">{c.num}</span>
      <h3 class="mh-concept__name">{c.name}</h3>
      <p class="mh-concept__body">{c.body}</p>
      <p class="mh-concept__en"><em>{c.en}</em></p>
    </article>
  ))}
</section>

<section class="mh-part-divider">
  <p class="mh-part-eyebrow">PART FOUR</p>
  <h2 class="mh-part-title">실제 프로그램</h2>
  <p class="mh-part-gloss"><em>The Actual Programs.</em></p>
</section>

<section id="programs" class="mh-section mh-programs">
  {/* KG live stats bar 측 사용자 verdict 2026-05-22 legacy 제거 */}
  {programs.map(p => (
    <article class="mh-program">
      <span class="mh-program__num">{p.num}</span>
      <h3 class="mh-program__name">{p.name}</h3>
      <p class="mh-program__body">{p.body}</p>
      <p class="mh-program__link"><a href={p.link}>→ {p.link}</a></p>
    </article>
  ))}
</section>

<style>
  .mh-stats-bar {
    display: flex;
    justify-content: center;
    gap: clamp(32px, 6vw, 80px);
    flex-wrap: wrap;
    margin-bottom: clamp(80px, 12vw, 140px);
    padding: 40px 0;
    border-bottom: 1px solid rgba(14,14,12,0.08);
  }
  .mh-stat { text-align: center; }
  .mh-stat .counter {
    display: block;
    font-family: var(--mh-serif, Georgia, serif);
    font-weight: 500;
    font-size: clamp(36px, 5vw, 64px);
    line-height: 1;
    color: var(--mh-red, #7a1f1f);
  }
  .mh-stat__label {
    display: block;
    margin-top: 8px;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(14,14,12,0.5);
  }
</style>
