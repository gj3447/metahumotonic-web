---
import data from '../data/workbench.json';
import { publicProjects, categories, statusLabels, categoryLabels } from '../lib/workbench';
const projects = publicProjects(data.projects);
---
<div class="project-toolbar" data-project-controls hidden>
  <div class="project-filters" role="group" aria-label="프로젝트 분야 필터">{categories.map(category => <button type="button" data-category={category.id} aria-pressed={category.id === 'all'}>{category.label}<span>{category.id === 'all' ? projects.length : projects.filter(project => project.category === category.id).length}</span></button>)}</div>
  <label class="project-search"><svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" /><path d="m13 13 4 4" /></svg><span class="sr-only">프로젝트 이름 또는 키워드 검색</span><input type="search" id="project-query" placeholder="프로젝트, 키워드 검색" maxlength="120" autocomplete="off" /><kbd aria-hidden="true">/</kbd></label>
</div>
<p class="sr-only" role="status" aria-live="polite" data-project-count>{projects.length}개의 프로젝트</p>
<div class="project-grid" data-project-grid>{projects.map(project => <article class="project-card" data-project-id={project.id} data-project-category={project.category} data-project-search={[project.name, project.subtitle, project.summary, ...project.tags].join(' ')}>
  <div class="card-top"><span class="mini-label">{categoryLabels[project.category]}</span><span class="project-status">{statusLabels[project.status]}</span></div>
  <div class="card-title-row"><h2><a href={`/projects/${project.id}/`}>{project.name}</a></h2><span class="project-symbol" aria-hidden="true">{project.symbol}</span></div>
  <p class="card-subtitle">{project.subtitle}</p><p class="card-summary">{project.summary}</p>
  <div class="card-bottom"><div class="card-tags">{project.tags.slice(0, 3).map(tag => <span>{tag}</span>)}</div><a class="card-open" href={`/projects/${project.id}/`} aria-label={`${project.name} 자세히 보기`}>↗</a></div>
</article>)}</div>
<div class="empty-state" data-project-empty hidden><h2>검색 결과가 없습니다.</h2><p>다른 키워드나 분야로 찾아보세요.</p><button type="button" class="button button-secondary" data-project-reset>전체 프로젝트 보기 ↗</button></div>
<div class="catalog-note"><span>프로젝트 소개 · <time datetime={data.edition}>{data.edition.replaceAll('-', '.')}</time> 편집</span><a href="/projects/data.json">데이터로 보기 ↗</a></div>
<noscript><p class="catalog-note">모든 프로젝트를 표시하고 있습니다. 각 프로젝트의 소개와 링크를 바로 읽을 수 있습니다.</p></noscript>
<script src="../scripts/workbench.ts"></script>
